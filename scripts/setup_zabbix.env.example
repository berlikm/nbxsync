# Lab inputs for setup_zabbix.sh
# Copy to setup_zabbix.env (gitignored) and fill in real values:
#   cp scripts/setup_zabbix.env.example scripts/setup_zabbix.env
#
# Or: SETUP_ZABBIX_ENV=/path/to/file ./scripts/setup_zabbix.sh
#
# Environment variables already exported in the shell win over this file.

# ── Zabbix UI / API (from this host) ─────────────────────
ZABBIX_URL=http://localhost:8080
ADMIN_USER=Admin
ADMIN_PASS=zabbix
TOKEN_NAME=nbxsync
TOKEN_FILE=/tmp/nbxsync_token.txt

# URL NetBox uses to reach Zabbix (not localhost if NetBox is on another host)
# Production: https://sensirion.zabbix.cloud
NBX_ZABBIX_URL=http://10.0.105.144:8080

# Optional production proxy name overrides (defaults already match Zabbix Cloud hosts)
# NBX_PROXY_CH=ch-sta-p-zabp01
# NBX_PROXY_CH2=ch-sta-p-zabp02
# NBX_PROXY_HU=hu-deb-p-zabp01
# NBX_PROXY_KR=kr-sel-p-zabp01
# NBX_PROXY_CN=cn-sha-p-zabp01

# ── Podman ───────────────────────────────────────────────
IMAGE_NAME=zbx-server-custom
POD_NAME=zbx
PHP_TZ=Europe/Zurich

# ── SNMP credentials (leave blank to use script defaults) ─
# NBX_SNMP_AUTHPASS_MON=
# NBX_SNMP_PRIVPASS_MON=
# NBX_SNMP_AUTHPASS_LINUX=
# NBX_SNMP_PRIVPASS_LINUX=
# NBX_SNMP_AUTHPASS_DELL=
# NBX_SNMP_PRIVPASS_DELL=
# NBX_SNMP_AUTHPASS_SAP=
# NBX_SNMP_PRIVPASS_SAP=

# ── NetBox / script paths on the lab host ────────────────
NETBOX_ROOT=/opt/netbox/netbox
NETBOX_VENV_PYTHON=/opt/netbox/venv/bin/python
NETBOX_ENV_FILE=/etc/netbox.env
ZEROTOUCH_SCRIPT=/tmp/configure_nbxsync_zerotouch.py
NETWORK_SCRIPT=/tmp/nwn/scripts/configure_nbxsync_network.py
NETWORK_SCRIPT_PYTHONPATH=/opt/netbox/netbox:/tmp/nwn/scripts
TEST_SYNC_SCRIPT=/tmp/test_network_sync.py
