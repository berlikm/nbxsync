-- /extremeWing-config/device/controller_host
                -- 1.3.6.1.4.1.1916.2.131.50.1.3.18.20
                extremeWingCfgDevControllerHost OBJECT IDENTIFIER ::= { extremeWingCfgDev 20 }


                -- 1.3.6.1.4.1.1916.2.131.50.1.3.18.20.1
                extremeWingCfgDevControllerHostTable OBJECT-TYPE
                        SYNTAX SEQUENCE OF ExtremeWingCfgDevControllerHostEntry
                        MAX-ACCESS not-accessible
                        STATUS current
                        DESCRIPTION
                                "WLAN controller configuration

                                /extremeWing-config/device/controller_host"
                        ::= { extremeWingCfgDevControllerHost 1 }


                -- 1.3.6.1.4.1.1916.2.131.50.1.3.18.20.1.1
                extremeWingCfgDevControllerHostEntry OBJECT-TYPE
                        SYNTAX ExtremeWingCfgDevControllerHostEntry
                        MAX-ACCESS not-accessible
                        STATUS current
                        DESCRIPTION
                                "An entry in the table."
                        INDEX { extremeWingCfgDevMac, extremeWingCfgDevControllerHostHost, extremeWingCfgDevControllerHostPool, extremeWingCfgDevControllerHostLevel }
                        ::= { extremeWingCfgDevControllerHostTable 1 }


                ExtremeWingCfgDevControllerHostEntry ::=
                        SEQUENCE {
                                extremeWingCfgDevControllerHostHost
                                        DisplayString,
                                extremeWingCfgDevControllerHostPool
                                        Unsigned32,
                                extremeWingCfgDevControllerHostLevel
                                        Unsigned32,
                                extremeWingCfgDevControllerHostRowStatus
                                        RowStatus,
                                extremeWingCfgDevControllerHostForce
                                        TruthValue,
                                extremeWingCfgDevControllerHostRremoteVpnClient
                                        TruthValue,
                                extremeWingCfgDevControllerHostIPSecSecure
                                        TruthValue,
                                extremeWingCfgDevControllerHostIPSecGw
                                        IpAddress
                         }

                -- 1.3.6.1.4.1.1916.2.131.50.1.3.18.20.1.1.1
                extremeWingCfgDevControllerHostHost OBJECT-TYPE
                        SYNTAX DisplayString
                        MAX-ACCESS read-only
                        STATUS current
                        DESCRIPTION
                                "IP address or hostname of controller.

                                As this object is indirectly part of the key,
                                to change its value the row must be deleted and created with
                                the new key.

                                XPath: /extremeWing-config/device[mac=key1]/controller_host[host=key2,pool=key3,level=key4]/host"
                        ::= { extremeWingCfgDevControllerHostEntry 1 }


                -- 1.3.6.1.4.1.1916.2.131.50.1.3.18.20.1.1.2
                extremeWingCfgDevControllerHostPool OBJECT-TYPE
                        SYNTAX Unsigned32 (1..2)
                        MAX-ACCESS read-only
                        STATUS current
                        DESCRIPTION
                                "Pool this controller belongs to.

                                As this object is indirectly part of the key,
                                to change its value the row must be deleted and created with
                                the new key.

                                XPath: /extremeWing-config/device[mac=key1]/controller_host[host=key2,pool=key3,level=key4]/pool"
                        ::= { extremeWingCfgDevControllerHostEntry 2 }


                -- 1.3.6.1.4.1.1916.2.131.50.1.3.18.20.1.1.3
                extremeWingCfgDevControllerHostLevel OBJECT-TYPE
                        SYNTAX Unsigned32 (1..2)
                        MAX-ACCESS read-only
                        STATUS current
                        DESCRIPTION
                                "Routing level for controller link.

                                As this object is indirectly part of the key,
                                to change its value the row must be deleted and created with
                                the new key.

                                Values:
                                1  Level 1 (local)
                                2  Level 2 (inter-site)

                                XPath: /extremeWing-config/device[mac=key1]/controller_host[host=key2,pool=key3,level=key4]/level"
                        ::= { extremeWingCfgDevControllerHostEntry 3 }


                -- 1.3.6.1.4.1.1916.2.131.50.1.3.18.20.1.1.4
                extremeWingCfgDevControllerHostRowStatus OBJECT-TYPE
                        SYNTAX RowStatus
                                {
                                active(1),
                                createAndGo(4),
                                destroy(6)
                                }
                        MAX-ACCESS read-write
                        STATUS current
                        DESCRIPTION
                                "The status of this conceptual row.

                                XPath: /extremeWing-config/device[mac=key1]/controller_host[host=key2,pool=key3,level=key4]/row_status"
                        ::= { extremeWingCfgDevControllerHostEntry 4 }


                -- 1.3.6.1.4.1.1916.2.131.50.1.3.18.20.1.1.5
                extremeWingCfgDevControllerHostForce OBJECT-TYPE
                        SYNTAX TruthValue
                        MAX-ACCESS read-write
                        STATUS current
                        DESCRIPTION
                                "Force link to be created even when unnecessary.

                                XPath: /extremeWing-config/device[mac=key1]/controller_host[host=key2,pool=key3,level=key4]/force"
                        DEFVAL { false }
                        ::= { extremeWingCfgDevControllerHostEntry 5 }


                -- 1.3.6.1.4.1.1916.2.131.50.1.3.18.20.1.1.6
                extremeWingCfgDevControllerHostRremoteVpnClient OBJECT-TYPE
                        SYNTAX TruthValue
                        MAX-ACCESS read-write
                        STATUS current
                        DESCRIPTION
                                "Secure controller link using remote vpn connection.

                                XPath: /extremeWing-config/device[mac=key1]/controller_host[host=key2,pool=key3,level=key4]/remote_vpn_client"
                        DEFVAL { false }
                        ::= { extremeWingCfgDevControllerHostEntry 6 }


                -- 1.3.6.1.4.1.1916.2.131.50.1.3.18.20.1.1.7
                extremeWingCfgDevControllerHostIPSecSecure OBJECT-TYPE
                        SYNTAX TruthValue
                        MAX-ACCESS read-write
                        STATUS current
                        DESCRIPTION
                                "IPSec secure controller link.

                                XPath: /extremeWing-config/device[mac=key1]/controller_host[host=key2,pool=key3,level=key4]/ipsec_secure"
                        DEFVAL { false }
                        ::= { extremeWingCfgDevControllerHostEntry 7 }


                -- 1.3.6.1.4.1.1916.2.131.50.1.3.18.20.1.1.8
                extremeWingCfgDevControllerHostIPSecGw OBJECT-TYPE
                        SYNTAX IpAddress
                        MAX-ACCESS read-write
                        STATUS current
                        DESCRIPTION
                                "IP address or hostname of controller.

                                XPath: /extremeWing-config/device[mac=key1]/controller_host[host=key2,pool=key3,level=key4]/ipsec_gw"
                        ::= { extremeWingCfgDevControllerHostEntry 8 }

		
