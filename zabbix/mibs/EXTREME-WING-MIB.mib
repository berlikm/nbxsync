                                XPath: /extremeWing-config/captive_portal[name=key1]/external_pages/agreement"
                        ::= { extremeWingCfgCaptPrtlEntry 20 }

		-- 1.3.6.1.4.1.1916.2.131.50.1.3.10.4
		extremeWingCfgCaptPrtlAcctSyslogTable OBJECT-TYPE
			SYNTAX SEQUENCE OF ExtremeWingCfgCaptPrtlAcctSyslogEntry
			MAX-ACCESS not-accessible
			STATUS current
			DESCRIPTION
				"
				
				/extremeWing-config/captive_portal"
			::= { extremeWingCfgCaptPrtl 4 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.10.4.1
		extremeWingCfgCaptPrtlAcctSyslogEntry OBJECT-TYPE
			SYNTAX ExtremeWingCfgCaptPrtlAcctSyslogEntry
			MAX-ACCESS not-accessible
			STATUS current
			DESCRIPTION
				"An entry in the table."
			INDEX { extremeWingCfgCaptPrtlName }
			::= { extremeWingCfgCaptPrtlAcctSyslogTable 1 }

		
		ExtremeWingCfgCaptPrtlAcctSyslogEntry ::=
			SEQUENCE { 
