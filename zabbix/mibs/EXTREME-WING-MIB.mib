				single-host,
				multi-host
				
				XPath: /extremeWing-config/profile[name=key1]/interface[name=key2]/host_mode"
			DEFVAL { "single-host" }
			::= { extremeWingCfgProfIfDot1xAuthEntry 1 }

		
