			SYNTAX DisplayString
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"NOTE: This column is valid only if extremeWingCfgDevVpnCryptoInstType sets to remote-vpn
				
				Choose the modeconfig method to use.
				
				Values:
				push,
				pull
				
				XPath: /extremeWing-config/device[mac=key1]/crypto_map[name=key2]/crypto_map_entry[sequence=key3]/modeconfig"
			DEFVAL { "push" }
			::= { extremeWingCfgDevVpnCryptoInstEntry 11 }

		
