		-- 1.3.6.1.4.1.1916.2.131.50.1.3.10.5
		extremeWingCfgCaptPrtlInternalPageNoServTable OBJECT-TYPE
			SYNTAX SEQUENCE OF ExtremeWingCfgCaptPrtlInternalPageNoServEntry
			MAX-ACCESS not-accessible
			STATUS current
			DESCRIPTION
				"Description."
			::= { extremeWingCfgCaptPrtl 5 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.10.5.1
		extremeWingCfgCaptPrtlInternalPageNoServEntry OBJECT-TYPE
			SYNTAX ExtremeWingCfgCaptPrtlInternalPageNoServEntry
			MAX-ACCESS not-accessible
			STATUS current
			DESCRIPTION
				"Description."
			INDEX { extremeWingCfgCaptPrtlName }
			::= { extremeWingCfgCaptPrtlInternalPageNoServTable 1 }

		
		ExtremeWingCfgCaptPrtlInternalPageNoServEntry ::=
			SEQUENCE { 
				extremeWingCfgCaptPrtlInternalPageNoServDescription
					DisplayString,
				extremeWingCfgCaptPrtlInternalPageNoServFooter
					DisplayString,
				extremeWingCfgCaptPrtlInternalPageNoServHeader
					DisplayString,
				extremeWingCfgCaptPrtlInternalPageNoServMainLogoUrl
					DisplayString,
				extremeWingCfgCaptPrtlInternalPageNoServSmallLogoUrl
					DisplayString,
				extremeWingCfgCaptPrtlInternalPageNoServTitle
					DisplayString
			 }

		-- 1.3.6.1.4.1.1916.2.131.50.1.3.10.5.1.1
		extremeWingCfgCaptPrtlInternalPageNoServDescription OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Description to embed in this page
