-- /extremeWing-config/ip_acl
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.12
		extremeWingCfgIpAcl OBJECT IDENTIFIER ::= { extremeWingConfig 12 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.12.1
		extremeWingCfgIpAclTable OBJECT-TYPE
			SYNTAX SEQUENCE OF ExtremeWingCfgIpAclEntry
			MAX-ACCESS not-accessible
			STATUS current
			DESCRIPTION
				"
				
				/extremeWing-config/ip_acl"
			::= { extremeWingCfgIpAcl 1 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.12.1.1
		extremeWingCfgIpAclEntry OBJECT-TYPE
			SYNTAX ExtremeWingCfgIpAclEntry
			MAX-ACCESS not-accessible
			STATUS current
			DESCRIPTION
				"An entry in the table."
			INDEX { extremeWingCfgIpAclName }
			::= { extremeWingCfgIpAclTable 1 }

		
		ExtremeWingCfgIpAclEntry ::=
			SEQUENCE { 
				extremeWingCfgIpAclName
					ExtremeWingIdentifier
			 }

		-- 1.3.6.1.4.1.1916.2.131.50.1.3.12.1.1.1
		extremeWingCfgIpAclName OBJECT-TYPE
			SYNTAX ExtremeWingIdentifier
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"
				
				XPath: /extremeWing-config/ip_acl[name=key1]/name"
			::= { extremeWingCfgIpAclEntry 1 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.12.2
		extremeWingCfgIpAclRuleTable OBJECT-TYPE
			SYNTAX SEQUENCE OF ExtremeWingCfgIpAclRuleEntry
			MAX-ACCESS not-accessible
			STATUS current
			DESCRIPTION
				"
				
				/extremeWing-config/ip_acl/ip_rules"
			::= { extremeWingCfgIpAcl 2 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.12.2.1
		extremeWingCfgIpAclRuleEntry OBJECT-TYPE
			SYNTAX ExtremeWingCfgIpAclRuleEntry
			MAX-ACCESS not-accessible
			STATUS current
			DESCRIPTION
				"An entry in the table."
			INDEX { extremeWingCfgIpAclName, extremeWingCfgIpAclRulePrecedence }
			::= { extremeWingCfgIpAclRuleTable 1 }

		
		ExtremeWingCfgIpAclRuleEntry ::=
			SEQUENCE { 
				extremeWingCfgIpAclRulePrecedence
					Unsigned32,
				extremeWingCfgIpAclRuleAllow
					DisplayString,
				extremeWingCfgIpAclRulePriorityField
					DisplayString,
				extremeWingCfgIpAclRuleMarkDscp
					Unsigned32,
				extremeWingCfgIpAclRuleMark8021p
					Unsigned32,
				extremeWingCfgIpAclRuleDescription
					DisplayString,
				extremeWingCfgIpAclRuleProtocol
					Unsigned32,
				extremeWingCfgIpAclRuleSip
					DisplayString,
				extremeWingCfgIpAclRuleDip
					DisplayString
			 }

		-- 1.3.6.1.4.1.1916.2.131.50.1.3.12.2.1.1
		extremeWingCfgIpAclRulePrecedence OBJECT-TYPE
			SYNTAX Unsigned32 (1..5000)
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"The precedence number for the Access Control Entry (ACE).
				1 is the highest precedence rule and 5000 is the lowest
				precedence rule.
				
				XPath: /extremeWing-config/ip_acl[name=key1]/ip_rules[precedence=key2]/precedence"
			::= { extremeWingCfgIpAclRuleEntry 1 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.12.2.1.3
		extremeWingCfgIpAclRuleAllow OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"
				Values:
				deny
				permit
				
				XPath: /extremeWing-config/ip_acl[name=key1]/ip_rules[precedence=key2]/allow"
			DEFVAL { "deny" }
			::= { extremeWingCfgIpAclRuleEntry 3 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.12.2.1.4
		extremeWingCfgIpAclRulePriorityField OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"
				Values:
				8021p
				dscp
				
				XPath: /extremeWing-config/ip_acl[name=key1]/ip_rules[precedence=key2]/priority_field"
			DEFVAL { "dscp" }
			::= { extremeWingCfgIpAclRuleEntry 4 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.12.2.1.5
		extremeWingCfgIpAclRuleMarkDscp OBJECT-TYPE
			SYNTAX Unsigned32 (0..63)
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Modify DSCP TOS bits in IP header.
				
				XPath: /extremeWing-config/ip_acl[name=key1]/ip_rules[precedence=key2]/mark_dscp"
			::= { extremeWingCfgIpAclRuleEntry 5 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.12.2.1.6
		extremeWingCfgIpAclRuleMark8021p OBJECT-TYPE
			SYNTAX Unsigned32 (0..7)
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Modify 802.1p VLAN user priority
				
				XPath: /extremeWing-config/ip_acl[name=key1]/ip_rules[precedence=key2]/mark_8021p"
			::= { extremeWingCfgIpAclRuleEntry 6 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.12.2.1.7
		extremeWingCfgIpAclRuleDescription OBJECT-TYPE
			SYNTAX DisplayString (SIZE (0..128))
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"
				
				XPath: /extremeWing-config/ip_acl[name=key1]/ip_rules[precedence=key2]/description"
			::= { extremeWingCfgIpAclRuleEntry 7 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.12.2.1.8
		extremeWingCfgIpAclRuleProtocol OBJECT-TYPE
			SYNTAX Unsigned32 (0..254)
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"configure ip, tcp, udp, igmp, icmp, gre, ospf, vrrp, igp,
				eigrp protocols or any protocol number
				
				XPath: /extremeWing-config/ip_acl[name=key1]/ip_rules[precedence=key2]/protocol"
			::= { extremeWingCfgIpAclRuleEntry 8 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.12.2.1.9
		extremeWingCfgIpAclRuleSip OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"configure host/network, for host configuration,
				network mask /32 has to be specified
				
				XPath: /extremeWing-config/ip_acl[name=key1]/ip_rules[precedence=key2]/sip"
			::= { extremeWingCfgIpAclRuleEntry 9 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.12.2.1.10
		extremeWingCfgIpAclRuleDip OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"configure host/network, for host configuration,
				network mask /32 has to be specified
				
				XPath: /extremeWing-config/ip_acl[name=key1]/ip_rules[precedence=key2]/dip"
			::= { extremeWingCfgIpAclRuleEntry 10 }

		
