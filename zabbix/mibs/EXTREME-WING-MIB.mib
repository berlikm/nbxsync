-- /extremeWing-stats/rf_domain/wireless/client-stats
		-- 1.3.6.1.4.1.1916.2.131.50.1.4.3.2.5
		extremeWingStatsRfdWlClientStat OBJECT IDENTIFIER ::= { extremeWingStatsRfdWl 5 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.4.3.2.5.1
		extremeWingStatsRfdWlClientStatTable OBJECT-TYPE
			SYNTAX SEQUENCE OF ExtremeWingStatsRfdWlClientStatEntry
			MAX-ACCESS not-accessible
			STATUS current
			DESCRIPTION
				"Statistical information of wireless clients associated
				currently on RF Domain
				
				/extremeWing-stats/rf_domain/wireless/client-stats"
			::= { extremeWingStatsRfdWlClientStat 1 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.4.3.2.5.1.1
		extremeWingStatsRfdWlClientStatEntry OBJECT-TYPE
			SYNTAX ExtremeWingStatsRfdWlClientStatEntry
			MAX-ACCESS not-accessible
			STATUS current
			DESCRIPTION
				"An entry in the table"
			INDEX { extremeWingStatsRfdName, extremeWingStatsRfdWlClientStatMac }
			::= { extremeWingStatsRfdWlClientStatTable 1 }

		
		ExtremeWingStatsRfdWlClientStatEntry ::=
			SEQUENCE { 
				extremeWingStatsRfdWlClientStatMac
					MacAddress,
				extremeWingStatsRfdWlClientStatMacName
					DisplayString,
				extremeWingStatsRfdWlClientStatVendor
					DisplayString,
				extremeWingStatsRfdWlClientStatAp
					MacAddress,
				extremeWingStatsRfdWlClientStatTxBytes
					Counter64,
				extremeWingStatsRfdWlClientStatRxBytes
					Counter64,
				extremeWingStatsRfdWlClientStatTxPkts
					Counter64,
				extremeWingStatsRfdWlClientStatRxPkts
					Counter64,
				extremeWingStatsRfdWlClientStatTxDropped
					Counter64,
				extremeWingStatsRfdWlClientStatRxErrors
					Counter64,
				extremeWingStatsRfdWlClientStatTIndex
					Integer32,
				extremeWingStatsRfdWlClientStatTxBps
					Unsigned32,
				extremeWingStatsRfdWlClientStatRxBps
					Unsigned32,
				extremeWingStatsRfdWlClientStatSignal
					Integer32,
				extremeWingStatsRfdWlClientStatNoise
					Integer32,
				extremeWingStatsRfdWlClientStatSnr
					Integer32,
				extremeWingStatsRfdWlClientStatTxRate
					Unsigned32,
				extremeWingStatsRfdWlClientStatRxRate
					Unsigned32,
				extremeWingStatsRfdWlClientStatErrorRate
					Unsigned32,
				extremeWingStatsRfdWlClientStatQIndex
					Integer32
			 }

		-- 1.3.6.1.4.1.1916.2.131.50.1.4.3.2.5.1.1.1
		extremeWingStatsRfdWlClientStatMac OBJECT-TYPE
			SYNTAX MacAddress
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"Client MAC
				
				XPath: /extremeWing-stats/rf_domain[name=key1]/wireless/client-stats[mac=key2]/mac"
			::= { extremeWingStatsRfdWlClientStatEntry 1 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.4.3.2.5.1.1.2
		extremeWingStatsRfdWlClientStatMacName OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"Hostname of the client which could be obtained from
				packet sniffing or by manually configured via
				mac-name configuration.
				
				XPath: /extremeWing-stats/rf_domain[name=key1]/wireless/client-stats[mac=key2]/hostname"
			::= { extremeWingStatsRfdWlClientStatEntry 2 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.4.3.2.5.1.1.3
		extremeWingStatsRfdWlClientStatVendor OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"Client vendor name based on the MAC OUI lookup
				
				XPath: /extremeWing-stats/rf_domain[name=key1]/wireless/client-stats[mac=key2]/vendor"
			::= { extremeWingStatsRfdWlClientStatEntry 3 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.4.3.2.5.1.1.4
		extremeWingStatsRfdWlClientStatAp OBJECT-TYPE
			SYNTAX MacAddress
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
