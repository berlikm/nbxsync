		-- 1.3.6.1.4.1.1916.2.131.50.1.3.16.22.1.1.8
		extremeWingCfgProfIgsIpIgmpSnoopingQuerierQueryInterval OBJECT-TYPE
			SYNTAX Unsigned32 (1..18000)
			UNITS "seconds"
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"
				
				XPath: /extremeWing-config/profile[name=key1]/ip_igmp_snooping_querier_query_interval"
			DEFVAL { 60 }
			::= { extremeWingCfgProfIgsEntry 8 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.16.22.1.1.9
