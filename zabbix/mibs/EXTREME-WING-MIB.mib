				XPath: /extremeWing-stats/rf_domain[name=key1]/wireless/client-stats[mac=key2]/ap"
			::= { extremeWingStatsRfdWlClientStatEntry 4 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.4.3.2.5.1.1.5
