		extremeWingCfgDevVpnCryptoInstTransformSet OBJECT-TYPE
			SYNTAX ExtremeWingIdentifier
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"NOTE: This column is valid only if extremeWingCfgDevVpnCryptoInstType sets to site-to-site-auto or remote-vpn
				
				IPsec transform (encryption and hash algorithms) to use.
				
				XPath: /extremeWing-config/device[mac=key1]/crypto_map[name=key2]/crypto_map_entry[sequence=key3]/ipsec_transform_set"
			::= { extremeWingCfgDevVpnCryptoInstEntry 5 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.18.19.10.1.6
		extremeWingCfgDevVpnCryptoInstLocalip OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Use this IP as local tunnel endpoint address, instead of the interface IP (Advanced Configuration).
				
				XPath: /extremeWing-config/device[mac=key1]/crypto_map[name=key2]/crypto_map_entry[sequence=key3]/localip"
			::= { extremeWingCfgDevVpnCryptoInstEntry 6 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.18.19.10.1.7
		extremeWingCfgDevVpnCryptoInstPfs OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"NOTE: This column is valid only if extremeWingCfgDevVpnCryptoInstType sets to site-to-site-auto or remote-vpn
				
				Perfect Forward Secrecy.
				
				Values:
				none,
				2,
				5,
				14
				
				XPath: /extremeWing-config/device[mac=key1]/crypto_map[name=key2]/crypto_map_entry[sequence=key3]/pfs"
			DEFVAL { "none" }
			::= { extremeWingCfgDevVpnCryptoInstEntry 7 }

		
