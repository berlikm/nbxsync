		extremeWingCfgAutoProvisionPolicyRuleOperation OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Action to be taken upon adoption request from AP 		
				allow
				deny
				redirect
				 XPATH: /extremeWing-config/auto_provisioning_policy[name=key1]/rule[precedence=key2]/operation"
			::= { extremeWingCfgAutoProvisionPolicyRuleEntry 3 }

		
