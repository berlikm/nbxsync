			 }

		-- 1.3.6.1.4.1.1916.2.131.50.1.3.16.2.14.1.1
		extremeWingCfgProfIfVlanOspfMsgDigestKeyId OBJECT-TYPE
			SYNTAX Unsigned32 (1..255)
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
