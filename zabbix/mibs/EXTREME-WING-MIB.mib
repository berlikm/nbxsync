				XPath: /extremeWing-stats/rf_domain[name=key1]/wireless/radio-stats[radio_id=key2]/radio_mac"
			::= { extremeWingStatsRfdWlRadioStatEntry 4 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.4.3.2.9.1.1.5
		extremeWingStatsRfdWlRadioStatType OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"802.11 radio-type
				
				XPath: /extremeWing-stats/rf_domain[name=key1]/wireless/radio-stats[radio_id=key2]/radio_type"
			::= { extremeWingStatsRfdWlRadioStatEntry 5 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.4.3.2.9.1.1.6
