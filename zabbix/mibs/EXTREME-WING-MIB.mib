					DisplayString,
				extremeWingCfgProfIfWwanPwd
					DisplayString,
				extremeWingCfgProfIfWwanDefaultRoutePriority
					Unsigned32
			 }

		-- 1.3.6.1.4.1.1916.2.131.50.1.3.16.2.12.1.2
		extremeWingCfgProfIfWwanApn OBJECT-TYPE
			SYNTAX DisplayString (SIZE (0..25))
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Access Point Name.
				
				XPath: /extremeWing-config/profile[name=key1]/interface[name=key2]/apn"
			DEFVAL { "" }
			::= { extremeWingCfgProfIfWwanEntry 2 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.16.2.12.1.3
		extremeWingCfgProfIfWwanAuth OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Authentication Type.
				
				Values:
				pap,
				chap,
				mschap,
				mschap-v2
				
				XPath: /extremeWing-config/profile[name=key1]/interface[name=key2]/auth"
			DEFVAL { "chap" }
			::= { extremeWingCfgProfIfWwanEntry 3 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.16.2.12.1.4
		extremeWingCfgProfIfWwanUser OBJECT-TYPE
			SYNTAX DisplayString (SIZE (0..32))
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"User Name.
				
				XPath: /extremeWing-config/profile[name=key1]/interface[name=key2]/user"
			DEFVAL { "" }
			::= { extremeWingCfgProfIfWwanEntry 4 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.16.2.12.1.5
		extremeWingCfgProfIfWwanPwd OBJECT-TYPE
			SYNTAX DisplayString (SIZE (0..30))
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Password.
				
				XPath: /extremeWing-config/profile[name=key1]/interface[name=key2]/pwd"
			DEFVAL { "" }
			::= { extremeWingCfgProfIfWwanEntry 5 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.16.2.12.1.6
		extremeWingCfgProfIfWwanDefaultRoutePriority OBJECT-TYPE
			SYNTAX Unsigned32 (1..8000)
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Priority for the default route learnt via Wireless WAN
				XPath: /extremeWing-config/profile[name=key1]/interface[name=key2]/wwan_default_route_priority"
			DEFVAL { 3000 }
			::= { extremeWingCfgProfIfWwanEntry 6 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.16.2.13
		extremeWingCfgProfIfVlanOspfTable OBJECT-TYPE
			SYNTAX SEQUENCE OF ExtremeWingCfgProfIfVlanOspfEntry
			MAX-ACCESS not-accessible
			STATUS current
			DESCRIPTION
				"
				
				/extremeWing-config/profile/interface"
			::= { extremeWingCfgProfIf 13 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.16.2.13.1
		extremeWingCfgProfIfVlanOspfEntry OBJECT-TYPE
			SYNTAX ExtremeWingCfgProfIfVlanOspfEntry
			MAX-ACCESS not-accessible
			STATUS current
			DESCRIPTION
				"An entry in the table."
			INDEX { extremeWingCfgProfName, extremeWingCfgProfIfName }
			::= { extremeWingCfgProfIfVlanOspfTable 1 }

		
		ExtremeWingCfgProfIfVlanOspfEntry ::=
