		-- 1.3.6.1.4.1.1916.2.131.50.1.3.9.1.1.1
		extremeWingCfgSmartRfName OBJECT-TYPE
			SYNTAX ExtremeWingIdentifier
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"
				
				XPath: /extremeWing-config/smart_rf_policy[name=key1]/name"
			::= { extremeWingCfgSmartRfEntry 1 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.9.1.1.3
		extremeWingCfgSmartRfEnable OBJECT-TYPE
			SYNTAX TruthValue
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"
				
				XPath: /extremeWing-config/smart_rf_policy[name=key1]/enable"
			DEFVAL { false }
			::= { extremeWingCfgSmartRfEntry 3 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.9.1.1.4
		extremeWingCfgSmartRfSensitivity OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
