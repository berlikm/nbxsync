		extremeWingCfgWlanQosMcastStreamTable OBJECT-TYPE
			SYNTAX SEQUENCE OF ExtremeWingCfgWlanQosMcastStreamEntry
			MAX-ACCESS not-accessible
			STATUS current
			DESCRIPTION
				"Configure accelerated multicast streams address and
				forwarding QoS classification
				
				/extremeWing-config/wlan_qos/mcast_stream"
			::= { extremeWingCfgWlanQos 2 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.5.2.1
		extremeWingCfgWlanQosMcastStreamEntry OBJECT-TYPE
			SYNTAX ExtremeWingCfgWlanQosMcastStreamEntry
			MAX-ACCESS not-accessible
			STATUS current
			DESCRIPTION
				"An entry in the table."
			INDEX { extremeWingCfgWlanQosName, extremeWingCfgWlanQosMcastStreamAddr }
			::= { extremeWingCfgWlanQosMcastStreamTable 1 }

		
		ExtremeWingCfgWlanQosMcastStreamEntry ::=
			SEQUENCE { 
				extremeWingCfgWlanQosMcastStreamAddr
					ExtremeWingIdentifier,
				extremeWingCfgWlanQosMcastStreamPriority
					DisplayString
			 }

		-- 1.3.6.1.4.1.1916.2.131.50.1.3.5.2.1.1
		extremeWingCfgWlanQosMcastStreamAddr OBJECT-TYPE
			SYNTAX ExtremeWingIdentifier
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"Multicast IP address of the traffic stream that should be
				selected for accelerated delivery
				
				Note: an IP address of 0.0.0.0 is special, when it is selected
				that can be only entry in this table
								
				Although the type is an IP address, only multicast IP
				addresses (top 4 bits are E: 224.0.0.0 thru 239.255.255.255)
				should be set here.
				
				XPath: /extremeWing-config/wlan_qos[name=key1]/mcast_stream[addr=key2]/addr"
			::= { extremeWingCfgWlanQosMcastStreamEntry 1 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.5.2.1.3
		extremeWingCfgWlanQosMcastStreamPriority OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"The forwarding qos classification (traffic class)
				
				Values:
				trust
				voice
				video
				best-effort
				background
				
				XPath: /extremeWing-config/wlan_qos[name=key1]/mcast_stream[addr=key2]/priority"
			DEFVAL { "trust" }
			::= { extremeWingCfgWlanQosMcastStreamEntry 3 }

		
