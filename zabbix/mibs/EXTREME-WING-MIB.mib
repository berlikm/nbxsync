--  /extremeWing-config/device/dot11_cfg
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.18.11
		extremeWingCfgDevDot11 OBJECT IDENTIFIER ::= { extremeWingCfgDev 11 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.18.11.1
		extremeWingCfgDevDot11Table OBJECT-TYPE
			SYNTAX SEQUENCE OF ExtremeWingCfgDevDot11Entry
			MAX-ACCESS not-accessible
			STATUS current
			DESCRIPTION
				"802.11 global parameters for this device.
				
				/extremeWing-config/device/dot11_cfg"
			::= { extremeWingCfgDevDot11 1 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.18.11.1.1
		extremeWingCfgDevDot11Entry OBJECT-TYPE
			SYNTAX ExtremeWingCfgDevDot11Entry
			MAX-ACCESS not-accessible
			STATUS current
			DESCRIPTION
				"An entry in the table."
			INDEX { extremeWingCfgDevMac }
			::= { extremeWingCfgDevDot11Table 1 }

		
		ExtremeWingCfgDevDot11Entry ::=
			SEQUENCE { 
				extremeWingCfgDevDot11WepSharedKeyAuth
					TruthValue,
				extremeWingCfgDevDot11LegacyAutoUpdateAp650
					TruthValue,
				extremeWingCfgDevDot11LegacyAutoUpdateImgAp7131
					DisplayString,
				extremeWingCfgDevDot11LegacyAutoDowngrade
					TruthValue,
				extremeWingCfgDevDot11NasIdentifier
					DisplayString,
				extremeWingCfgDevDot11NasPortId
					DisplayString
			 }

		-- 1.3.6.1.4.1.1916.2.131.50.1.3.18.11.1.1.1
		extremeWingCfgDevDot11WepSharedKeyAuth OBJECT-TYPE
			SYNTAX TruthValue
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Whether 802.11 shared key authentication is supported
				with WEP. Note: this method has known security vulnerabilities
				and its use is not recommended unless there are devices
				on the network that are only capable of
				shared-key authentication.
				
				XPath: /extremeWing-config/device[mac=key1]/dot11_cfg/wep_shared_key_auth"
			DEFVAL { false }
			::= { extremeWingCfgDevDot11Entry 1 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.18.11.1.1.2
		extremeWingCfgDevDot11LegacyAutoUpdateAp650 OBJECT-TYPE
			SYNTAX TruthValue
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Whether legacy devices found on the network will automatically
				be updated to supported firmware.
				
				XPath: /extremeWing-config/device[mac=key1]/dot11_cfg/legacy_auto_update_ap650"
			DEFVAL { true }
			::= { extremeWingCfgDevDot11Entry 2 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.18.11.1.1.3
		extremeWingCfgDevDot11LegacyAutoUpdateImgAp7131 OBJECT-TYPE
			SYNTAX DisplayString (SIZE (0..253))
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Path to the AP4700 legacy auto update image.
				
				XPath: /extremeWing-config/device[mac=key1]/dot11_cfg/legacy_auto_update_img_ap7131"
			DEFVAL { "" }
			::= { extremeWingCfgDevDot11Entry 3 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.18.11.1.1.4
		extremeWingCfgDevDot11LegacyAutoDowngrade OBJECT-TYPE
			SYNTAX TruthValue
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Whether the AP4600 will connect to a legacy device and
				downgrade to be compatible with legacy devices.
				
				XPath: /extremeWing-config/device[mac=key1]/dot11_cfg/legacy_auto_downgrade"
			DEFVAL { true }
			::= { extremeWingCfgDevDot11Entry 4 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.18.11.1.1.5
		extremeWingCfgDevDot11NasIdentifier OBJECT-TYPE
			SYNTAX DisplayString (SIZE (0..253))
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"The RADIUS NAS-Identifier attribute which typically identifies
				the Access Point or Wireless Controller where the RADIUS
				message originates.
				
				XPath: /extremeWing-config/device[mac=key1]/dot11_cfg/nas_identifier"
			DEFVAL { "" }
			::= { extremeWingCfgDevDot11Entry 5 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.18.11.1.1.6
		extremeWingCfgDevDot11NasPortId OBJECT-TYPE
			SYNTAX DisplayString (SIZE (0..253))
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"The RADIUS NAS-Port-Id attribute which typically identifies
				the port of the device where the RADIUS messages originates.
				
				XPath: /extremeWing-config/device[mac=key1]/dot11_cfg/nas_port_id"
			DEFVAL { "" }
			::= { extremeWingCfgDevDot11Entry 6 }

		
