			DEFVAL { "100" }
			::= { extremeWingCfgLegacyApIfEntry 7 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.33.2.1.8
		extremeWingCfgLegacyApIfChannel OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
