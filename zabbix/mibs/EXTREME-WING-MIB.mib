			UNITS "centiseconds"
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Time interval between VRRP advertisments
				
				XPath: /extremeWing-config/device[mac=key1]/vrrp_groups[virtual_router_id=key2]/advertisement_interval/advertisement_interval_v3"
			DEFVAL { 100 }
			::= { extremeWingCfgDevVrrpGroupEntry 8 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.18.26.2.1.9
		extremeWingCfgDevVrrpGroupPreempt OBJECT-TYPE
			SYNTAX TruthValue
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Controls whether a higher priority backup router will preempt a lower priority master.
				
				XPath: /extremeWing-config/device[mac=key1]/vrrp_groups[virtual_router_id=key2]/preemption/preempt"
			DEFVAL { true }
			::= { extremeWingCfgDevVrrpGroupEntry 9 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.18.26.2.1.10
		extremeWingCfgDevVrrpGroupPreemptDelay OBJECT-TYPE
			SYNTAX Unsigned32 (1..65535)
			UNITS "seconds"
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Delay interval for pre-emption
				
				XPath: /extremeWing-config/device[mac=key1]/vrrp_groups[virtual_router_id=key2]/preemption/preempt_delay"
			::= { extremeWingCfgDevVrrpGroupEntry 10 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.18.26.2.1.11
		extremeWingCfgDevVrrpGroupCrmAction OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Backup virtual router may raise its priority in case the critical resources connected via the master router fail so that
				
				Values:
				increment-priority,
				decrement-priority,
				none
				
				XPath: /extremeWing-config/device[mac=key1]/vrrp_groups[virtual_router_id=key2]/crm_action"
			DEFVAL { "none" }
			::= { extremeWingCfgDevVrrpGroupEntry 11 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.18.26.2.1.12
		extremeWingCfgDevVrrpGroupDeltaPriority OBJECT-TYPE
			SYNTAX Unsigned32 (1..253)
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"The configured priority will be decremented by this value when the monitored interface state is down. In case of critical resource monitoring, the configured priority will be incremented by this value
				
				XPath: /extremeWing-config/device[mac=key1]/vrrp_groups[virtual_router_id=key2]/delta_priority"
			::= { extremeWingCfgDevVrrpGroupEntry 12 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.18.26.2.1.13
		extremeWingCfgDevVrrpGroupInterface OBJECT-TYPE
			SYNTAX Unsigned32 (1..4094)
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"The SVI (VLAN only) interface on which VRRP will be running. This also enable/disable VRRP operations
				
				XPath: /extremeWing-config/device[mac=key1]/vrrp_groups[virtual_router_id=key2]/interface"
			::= { extremeWingCfgDevVrrpGroupEntry 13 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.18.26.2.1.14
		extremeWingCfgDevVrrpGroupSyncGroup OBJECT-TYPE
			SYNTAX TruthValue
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Make this group part of vrrp sync group. This triggers VRRP failover only when advertisement is not received from all the masters of the virtual routers that is part of this vrrp sync group
				
				XPath: /extremeWing-config/device[mac=key1]/vrrp_groups[virtual_router_id=key2]/sync_group"
			DEFVAL { false }
			::= { extremeWingCfgDevVrrpGroupEntry 14 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.18.27
		extremeWingCfgDevIgs OBJECT IDENTIFIER ::= { extremeWingCfgDev 27 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.18.27.1
		extremeWingCfgDevIgsTable OBJECT-TYPE
			SYNTAX SEQUENCE OF ExtremeWingCfgDevIgsEntry
			MAX-ACCESS not-accessible
			STATUS current
			DESCRIPTION
				"
				
				/extremeWing-config/device"
			::= { extremeWingCfgDevIgs 1 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.18.27.1.1
		extremeWingCfgDevIgsEntry OBJECT-TYPE
			SYNTAX ExtremeWingCfgDevIgsEntry
			MAX-ACCESS not-accessible
			STATUS current
			DESCRIPTION
				"An entry in the table."
			INDEX { extremeWingCfgDevMac }
			::= { extremeWingCfgDevIgsTable 1 }

		
		ExtremeWingCfgDevIgsEntry ::=
			SEQUENCE { 
				extremeWingCfgDevIgsIpIgmpSnooping
					TruthValue,
				extremeWingCfgDevIgsIpIgmpSnoopingForwardUnknownMulticast
					TruthValue,
				extremeWingCfgDevIgsIpIgmpSnoopingQuerier
					TruthValue,
				extremeWingCfgDevIgsIpIgmpSnoopingQuerierAddress
					IpAddress,
				extremeWingCfgDevIgsIpIgmpSnoopingQuerierMaxResponseTime
					Unsigned32,
				extremeWingCfgDevIgsIpIgmpSnoopingQuerierOtherQuerierTimerExpiry
					Unsigned32,
				extremeWingCfgDevIgsIpIgmpSnoopingQuerierVersion
					Unsigned32,
				extremeWingCfgDevIgsIpIgmpSnoopingQuerierQueryInterval
					Unsigned32,
				extremeWingCfgDevIgsIpIgmpSnoopingQuerierRobustnessVariable
					Unsigned32
			 }

		-- 1.3.6.1.4.1.1916.2.131.50.1.3.18.27.1.1.1
		extremeWingCfgDevIgsIpIgmpSnooping OBJECT-TYPE
			SYNTAX TruthValue
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Enable/Disable igmp snooping; if set to disable, then per vlan bridge configuration is ignored
				
				XPath: /extremeWing-config/device[mac=key1]/ip_igmp_snooping"
			DEFVAL { true }
			::= { extremeWingCfgDevIgsEntry 1 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.18.27.1.1.2
		extremeWingCfgDevIgsIpIgmpSnoopingForwardUnknownMulticast OBJECT-TYPE
			SYNTAX TruthValue
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Enable/Disable unknown multicast fowarding
				
				XPath: /extremeWing-config/device[mac=key1]/ip_igmp_snooping_forward_unknown_multicast"
			DEFVAL { false }
			::= { extremeWingCfgDevIgsEntry 2 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.18.27.1.1.3
		extremeWingCfgDevIgsIpIgmpSnoopingQuerier OBJECT-TYPE
			SYNTAX TruthValue
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Enable/Disable on board IGMP querier on the device
				
				XPath: /extremeWing-config/device[mac=key1]/ip_igmp_snooping_querier"
			DEFVAL { false }
			::= { extremeWingCfgDevIgsEntry 3 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.18.27.1.1.4
		extremeWingCfgDevIgsIpIgmpSnoopingQuerierAddress OBJECT-TYPE
			SYNTAX IpAddress
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"IP Address used by IGMP querier
				
				XPath: /extremeWing-config/device[mac=key1]/ip_igmp_snooping_querier_address"
			DEFVAL { '00000000'h }
			::= { extremeWingCfgDevIgsEntry 4 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.18.27.1.1.5
		extremeWingCfgDevIgsIpIgmpSnoopingQuerierMaxResponseTime OBJECT-TYPE
			SYNTAX Unsigned32 (1..25)
			UNITS "seconds"
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Maximum query response time
				
				XPath: /extremeWing-config/device[mac=key1]/ip_igmp_snooping_querier_max_response_time"
			DEFVAL { 10 }
			::= { extremeWingCfgDevIgsEntry 5 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.18.27.1.1.6
		extremeWingCfgDevIgsIpIgmpSnoopingQuerierOtherQuerierTimerExpiry OBJECT-TYPE
			SYNTAX Unsigned32 (60..300)
			UNITS "seconds"
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"other querier time out value for the IGMP Querier
				
				XPath: /extremeWing-config/device[mac=key1]/ip_igmp_snooping_querier_other_querier_timer_expiry"
			DEFVAL { 60 }
			::= { extremeWingCfgDevIgsEntry 6 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.18.27.1.1.7
		extremeWingCfgDevIgsIpIgmpSnoopingQuerierVersion OBJECT-TYPE
			SYNTAX Unsigned32 (1..3)
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"IGMP version for the querier
				
				XPath: /extremeWing-config/device[mac=key1]/ip_igmp_snooping_querier_version"
			DEFVAL { 3 }
			::= { extremeWingCfgDevIgsEntry 7 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.18.27.1.1.8
		extremeWingCfgDevIgsIpIgmpSnoopingQuerierQueryInterval OBJECT-TYPE
			SYNTAX Unsigned32 (1..18000)
			UNITS "seconds"
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"
				
				XPath: /extremeWing-config/device[mac=key1]/ip_igmp_snooping_querier_query_interval"
			DEFVAL { 60 }
			::= { extremeWingCfgDevIgsEntry 8 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.18.27.1.1.9
		extremeWingCfgDevIgsIpIgmpSnoopingQuerierRobustnessVariable OBJECT-TYPE
			SYNTAX Unsigned32 (1..7)
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"
				
				XPath: /extremeWing-config/device[mac=key1]/ip_igmp_snooping_querier_robustness_variable"
			DEFVAL { 2 }
			::= { extremeWingCfgDevIgsEntry 9 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.18.28
		extremeWingCfgDevDynRoute OBJECT IDENTIFIER ::= { extremeWingCfgDev 28 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.18.28.1
		extremeWingCfgDevDynRouteOspfTable OBJECT-TYPE
			SYNTAX SEQUENCE OF ExtremeWingCfgDevDynRouteOspfEntry
			MAX-ACCESS not-accessible
			STATUS current
			DESCRIPTION
				"Route Ospf Table.
				
				/extremeWing-config/device/dynamic_router_ospf"
			::= { extremeWingCfgDevDynRoute 1 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.18.28.1.1
		extremeWingCfgDevDynRouteOspfEntry OBJECT-TYPE
			SYNTAX ExtremeWingCfgDevDynRouteOspfEntry
			MAX-ACCESS not-accessible
			STATUS current
			DESCRIPTION
				"An entry in the table."
			INDEX { extremeWingCfgDevMac }
			::= { extremeWingCfgDevDynRouteOspfTable 1 }

		
		ExtremeWingCfgDevDynRouteOspfEntry ::=
			SEQUENCE { 
				extremeWingCfgDevDynRouteOspfEnabled
					TruthValue,
				extremeWingCfgDevDynRouteOspfRouterId
					OCTET STRING,
				extremeWingCfgDevDynRouteOspfAutoCost
					Unsigned32,
				extremeWingCfgDevDynRouteOspfPassiveAll
					TruthValue,
				extremeWingCfgDevDynRouteOspfPassive
					DisplayString,
				extremeWingCfgDevDynRouteOspfPassiveRemoved
					DisplayString,
				extremeWingCfgDevDynRouteOspfVrrpStateCheck
					TruthValue,
				extremeWingCfgDevDynRouteOspfDefaultRoutePriority
					Unsigned32,
				extremeWingCfgDevDynRouteOspfNumRoutes
					Unsigned32,
				extremeWingCfgDevDynRouteOspfRetryCount
					Unsigned32,
				extremeWingCfgDevDynRouteOspfRetryTimeout
					Unsigned32,
				extremeWingCfgDevDynRouteOspfResetTime
					Unsigned32
			 }

		-- 1.3.6.1.4.1.1916.2.131.50.1.3.18.28.1.1.1
		extremeWingCfgDevDynRouteOspfEnabled OBJECT-TYPE
			SYNTAX TruthValue
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Dynamic routing protocol OSPF
				
				XPath: /extremeWing-config/device[mac=key1]/dynamic_router_ospf/ospf"
			DEFVAL { false }
			::= { extremeWingCfgDevDynRouteOspfEntry 1 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.18.28.1.1.2
		extremeWingCfgDevDynRouteOspfRouterId OBJECT-TYPE
			SYNTAX OCTET STRING
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Router-ID for this device. If Router-ID is not configured, system generates one and it can be viewed in statistics
				
				XPath: /extremeWing-config/device[mac=key1]/dynamic_router_ospf/router_id"
			::= { extremeWingCfgDevDynRouteOspfEntry 2 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.18.28.1.1.3
		extremeWingCfgDevDynRouteOspfAutoCost OBJECT-TYPE
			SYNTAX Unsigned32 (1..4294967)
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Specifies reference bandwidth to be used in Mbps to calculate OSPF interface cost if OSPF area is STUB or NSSA
				
				XPath: /extremeWing-config/device[mac=key1]/dynamic_router_ospf/auto_cost"
			::= { extremeWingCfgDevDynRouteOspfEntry 3 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.18.28.1.1.4
		extremeWingCfgDevDynRouteOspfPassiveAll OBJECT-TYPE
			SYNTAX TruthValue
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Configures all L3 interfaces as OSPF passive interface
				
				XPath: /extremeWing-config/device[mac=key1]/dynamic_router_ospf/passive_all"
			DEFVAL { false }
			::= { extremeWingCfgDevDynRouteOspfEntry 4 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.18.28.1.1.5
		extremeWingCfgDevDynRouteOspfPassive OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Configures specified interface(s) as OSPF passive interface(s).
				
				XPath: /extremeWing-config/device[mac=key1]/dynamic_router_ospf/passive"
			::= { extremeWingCfgDevDynRouteOspfEntry 5 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.18.28.1.1.6
		extremeWingCfgDevDynRouteOspfPassiveRemoved OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Configures specified interface(s) as OSPF NON-passive interface(s).
				
				XPath: /extremeWing-config/device[mac=key1]/dynamic_router_ospf/passive_removed"
			REFERENCE
				"Configures specified interface(s) as OSPF NON-passive interface(s)."
			::= { extremeWingCfgDevDynRouteOspfEntry 6 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.18.28.1.1.7
		extremeWingCfgDevDynRouteOspfVrrpStateCheck OBJECT-TYPE
			SYNTAX TruthValue
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Publish interface via OSPF only if the interface VRRP state is not BACKUP.
				
				XPath: /extremeWing-config/device[mac=key1]/dynamic_router_ospf/vrrp_state_check"
			::= { extremeWingCfgDevDynRouteOspfEntry 7 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.18.28.1.1.8
		extremeWingCfgDevDynRouteOspfDefaultRoutePriority OBJECT-TYPE
			SYNTAX Unsigned32 (1..8000)
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Priority for the default route learnt via OSPF.
				
				XPath: /extremeWing-config/device[mac=key1]/dynamic_router_ospf/ospf_default_route_priority"
			DEFVAL { 7000 }
			::= { extremeWingCfgDevDynRouteOspfEntry 8 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.18.28.1.1.9
		extremeWingCfgDevDynRouteOspfNumRoutes OBJECT-TYPE
			SYNTAX Unsigned32 (1..4294967295)
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Maximum number of OSPF routes allowed.
				
				XPath: /extremeWing-config/device[mac=key1]/dynamic_router_ospf/route_limit/num_routes"
			::= { extremeWingCfgDevDynRouteOspfEntry 9 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.18.28.1.1.10
		extremeWingCfgDevDynRouteOspfRetryCount OBJECT-TYPE
			SYNTAX Unsigned32 (1..32)
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Maximum number for which OSPF process will be reset before permanently shutting down OSPF.
				
				XPath: /extremeWing-config/device[mac=key1]/dynamic_router_ospf/route_limit/retry_count"
			DEFVAL { 5 }
			::= { extremeWingCfgDevDynRouteOspfEntry 10 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.18.28.1.1.11
		extremeWingCfgDevDynRouteOspfRetryTimeout OBJECT-TYPE
			SYNTAX Unsigned32 (1..3600)
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Time in seconds during which the OSPF process remains shut before attempting next retry.
				
				XPath: /extremeWing-config/device[mac=key1]/dynamic_router_ospf/route_limit/retry_timeout"
			DEFVAL { 60 }
			::= { extremeWingCfgDevDynRouteOspfEntry 11 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.18.28.1.1.12
		extremeWingCfgDevDynRouteOspfResetTime OBJECT-TYPE
			SYNTAX Unsigned32 (1..86400)
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Time in seconds after which retry-count is reset to zero.
				
				XPath: /extremeWing-config/device[mac=key1]/dynamic_router_ospf/route_limit/reset_time"
			DEFVAL { 360 }
			::= { extremeWingCfgDevDynRouteOspfEntry 12 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.18.28.2
		extremeWingCfgDevDynRouteOspfNetworkTable OBJECT-TYPE
			SYNTAX SEQUENCE OF ExtremeWingCfgDevDynRouteOspfNetworkEntry
			MAX-ACCESS not-accessible
			STATUS current
			DESCRIPTION
				"Route Ospf Network Table
				
				/extremeWing-config/device/dynamic_router_cfg/ospf_network"
			::= { extremeWingCfgDevDynRoute 2 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.18.28.2.1
		extremeWingCfgDevDynRouteOspfNetworkEntry OBJECT-TYPE
			SYNTAX ExtremeWingCfgDevDynRouteOspfNetworkEntry
			MAX-ACCESS not-accessible
			STATUS current
			DESCRIPTION
				"An entry in the table."
			INDEX { extremeWingCfgDevMac, extremeWingCfgDevDynRouteOspfNetwork }
			::= { extremeWingCfgDevDynRouteOspfNetworkTable 1 }

		
		ExtremeWingCfgDevDynRouteOspfNetworkEntry ::=
			SEQUENCE { 
				extremeWingCfgDevDynRouteOspfNetwork
					ExtremeWingIdentifier,
				extremeWingCfgDevDynRouteOspfNetworkAreaId
					IpAddress
			 }

		-- 1.3.6.1.4.1.1916.2.131.50.1.3.18.28.2.1.1
		extremeWingCfgDevDynRouteOspfNetwork OBJECT-TYPE
			SYNTAX ExtremeWingIdentifier
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"Networks that need to participate in OSPF
				
				XPath: /extremeWing-config/device[mac=key1]/dynamic_router_ospf/ospf_network[network=key2]/network"
			::= { extremeWingCfgDevDynRouteOspfNetworkEntry 1 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.18.28.2.1.3
		extremeWingCfgDevDynRouteOspfNetworkAreaId OBJECT-TYPE
			SYNTAX IpAddress
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"OSPF area to which this network belongs; area is a 32 bit number, which can be represented as IPv4 address
				
				XPath: /extremeWing-config/device[mac=key1]/dynamic_router_ospf/ospf_network[network=key2]/area_id"
			::= { extremeWingCfgDevDynRouteOspfNetworkEntry 3 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.18.28.3
		extremeWingCfgDevDynRouteOspfAreaTable OBJECT-TYPE
			SYNTAX SEQUENCE OF ExtremeWingCfgDevDynRouteOspfAreaEntry
			MAX-ACCESS not-accessible
			STATUS current
			DESCRIPTION
				"RouteOspfAreaTable
				
				/extremeWing-config/device/dynamic_router_cfg/ospf_area"
			::= { extremeWingCfgDevDynRoute 3 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.18.28.3.1
		extremeWingCfgDevDynRouteOspfAreaEntry OBJECT-TYPE
			SYNTAX ExtremeWingCfgDevDynRouteOspfAreaEntry
			MAX-ACCESS not-accessible
			STATUS current
			DESCRIPTION
				"An entry in the table."
			INDEX { extremeWingCfgDevMac, extremeWingCfgDevDynRouteOspfAreaId }
			::= { extremeWingCfgDevDynRouteOspfAreaTable 1 }

		
		ExtremeWingCfgDevDynRouteOspfAreaEntry ::=
			SEQUENCE { 
				extremeWingCfgDevDynRouteOspfAreaId
					ExtremeWingIdentifier,
				extremeWingCfgDevDynRouteOspfAreaAuthentication
					DisplayString,
				extremeWingCfgDevDynRouteOspfAreaRange
					DisplayString,
				extremeWingCfgDevDynRouteOspfAreaType
					DisplayString,
				extremeWingCfgDevDynRouteOspfAreaDefaultCost
					Unsigned32,
				extremeWingCfgDevDynRouteOspfAreaTranslateType
					DisplayString
			 }

		-- 1.3.6.1.4.1.1916.2.131.50.1.3.18.28.3.1.1
		extremeWingCfgDevDynRouteOspfAreaId OBJECT-TYPE
			SYNTAX ExtremeWingIdentifier
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"OSPF area related parameters
				
				XPath: /extremeWing-config/device[mac=key1]/dynamic_router_ospf/ospf_area[ospf_area_id=key2]/ospf_area_id"
			::= { extremeWingCfgDevDynRouteOspfAreaEntry 1 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.18.28.3.1.3
		extremeWingCfgDevDynRouteOspfAreaAuthentication OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"OSPF authentication type
				
				Values:
				simple-password,
				message-digest,
				none
				
				XPath: /extremeWing-config/device[mac=key1]/dynamic_router_ospf/ospf_area[ospf_area_id=key2]/authentication"
			DEFVAL { "none" }
			::= { extremeWingCfgDevDynRouteOspfAreaEntry 3 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.18.28.3.1.4
