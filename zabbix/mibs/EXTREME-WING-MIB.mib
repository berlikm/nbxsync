			SYNTAX Unsigned32
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"Number of 11a clients
				
				XPath: /extremeWing-stats/rf_domain[name=key1]/wireless/radio-stats[radio_id=key2]/num_a_clients"
			::= { extremeWingStatsRfdWlRadioStatEntry 26 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.4.3.2.9.1.1.27
		extremeWingStatsRfdWlRadioStatNumAnClients OBJECT-TYPE
			SYNTAX Unsigned32
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"Number of 11an clients
				
				XPath: /extremeWing-stats/rf_domain[name=key1]/wireless/radio-stats[radio_id=key2]/num_an_clients"
			::= { extremeWingStatsRfdWlRadioStatEntry 27 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.4.3.2.9.1.1.28
		extremeWingStatsRfdWlRadioStatMediumErrorRate OBJECT-TYPE
			SYNTAX Unsigned32
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"Ratio of medium errors and rx-retries to rx-packets
				in percentage
				
				XPath: /extremeWing-stats/rf_domain[name=key1]/wireless/radio-stats[radio_id=key2]/medium_error_rate"
			::= { extremeWingStatsRfdWlRadioStatEntry 28 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.4.3.2.9.1.1.29
		extremeWingStatsRfdWlRadioStatTxRetries OBJECT-TYPE
			SYNTAX Counter64
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"Total number of retries
				
