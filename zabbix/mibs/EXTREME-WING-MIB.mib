			SYNTAX Integer32
			UNITS "dbm"
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"Signal strength in units of dbm
				
				XPath: /extremeWing-stats/rf_domain[name=key1]/wireless/radio-stats-details[radio_id=key2]/signal"
