		-- 1.3.6.1.4.1.1916.2.131.50.1.3.6.1.1.40
		extremeWingCfgRadioQosAdmCtrlBackgroundReservedForRoamPercent OBJECT-TYPE
			SYNTAX Unsigned32 (0..150)
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Additional percentage of air time allocated exclusively for
				roamed wireless clients.
				
				XPath: /extremeWing-config/radio_qos[name=key1]/admission_control_background_reserved_for_roam_percent"
			DEFVAL { 10 }
			::= { extremeWingCfgRadioQosEntry 40 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.6.1.1.41
		extremeWingCfgRadioQosAccelMcastMaxStreams OBJECT-TYPE
			SYNTAX Unsigned32 (0..256)
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Maximum number of accelerated multicast streams per radio.
				
				XPath: /extremeWing-config/radio_qos[name=key1]/accelerated_multicast_max_streams"
			DEFVAL { 25 }
			::= { extremeWingCfgRadioQosEntry 41 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.6.1.1.42
		extremeWingCfgRadioQosAccelMcastOverflowPolicy OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Policy for what to do when more then the maximum number of
				accelerated multicast streams become active: Revert to
				non-accelerated multicast or reject new streams.
				
				Values:
				revert
				reject
				
				XPath: /extremeWing-config/radio_qos[name=key1]/accelerated_multicast_overflow_policy"
			DEFVAL { "reject" }
			::= { extremeWingCfgRadioQosEntry 42 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.6.1.1.43
		extremeWingCfgRadioQosAccelMcastMaxClientStreams OBJECT-TYPE
			SYNTAX Unsigned32 (1..4)
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Maximum number of accelerated multicast streams per
				wireless client.
				
				XPath: /extremeWing-config/radio_qos[name=key1]/accelerated_multicast_max_client_streams"
			DEFVAL { 2 }
			::= { extremeWingCfgRadioQosEntry 43 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.6.1.1.44
		extremeWingCfgRadioQosAccelMcastStreamThreshold OBJECT-TYPE
			SYNTAX Unsigned32 (1..500)
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Packets per second threshold for a multicast stream to
				qualify for accelerated multicast in case the multicast
				address was not explicitly configured.
				
				XPath: /extremeWing-config/radio_qos[name=key1]/accelerated_multicast_stream_threshold"
			DEFVAL { 25 }
			::= { extremeWingCfgRadioQosEntry 44 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.6.1.1.45
		extremeWingCfgRadioQosAccelMcastClientTimeout OBJECT-TYPE
			SYNTAX Unsigned32 (5..6000)
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Number of seconds between reJOINING of a wireless client to
				an accelerated multicast stream. Client may be removed if it
				does not respond to a request during that time.
				
				XPath: /extremeWing-config/radio_qos[name=key1]/accelerated_multicast_client_timeout"
			DEFVAL { 60 }
			::= { extremeWingCfgRadioQosEntry 45 }

		
-- /extremeWing-config/aaa_policy
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.7
		extremeWingCfgAaa OBJECT IDENTIFIER ::= { extremeWingConfig 7 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.7.1
		extremeWingCfgAaaTable OBJECT-TYPE
			SYNTAX SEQUENCE OF ExtremeWingCfgAaaEntry
			MAX-ACCESS not-accessible
			STATUS current
			DESCRIPTION
				"AAA policy
				
				/extremeWing-config/aaa_policy"
			::= { extremeWingCfgAaa 1 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.7.1.1
		extremeWingCfgAaaEntry OBJECT-TYPE
			SYNTAX ExtremeWingCfgAaaEntry
			MAX-ACCESS not-accessible
			STATUS current
			DESCRIPTION
				"An entry in the table."
			INDEX { extremeWingCfgAaaName }
			::= { extremeWingCfgAaaTable 1 }

		
		ExtremeWingCfgAaaEntry ::=
			SEQUENCE { 
				extremeWingCfgAaaName
					ExtremeWingIdentifier,
				extremeWingCfgAaaServerPoolingMode
					DisplayString,
				extremeWingCfgAaaMacAddrFormat
					DisplayString,
				extremeWingCfgAaaMacAddrCase
					DisplayString,
				extremeWingCfgAaaMacAddrAttributes
					DisplayString,
				extremeWingCfgAaaEapClientTimeout
					Unsigned32,
				extremeWingCfgAaaEapClientAttempts
					Unsigned32,
				extremeWingCfgAaaEapClientRetryFactor
					Unsigned32,
				extremeWingCfgAaaEapClientIdReqTimeout
					Unsigned32,
				extremeWingCfgAaaAuthProtocol
					DisplayString,
				extremeWingCfgAaaAccountingType
					DisplayString,
				extremeWingCfgAaaInterimAccountingInterval
					Unsigned32,
				extremeWingCfgAaaNacList
					ExtremeWingIdentifier
			 }

		-- 1.3.6.1.4.1.1916.2.131.50.1.3.7.1.1.1
		extremeWingCfgAaaName OBJECT-TYPE
			SYNTAX ExtremeWingIdentifier
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"The user-defined name of the AAA policy.
				
				XPath: /extremeWing-config/aaa_policy[name=key1]/name"
			::= { extremeWingCfgAaaEntry 1 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.7.1.1.3
		extremeWingCfgAaaServerPoolingMode OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Controls how requests are transmitted across RADIUS servers.
				Failover implies working down the list of servers if any
				server is unresponsive. load-balanced implies use of all
				servers, transmitting requests in a round-robin fashion.
				
				Values:
				failover
				load-balance
				
				XPath: /extremeWing-config/aaa_policy[name=key1]/server_pooling_mode"
			DEFVAL { "failover" }
			::= { extremeWingCfgAaaEntry 3 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.7.1.1.4
		extremeWingCfgAaaMacAddrFormat OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Configure the format in which the MAC address is packed
				in the RADIUS request packets
				(AABBCCDDEEFF/AA:BB:CC:DD:EE:FF/AA-BB-CC-DD-EE-FF/
				AABB.CCDD.EEFF/AABBCC-DDEEFF).
				
				Values:
				no-delim
				pair-colon
				pair-hyphen
				quad-dot
				middle-hyphen
				
				XPath: /extremeWing-config/aaa_policy[name=key1]/mac_address_format/format"
			DEFVAL { "pair-hyphen" }
			::= { extremeWingCfgAaaEntry 4 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.7.1.1.5
		extremeWingCfgAaaMacAddrCase OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"whether the MAC address is filled in upper case
				(AA-BB-CC-DD-EE-FF) or lower case (aa-bb-cc-dd-ee-ff)
				
				Values:
				upper
				lower
				
				XPath: /extremeWing-config/aaa_policy[name=key1]/mac_address_format/case"
			DEFVAL { "upper" }
			::= { extremeWingCfgAaaEntry 5 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.7.1.1.6
		extremeWingCfgAaaMacAddrAttributes OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"whether this format specified applies only to the
				username/password in mac-auth, or for all attributes that
				include a mac address, such as calling-station-id,
				called-station-id etc
				
				Values:
				username-password
				all
				
				XPath: /extremeWing-config/aaa_policy[name=key1]/mac_address_format/attributes"
			DEFVAL { "username-password" }
			::= { extremeWingCfgAaaEntry 6 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.7.1.1.7
		extremeWingCfgAaaEapClientTimeout OBJECT-TYPE
			SYNTAX Unsigned32 (1..60)
			UNITS "seconds"
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"The amount of time after which an EAP request towards a
				Wireless Client is retried.
				
				XPath: /extremeWing-config/aaa_policy[name=key1]/eap_mu_timeout"
			DEFVAL { 3 }
			::= { extremeWingCfgAaaEntry 7 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.7.1.1.8
		extremeWingCfgAaaEapClientAttempts OBJECT-TYPE
			SYNTAX Unsigned32 (1..10)
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"The number of times an EAP request is transmitted towards
				a Wireless Client before giving up.
				
				XPath: /extremeWing-config/aaa_policy[name=key1]/eap_mu_attempts"
			DEFVAL { 3 }
			::= { extremeWingCfgAaaEntry 8 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.7.1.1.9
		extremeWingCfgAaaEapClientRetryFactor OBJECT-TYPE
			SYNTAX Unsigned32 (50..200)
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Configures the scaling of the retransmission attempts.
				Timeout at each attempt is a function of this retry_timeout
				factor and the attempt number. 100 implies a constant timeout
				on each retry, smaller values indicate more aggressive
				(shorter) timeouts, larger numbers indicate more conservative
				(larger) timeouts on each successive attempt.
				
				XPath: /extremeWing-config/aaa_policy[name=key1]/eap_mu_retry_factor"
			DEFVAL { 100 }
			::= { extremeWingCfgAaaEntry 9 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.7.1.1.10
		extremeWingCfgAaaEapClientIdReqTimeout OBJECT-TYPE
			SYNTAX Unsigned32 (1..60)
			UNITS "seconds"
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"The amount of time after which an EAP-ID-Request towards a
				Wireless Client is retried.
				
				XPath: /extremeWing-config/aaa_policy[name=key1]/eap_mu_id_req_timeout"
			DEFVAL { 10 }
			::= { extremeWingCfgAaaEntry 10 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.7.1.1.11
		extremeWingCfgAaaAuthProtocol OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"The authentication protocol (Password Authentication Protocol
				or Challenge Handshake Authentication Protocol) to use when
				the server is used for any non-EAP authentication.
				
				Values:
				pap
				chap
				
				XPath: /extremeWing-config/aaa_policy[name=key1]/authentication_protocol"
			DEFVAL { "pap" }
			::= { extremeWingCfgAaaEntry 11 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.7.1.1.12
		extremeWingCfgAaaAccountingType OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Control the type of RADIUS Accounting request packets that
				are to be generated.
				
				Values:
				stop-only
				start-stop
				start-interim-stop
				
				XPath: /extremeWing-config/aaa_policy[name=key1]/accounting_type"
			DEFVAL { "start-stop" }
			::= { extremeWingCfgAaaEntry 12 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.7.1.1.13
		extremeWingCfgAaaInterimAccountingInterval OBJECT-TYPE
			SYNTAX Unsigned32 (60..3600)
			UNITS "seconds"
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"The periodicity of the interim accounting requests.
				
				XPath: /extremeWing-config/aaa_policy[name=key1]/interim_accounting_interval"
			DEFVAL { 1800 }
			::= { extremeWingCfgAaaEntry 13 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.7.1.1.14
		extremeWingCfgAaaNacList OBJECT-TYPE
			SYNTAX ExtremeWingIdentifier
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Filter to include or exclude certain Wireless Clients from
				network access control.
				
				XPath: /extremeWing-config/aaa_policy[name=key1]/nac_list"
			::= { extremeWingCfgAaaEntry 14 }

		
