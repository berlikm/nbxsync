-- /extremeWing-stats/rf_domain/wireless/radio
		-- 1.3.6.1.4.1.1916.2.131.50.1.4.3.2.8
		extremeWingStatsRfdWlRadio OBJECT IDENTIFIER ::= { extremeWingStatsRfdWl 8 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.4.3.2.8.1
		extremeWingStatsRfdWlRadioTable OBJECT-TYPE
			SYNTAX SEQUENCE OF ExtremeWingStatsRfdWlRadioEntry
			MAX-ACCESS not-accessible
			STATUS current
			DESCRIPTION
				"Status of radios on RF Domain
				
				/extremeWing-stats/rf_domain/wireless/radio"
			::= { extremeWingStatsRfdWlRadio 1 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.4.3.2.8.1.1
		extremeWingStatsRfdWlRadioEntry OBJECT-TYPE
			SYNTAX ExtremeWingStatsRfdWlRadioEntry
			MAX-ACCESS not-accessible
			STATUS current
			DESCRIPTION
				"An entry in the table."
			INDEX { extremeWingStatsRfdName, extremeWingStatsRfdWlRadioId }
			::= { extremeWingStatsRfdWlRadioTable 1 }

		
		ExtremeWingStatsRfdWlRadioEntry ::=
			SEQUENCE { 
				extremeWingStatsRfdWlRadioId
					ExtremeWingIdentifier,
				extremeWingStatsRfdWlRadioDeviceMac
					MacAddress,
				extremeWingStatsRfdWlRadioAlias
					DisplayString,
				extremeWingStatsRfdWlRadioMac
					MacAddress,
				extremeWingStatsRfdWlRadioType
					DisplayString,
				extremeWingStatsRfdWlRadioHostname
					DisplayString,
				extremeWingStatsRfdWlRadioRfdName
					DisplayString,
				extremeWingStatsRfdWlRadioLocation
					DisplayString,
				extremeWingStatsRfdWlRadioState
					DisplayString,
				extremeWingStatsRfdWlRadioCurChannel
					DisplayString,
				extremeWingStatsRfdWlRadioConfigChannel
					DisplayString,
				extremeWingStatsRfdWlRadioCurPower
					Unsigned32,
				extremeWingStatsRfdWlRadioConfigPower
					DisplayString,
				extremeWingStatsRfdWlRadioMaxUserRate
					Counter64,
				extremeWingStatsRfdWlRadioNumClient
					Unsigned32,
				extremeWingStatsRfdWlRadioProtocol
					Unsigned32
			 }

		-- 1.3.6.1.4.1.1916.2.131.50.1.4.3.2.8.1.1.1
		extremeWingStatsRfdWlRadioId OBJECT-TYPE
			SYNTAX ExtremeWingIdentifier
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"Unique ID for each radio interface in the form of
				AP-MAC:R%d. E.g., 00-A0-F8-00-00-00:R1
				
				XPath: /extremeWing-stats/rf_domain[name=key1]/wireless/radio[radio_id=key2]/radio_id"
			::= { extremeWingStatsRfdWlRadioEntry 1 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.4.3.2.8.1.1.2
		extremeWingStatsRfdWlRadioDeviceMac OBJECT-TYPE
			SYNTAX MacAddress
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"MAC address of the AP the radio belongs to.
				
				XPath: /extremeWing-stats/rf_domain[name=key1]/wireless/radio[radio_id=key2]/device_mac"
			::= { extremeWingStatsRfdWlRadioEntry 2 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.4.3.2.8.1.1.3
		extremeWingStatsRfdWlRadioAlias OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"An alias to radio id in the form of hostname:R%d.
				E.g., wm3400-22A24E:R1
				
				XPath: /extremeWing-stats/rf_domain[name=key1]/wireless/radio[radio_id=key2]/radio_alias"
			::= { extremeWingStatsRfdWlRadioEntry 3 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.4.3.2.8.1.1.4
		extremeWingStatsRfdWlRadioMac OBJECT-TYPE
			SYNTAX MacAddress
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"MAC address of the radio interface
				
				XPath: /extremeWing-stats/rf_domain[name=key1]/wireless/radio[radio_id=key2]/radio_mac"
			::= { extremeWingStatsRfdWlRadioEntry 4 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.4.3.2.8.1.1.5
