		extremeWingStatsDevWlRadioStatSnr OBJECT-TYPE
			SYNTAX Integer32
			UNITS "db"
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"Signal to noise ratio in units of db
				
				XPath: /extremeWing-stats/device[mac=key1]/wireless/radio-stats[radio_id=key2]/snr"
			::= { extremeWingStatsDevWlRadioStatEntry 17 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.4.2.25.10.1.1.18
		extremeWingStatsDevWlRadioStatTxRate OBJECT-TYPE
			SYNTAX Unsigned32
			UNITS "Mbps"
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"The effective phy-layer transmit rate
				
				XPath: /extremeWing-stats/device[mac=key1]/wireless/radio-stats[radio_id=key2]/tx_rate"
			::= { extremeWingStatsDevWlRadioStatEntry 18 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.4.2.25.10.1.1.19
