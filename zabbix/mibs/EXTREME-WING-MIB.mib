-- Extensions to mib-2.system
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.1
		extremeWingCfgSys OBJECT IDENTIFIER ::= { extremeWingConfig 1 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.1.5
		extremeWingConfigSysMacAddr OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"MAC address of the system.
				
				XPath: /extremeWing-config/device[mac='self']/mac"
			::= { extremeWingCfgSys 5 }

		
-- System commit parameters
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.1.6
		extremeWingCfgSysCommit OBJECT IDENTIFIER ::= { extremeWingCfgSys 6 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.1.6.1
		extremeWingCfgSysCommitLastError OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"A short while after a successful SNMP set operation,
				the system does an automatic commit. The automatic commit
				may fail for reasons including invalid values.
				
				This object contains the error message from
				the last automatic commit.
				
				Be sure to check this object after a few SNMP set operations
				to make sure that the commit is successful.
				
				In case of error, clear the error by setting the object(s)
				corresponding to the failed configuration item(s) with
				the correct values."
			::= { extremeWingCfgSysCommit 1 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.1.7
		extremeWingCfgSysRunningConfigChecksum OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"MD5 checksum of system:running-config.
				
				XPath: /extremeWing-stats/device/self/config-checksum"
			::= { extremeWingCfgSys 7 }

		
-- /extremeWing-config/version
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.2
		extremeWingCfgVersion OBJECT IDENTIFIER ::= { extremeWingConfig 2 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.2.1
		extremeWingCfgVersionVal OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"Version of configuration
				
				XPath: /extremeWing-config/version[name=default]/version"
			::= { extremeWingCfgVersion 1 }

		
-- /extremeWing-config/password_encryption
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.3
		extremeWingCfgPasswordEnc OBJECT IDENTIFIER ::= { extremeWingConfig 3 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.3.1
		extremeWingCfgPasswordEncVal OBJECT-TYPE
			SYNTAX OCTET STRING
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"sha256 digest as a hex string of the passphrase used to
				encrypt passwords in the configuration or
				zero length string when encryption is disabled.
				
				XPath: /extremeWing-config/password_encryption[name=default]/password_encryption"
			::= { extremeWingCfgPasswordEnc 1 }

		
-- /extremeWing-config/password_encryption/_set_pe_
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.3.2
		extremeWingCfgPasswordEncSet OBJECT IDENTIFIER ::= { extremeWingCfgPasswordEnc 2 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.3.2.1
		extremeWingCfgPasswordEncSetOldPassphrase OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"This object is used to encrypt passwords in the configuration.
				To set encryption passphrase with validation this object
				must be set with the current passphrase.
				
				This object is write-only, read simply returns zero length
				string.
				
				XPath: /extremeWing-config/password_encryption[name=default]/_set_pe_/old_pwd"
			::= { extremeWingCfgPasswordEncSet 1 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.3.2.2
		extremeWingCfgPasswordEncSetNewPassphrase OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"This object is used to encrypt passwords in the configuration.
				To set encryption passphrase with validation this object
				must be set with the new passphrase or an empty string
				to indicate no encryption.
				
				The current passphrase must be set in the previous object
				before setting object.
				
				This object is write-only, read simply returns zero length
				string.
				
				XPath: /extremeWing-config/password_encryption[name=default]/_set_pe_/new_pwd"
			::= { extremeWingCfgPasswordEncSet 2 }

		
-- /extremeWing-config/wlan
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.4
		extremeWingCfgWlan OBJECT IDENTIFIER ::= { extremeWingConfig 4 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.4.1
		extremeWingCfgWlanTable OBJECT-TYPE
			SYNTAX SEQUENCE OF ExtremeWingCfgWlanEntry
			MAX-ACCESS not-accessible
			STATUS current
			DESCRIPTION
				"Configuration parameters of a Wireless LAN.
				
				/extremeWing-config/wlan"
			::= { extremeWingCfgWlan 1 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.4.1.1
		extremeWingCfgWlanEntry OBJECT-TYPE
			SYNTAX ExtremeWingCfgWlanEntry
			MAX-ACCESS not-accessible
			STATUS current
			DESCRIPTION
				"An entry in the table."
			INDEX { extremeWingCfgWlanName }
			::= { extremeWingCfgWlanTable 1 }

		
		ExtremeWingCfgWlanEntry ::=
			SEQUENCE { 
				extremeWingCfgWlanName
					ExtremeWingIdentifier,
				extremeWingCfgWlanShutdown
					TruthValue,
				extremeWingCfgWlanSsid
					DisplayString,
				extremeWingCfgWlanDescr
					DisplayString,
				extremeWingCfgWlanEncType
