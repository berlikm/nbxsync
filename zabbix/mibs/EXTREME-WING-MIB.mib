				XPath: /extremeWing-config/ap300[mac=key1]/interface[name=key2]/description"
			::= { extremeWingCfgLegacyApIfEntry 3 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.33.2.1.4
		extremeWingCfgLegacyApIfShutdown OBJECT-TYPE
			SYNTAX TruthValue
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
