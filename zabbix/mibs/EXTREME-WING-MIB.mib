				extremeWingStatsDevWlRadioMaxUserRate
					Counter64,
				extremeWingStatsDevWlRadioNumClient
					Unsigned32,
				extremeWingStatsDevWlRadioProtocol
					Unsigned32
			 }

		-- 1.3.6.1.4.1.1916.2.131.50.1.4.2.25.9.1.1.1
		extremeWingStatsDevWlRadioId OBJECT-TYPE
			SYNTAX ExtremeWingIdentifier
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"Unique ID for each radio interface in the form of
				AP-MAC:R%d. E.g., 00-A0-F8-00-00-00:R1
				
				XPath: /extremeWing-stats/device[mac=key1]/wireless/radio[radio_id=key2]/radio_id"
			::= { extremeWingStatsDevWlRadioEntry 1 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.4.2.25.9.1.1.2
		extremeWingStatsDevWlRadioDeviceMac OBJECT-TYPE
			SYNTAX MacAddress
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"MAC address of the AP the radio belongs to.
				
				XPath: /extremeWing-stats/device[mac=key1]/wireless/radio[radio_id=key2]/device_mac"
