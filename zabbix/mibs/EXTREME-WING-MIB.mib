					Unsigned32,
				extremeWingStatsDevVrrpGlobalErrVersionMismatch
					Unsigned32,
				extremeWingStatsDevVrrpGlobalErrPacketLenErr
					Unsigned32,
				extremeWingStatsDevVrrpGlobalErrChecksumErr
					Unsigned32,
				extremeWingStatsDevVrrpGlobalErrInvalidVirtualRouterId
					Unsigned32,
				extremeWingStatsDevVrrpGlobalErrAuthMismatch
					Unsigned32,
