			SYNTAX Counter64
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"Number of packets of data dropped on transmission
				
				XPath: /extremeWing-stats/rf_domain[name=key1]/wireless/radio-stats-details[radio_id=key2]/tx_dropped"
			::= { extremeWingStatsRfdWlRadioStatDetailEntry 10 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.4.3.2.11.1.1.11
		extremeWingStatsRfdWlRadioStatDetailRxErrors OBJECT-TYPE
			SYNTAX Counter64
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"Number of packets of data received with errors
				
				XPath: /extremeWing-stats/rf_domain[name=key1]/wireless/radio-stats-details[radio_id=key2]/rx_errors"
			::= { extremeWingStatsRfdWlRadioStatDetailEntry 11 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.4.3.2.11.1.1.12
		extremeWingStatsRfdWlRadioStatDetailTIndex OBJECT-TYPE
			SYNTAX Integer32
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"Traffic Utilization Index
				
				Measures the efficiency the medium under consideration
				is used. It is the percentage of the current data throughput
				over the theoretical data rate limit, which is derived
				the current maximum physical rate configured over the medium
				based on past empirical data. This index could assist end user
				in site planning and expansion. The numerical value might be
				further classified as:
				  -1: no data available ( e.g. radio is not in wlan operation
				                          mode )
				  0-20 : very low utilization
				  20-40: low utilization
				  40-60: moderate utilization
				  60 and above: high utilization
				
				XPath: /extremeWing-stats/rf_domain[name=key1]/wireless/radio-stats-details[radio_id=key2]/t_index"
			::= { extremeWingStatsRfdWlRadioStatDetailEntry 12 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.4.3.2.11.1.1.13
		extremeWingStatsRfdWlRadioStatDetailTxBps OBJECT-TYPE
			SYNTAX Unsigned32
			UNITS "kbps"
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"User data transmit rate
				
				XPath: /extremeWing-stats/rf_domain[name=key1]/wireless/radio-stats-details[radio_id=key2]/tx_bps"
			::= { extremeWingStatsRfdWlRadioStatDetailEntry 13 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.4.3.2.11.1.1.14
		extremeWingStatsRfdWlRadioStatDetailRxBps OBJECT-TYPE
			SYNTAX Unsigned32
			UNITS "kbps"
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"User data receive rate
				
				XPath: /extremeWing-stats/rf_domain[name=key1]/wireless/radio-stats-details[radio_id=key2]/rx_bps"
			::= { extremeWingStatsRfdWlRadioStatDetailEntry 14 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.4.3.2.11.1.1.15
