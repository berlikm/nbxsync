				XPath: /extremeWing-config/profile[name=key1]/interface[name=key2]/bandwidth"
			::= { extremeWingCfgProfIfVlanOspfEntry 5 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.16.2.14
