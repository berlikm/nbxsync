			SYNTAX SEQUENCE OF ExtremeWingCfgDevVpnCryptoInstAhSessionEntry
			MAX-ACCESS not-accessible
			STATUS current
			DESCRIPTION
				"NOTE: Columns under this table are valid only if extremeWingCfgDevVpnCryptoInstType sets to site-to-site-manual
				
				/extremeWing-config/device/crypto_map/crypto_map_entry/ah_session_keys"
			::= { extremeWingCfgDevVpn 12 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.18.19.12.1
		extremeWingCfgDevVpnCryptoInstAhSessionEntry OBJECT-TYPE
			SYNTAX ExtremeWingCfgDevVpnCryptoInstAhSessionEntry
			MAX-ACCESS not-accessible
			STATUS current
			DESCRIPTION
				"An entry in the table."
			INDEX { extremeWingCfgDevMac, extremeWingCfgDevVpnCryptoName, extremeWingCfgDevVpnCryptoInstSequence, extremeWingCfgDevVpnCryptoInstAhSessionDirection }
			::= { extremeWingCfgDevVpnCryptoInstAhSessionTable 1 }

		
		ExtremeWingCfgDevVpnCryptoInstAhSessionEntry ::=
			SEQUENCE { 
				extremeWingCfgDevVpnCryptoInstAhSessionDirection
					ExtremeWingIdentifier,
				extremeWingCfgDevVpnCryptoInstAhSessionSpi
					Unsigned32,
				extremeWingCfgDevVpnCryptoInstAhSessionAuthAlgo
					DisplayString,
				extremeWingCfgDevVpnCryptoInstAhSessionKey
					OCTET STRING
			 }

		-- 1.3.6.1.4.1.1916.2.131.50.1.3.18.19.12.1.1
		extremeWingCfgDevVpnCryptoInstAhSessionDirection OBJECT-TYPE
			SYNTAX ExtremeWingIdentifier
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"Direction of the security association.
				
				Values:
				inbound,
				outbound
				
				XPath: /extremeWing-config/device[mac=key1]/crypto_map[name=key2]/crypto_map_entry[sequence=key3]/ah_session_keys[direction=key4]/direction"
			::= { extremeWingCfgDevVpnCryptoInstAhSessionEntry 1 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.18.19.12.1.3
		extremeWingCfgDevVpnCryptoInstAhSessionSpi OBJECT-TYPE
			SYNTAX Unsigned32 (256..4294967295)
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Security Parameter Index for Security Association. This should be unique for all Security Associations.
				
				XPath: /extremeWing-config/device[mac=key1]/crypto_map[name=key2]/crypto_map_entry[sequence=key3]/ah_session_keys[direction=key4]/spi"
			::= { extremeWingCfgDevVpnCryptoInstAhSessionEntry 3 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.18.19.12.1.4
		extremeWingCfgDevVpnCryptoInstAhSessionAuthAlgo OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Authentication scheme used to validate identity.
				
				Values:
				md5,
				sha
				
				XPath: /extremeWing-config/device[mac=key1]/crypto_map[name=key2]/crypto_map_entry[sequence=key3]/ah_session_keys[direction=key4]/auth_algo"
			DEFVAL { "sha" }
			::= { extremeWingCfgDevVpnCryptoInstAhSessionEntry 4 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.18.19.12.1.5
		extremeWingCfgDevVpnCryptoInstAhSessionKey OBJECT-TYPE
			SYNTAX OCTET STRING (SIZE (8..512))
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Security association key value. The following key lengths (in hex characters) are required.ESP-MD5: 32,ESP-SHA: 40.
				
				XPath: /extremeWing-config/device[mac=key1]/crypto_map[name=key2]/crypto_map_entry[sequence=key3]/ah_session_keys[direction=key4]/key"
			::= { extremeWingCfgDevVpnCryptoInstAhSessionEntry 5 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.18.19.13
		extremeWingCfgDevVpnCryptoInstEspSessionTable OBJECT-TYPE
			SYNTAX SEQUENCE OF ExtremeWingCfgDevVpnCryptoInstEspSessionEntry
			MAX-ACCESS not-accessible
			STATUS current
			DESCRIPTION
				"NOTE: Columns under this table are valid only if extremeWingCfgDevVpnCryptoInstType sets to site-to-site-manual
				
				/extremeWing-config/device/crypto_map/crypto_map_entry/esp_session_keys"
			::= { extremeWingCfgDevVpn 13 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.18.19.13.1
		extremeWingCfgDevVpnCryptoInstEspSessionEntry OBJECT-TYPE
			SYNTAX ExtremeWingCfgDevVpnCryptoInstEspSessionEntry
			MAX-ACCESS not-accessible
			STATUS current
			DESCRIPTION
				"An entry in the table."
			INDEX { extremeWingCfgDevMac, extremeWingCfgDevVpnCryptoName, extremeWingCfgDevVpnCryptoInstSequence, extremeWingCfgDevVpnCryptoInstEspSessionDirection }
			::= { extremeWingCfgDevVpnCryptoInstEspSessionTable 1 }

		
		ExtremeWingCfgDevVpnCryptoInstEspSessionEntry ::=
			SEQUENCE { 
				extremeWingCfgDevVpnCryptoInstEspSessionDirection
					ExtremeWingIdentifier,
				extremeWingCfgDevVpnCryptoInstEspSessionSpi
					Unsigned32,
				extremeWingCfgDevVpnCryptoInstEspSessionCipherAlgo
					DisplayString,
				extremeWingCfgDevVpnCryptoInstEspSessionCipherKey
					OCTET STRING,
				extremeWingCfgDevVpnCryptoInstEspSessionAuthAlgo
					DisplayString,
				extremeWingCfgDevVpnCryptoInstEspSessionAuthKey
					OCTET STRING
			 }

		-- 1.3.6.1.4.1.1916.2.131.50.1.3.18.19.13.1.1
		extremeWingCfgDevVpnCryptoInstEspSessionDirection OBJECT-TYPE
			SYNTAX ExtremeWingIdentifier
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"
				
				Values:
				inbound,
				outbound
				
				XPath: /extremeWing-config/device[mac=key1]/crypto_map[name=key2]/crypto_map_entry[sequence=key3]/esp_session_keys[direction=key4]/direction"
			::= { extremeWingCfgDevVpnCryptoInstEspSessionEntry 1 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.18.19.13.1.3
		extremeWingCfgDevVpnCryptoInstEspSessionSpi OBJECT-TYPE
			SYNTAX Unsigned32 (256..4294967295)
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Security Parameter Index for Security Association. This should be unique for all Security Associations.
				
				XPath: /extremeWing-config/device[mac=key1]/crypto_map[name=key2]/crypto_map_entry[sequence=key3]/esp_session_keys[direction=key4]/spi"
			::= { extremeWingCfgDevVpnCryptoInstEspSessionEntry 3 }

		
