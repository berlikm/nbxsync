			SYNTAX Unsigned32 (1..25)
			UNITS "seconds"
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Maximum query response time
				
				XPath: /extremeWing-config/profile[name=key1]/ip_igmp_snooping_querier_max_response_time"
			DEFVAL { 10 }
			::= { extremeWingCfgProfIgsEntry 5 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.16.22.1.1.6
