			STATUS current
			DESCRIPTION
				"Time in seconds until port is reauthenicated
				
				XPath: /extremeWing-config/device[mac=key1]/interface[name=key2]/reauth_period"
			DEFVAL { 60 }
			::= { extremeWingCfgDevIfDot1xAuthEntry 8 }

		
