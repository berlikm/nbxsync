			UNITS "dbm"
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"Noise level in units of dbm
				
				XPath: /extremeWing-stats/rf_domain[name=key1]/wireless/radio-stats-details[radio_id=key2]/noise"
