				hostname:R%d. E.g., wm3400-22A24E:R1
				
				XPath: /extremeWing-stats/device[mac=key1]/wireless/client[mac=key2]/radio_alias"
			::= { extremeWingStatsDevWlClientEntry 20 }

		
-- /extremeWing-stats/device/wireless/client-stats
		-- 1.3.6.1.4.1.1916.2.131.50.1.4.2.25.5
		extremeWingStatsDevWlClientStat OBJECT IDENTIFIER ::= { extremeWingStatsDevWl 5 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.4.2.25.5.1
		extremeWingStatsDevWlClientStatTable OBJECT-TYPE
			SYNTAX SEQUENCE OF ExtremeWingStatsDevWlClientStatEntry
			MAX-ACCESS not-accessible
			STATUS current
			DESCRIPTION
				"Statistical information of wireless clients associated
				currently.
				
				/extremeWing-stats/device/wireless/client-stats"
			::= { extremeWingStatsDevWlClientStat 1 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.4.2.25.5.1.1
		extremeWingStatsDevWlClientStatEntry OBJECT-TYPE
			SYNTAX ExtremeWingStatsDevWlClientStatEntry
			MAX-ACCESS not-accessible
			STATUS current
			DESCRIPTION
				"An entry in the table."
			INDEX { extremeWingStatsDevMac, extremeWingStatsDevWlClientStatMac }
			::= { extremeWingStatsDevWlClientStatTable 1 }

		
		ExtremeWingStatsDevWlClientStatEntry ::=
			SEQUENCE { 
				extremeWingStatsDevWlClientStatMac
					MacAddress,
				extremeWingStatsDevWlClientStatMacName
					DisplayString,
				extremeWingStatsDevWlClientStatVendor
					DisplayString,
				extremeWingStatsDevWlClientStatAp
					MacAddress,
				extremeWingStatsDevWlClientStatTxBytes
					Counter64,
				extremeWingStatsDevWlClientStatRxBytes
					Counter64,
				extremeWingStatsDevWlClientStatTxPkts
					Counter64,
				extremeWingStatsDevWlClientStatRxPkts
					Counter64,
				extremeWingStatsDevWlClientStatTxDropped
					Counter64,
				extremeWingStatsDevWlClientStatRxErrors
					Counter64,
				extremeWingStatsDevWlClientStatTIndex
					Integer32,
				extremeWingStatsDevWlClientStatTxBps
					Unsigned32,
				extremeWingStatsDevWlClientStatRxBps
					Unsigned32,
				extremeWingStatsDevWlClientStatSignal
					Integer32,
				extremeWingStatsDevWlClientStatNoise
					Integer32,
				extremeWingStatsDevWlClientStatSnr
					Integer32,
				extremeWingStatsDevWlClientStatTxRate
					Unsigned32,
				extremeWingStatsDevWlClientStatRxRate
					Unsigned32,
				extremeWingStatsDevWlClientStatErrorRate
					Unsigned32,
				extremeWingStatsDevWlClientStatQIndex
					Integer32
			 }

		-- 1.3.6.1.4.1.1916.2.131.50.1.4.2.25.5.1.1.1
		extremeWingStatsDevWlClientStatMac OBJECT-TYPE
			SYNTAX MacAddress
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"Client MAC
				
				XPath: /extremeWing-stats/device[mac=key1]/wireless/client-stats[mac=key2]/mac"
			::= { extremeWingStatsDevWlClientStatEntry 1 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.4.2.25.5.1.1.2
		extremeWingStatsDevWlClientStatMacName OBJECT-TYPE
			SYNTAX DisplayString (SIZE (0..64))
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"Hostname of the client which could be obtained from
				packet sniffing or by manually configured via
				mac-name configuration.
				
				XPath: /extremeWing-stats/device[mac=key1]/wireless/client-stats[mac=key2]/hostname"
			::= { extremeWingStatsDevWlClientStatEntry 2 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.4.2.25.5.1.1.3
		extremeWingStatsDevWlClientStatVendor OBJECT-TYPE
			SYNTAX DisplayString (SIZE (0..64))
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"Client vendor name based on the MAC OUI lookup
				
				XPath: /extremeWing-stats/device[mac=key1]/wireless/client-stats[mac=key2]/vendor"
			::= { extremeWingStatsDevWlClientStatEntry 3 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.4.2.25.5.1.1.4
		extremeWingStatsDevWlClientStatAp OBJECT-TYPE
			SYNTAX MacAddress
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"MAC address of AP where the client is associated.
				
				XPath: /extremeWing-stats/device[mac=key1]/wireless/client-stats[mac=key2]/ap"
			::= { extremeWingStatsDevWlClientStatEntry 4 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.4.2.25.5.1.1.5
		extremeWingStatsDevWlClientStatTxBytes OBJECT-TYPE
			SYNTAX Counter64
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"Number of data bytes transmitted from AP to client
				
				XPath: /extremeWing-stats/device[mac=key1]/wireless/client-stats[mac=key2]/tx_bytes"
			::= { extremeWingStatsDevWlClientStatEntry 5 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.4.2.25.5.1.1.6
		extremeWingStatsDevWlClientStatRxBytes OBJECT-TYPE
			SYNTAX Counter64
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"Number of data bytes received from client to AP
				
				XPath: /extremeWing-stats/device[mac=key1]/wireless/client-stats[mac=key2]/rx_bytes"
			::= { extremeWingStatsDevWlClientStatEntry 6 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.4.2.25.5.1.1.7
		extremeWingStatsDevWlClientStatTxPkts OBJECT-TYPE
			SYNTAX Counter64
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"Number of packets of data transmitted from AP to client
				
				XPath: /extremeWing-stats/device[mac=key1]/wireless/client-stats[mac=key2]/tx_pkts"
			::= { extremeWingStatsDevWlClientStatEntry 7 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.4.2.25.5.1.1.8
		extremeWingStatsDevWlClientStatRxPkts OBJECT-TYPE
			SYNTAX Counter64
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"Number of packets of data received from client to AP
				
				XPath: /extremeWing-stats/device[mac=key1]/wireless/client-stats[mac=key2]/rx_pkts"
			::= { extremeWingStatsDevWlClientStatEntry 8 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.4.2.25.5.1.1.9
		extremeWingStatsDevWlClientStatTxDropped OBJECT-TYPE
			SYNTAX Counter64
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"Number of packets of data dropped on transmission
				
				XPath: /extremeWing-stats/device[mac=key1]/wireless/client-stats[mac=key2]/tx_dropped"
			::= { extremeWingStatsDevWlClientStatEntry 9 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.4.2.25.5.1.1.10
		extremeWingStatsDevWlClientStatRxErrors OBJECT-TYPE
			SYNTAX Counter64
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"Number of packets of data received with errors
				
				XPath: /extremeWing-stats/device[mac=key1]/wireless/client-stats[mac=key2]/rx_errors"
			::= { extremeWingStatsDevWlClientStatEntry 10 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.4.2.25.5.1.1.11
		extremeWingStatsDevWlClientStatTIndex OBJECT-TYPE
			SYNTAX Integer32
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"Traffic Utilization Index
				
				Measures the efficiency the medium under consideration
				is used. It is the percentage of the current data throughput
				over the theoretical data rate limit, which is derived
				the current maximum physical rate configured over the medium
				based on past empirical data. This index could assist end user
				in site planning and expansion. The numerical value might be
				further classified as:
				  -1: no data available ( e.g. radio is not in wlan operation
				                          mode )
				  0-20 : very low utilization
				  20-40: low utilization
				  40-60: moderate utilization
				  60 and above: high utilization
				
				XPath: /extremeWing-stats/device[mac=key1]/wireless/client-stats[mac=key2]/t_index"
			::= { extremeWingStatsDevWlClientStatEntry 11 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.4.2.25.5.1.1.12
		extremeWingStatsDevWlClientStatTxBps OBJECT-TYPE
			SYNTAX Unsigned32
			UNITS "kbps"
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"User data transmit rate
				
				XPath: /extremeWing-stats/device[mac=key1]/wireless/client-stats[mac=key2]/tx_bps"
			::= { extremeWingStatsDevWlClientStatEntry 12 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.4.2.25.5.1.1.13
		extremeWingStatsDevWlClientStatRxBps OBJECT-TYPE
			SYNTAX Unsigned32
			UNITS "kbps"
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"User data receive rate
				
				XPath: /extremeWing-stats/device[mac=key1]/wireless/client-stats[mac=key2]/rx_bps"
			::= { extremeWingStatsDevWlClientStatEntry 13 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.4.2.25.5.1.1.14
		extremeWingStatsDevWlClientStatSignal OBJECT-TYPE
			SYNTAX Integer32
			UNITS "dbm"
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"Signal strength
				
				XPath: /extremeWing-stats/device[mac=key1]/wireless/client-stats[mac=key2]/signal"
			::= { extremeWingStatsDevWlClientStatEntry 14 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.4.2.25.5.1.1.15
		extremeWingStatsDevWlClientStatNoise OBJECT-TYPE
			SYNTAX Integer32
			UNITS "dbm"
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"Noise level in units of dbm
				
				XPath: /extremeWing-stats/device[mac=key1]/wireless/client-stats[mac=key2]/noise"
			::= { extremeWingStatsDevWlClientStatEntry 15 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.4.2.25.5.1.1.16
		extremeWingStatsDevWlClientStatSnr OBJECT-TYPE
			SYNTAX Integer32
			UNITS "db"
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"Signal to noise ratio in units of db
				
				XPath: /extremeWing-stats/device[mac=key1]/wireless/client-stats[mac=key2]/snr"
			::= { extremeWingStatsDevWlClientStatEntry 16 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.4.2.25.5.1.1.17
		extremeWingStatsDevWlClientStatTxRate OBJECT-TYPE
			SYNTAX Unsigned32
			UNITS "Mbps"
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"The effective phy-layer transmit rate
				
				XPath: /extremeWing-stats/device[mac=key1]/wireless/client-stats[mac=key2]/tx_rate"
			::= { extremeWingStatsDevWlClientStatEntry 17 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.4.2.25.5.1.1.18
		extremeWingStatsDevWlClientStatRxRate OBJECT-TYPE
			SYNTAX Unsigned32
			UNITS "Mbps"
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"The effective phy-layer receive rate
				
				XPath: /extremeWing-stats/device[mac=key1]/wireless/client-stats[mac=key2]/rx_rate"
			::= { extremeWingStatsDevWlClientStatEntry 18 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.4.2.25.5.1.1.19
		extremeWingStatsDevWlClientStatErrorRate OBJECT-TYPE
			SYNTAX Unsigned32
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"Ratio of errors to rx-packets in percentage
				
				XPath: /extremeWing-stats/device[mac=key1]/wireless/client-stats[mac=key2]/error_rate"
			::= { extremeWingStatsDevWlClientStatEntry 19 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.4.2.25.5.1.1.20
		extremeWingStatsDevWlClientStatQIndex OBJECT-TYPE
			SYNTAX Integer32
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"RF quality Index
				
				Measure the quality of the medium in percentage. It is a
				function of average retries and error rate. Its range is from
				0-100. Typically:
				  -1: no data available ( e.g. radio is not in wlan operation
				                          mode )
				  0-20: very poor quality
				  20-40: poor quality
				  40-60: average quality
				  60-100: good quality
				
				XPath: /extremeWing-stats/device[mac=key1]/wireless/client-stats[mac=key2]/q_index"
			::= { extremeWingStatsDevWlClientStatEntry 20 }

		
-- /extremeWing-stats/device/wireless/radio
		-- 1.3.6.1.4.1.1916.2.131.50.1.4.2.25.9
		extremeWingStatsDevWlRadio OBJECT IDENTIFIER ::= { extremeWingStatsDevWl 9 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.4.2.25.9.1
