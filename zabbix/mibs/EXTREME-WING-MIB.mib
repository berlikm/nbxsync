			SYNTAX Integer32
			UNITS "db"
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"Signal to noise ratio in units of db
				
				XPath: /extremeWing-stats/rf_domain[name=key1]/wireless/radio-stats-details[radio_id=key2]/snr"
			::= { extremeWingStatsRfdWlRadioStatDetailEntry 17 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.4.3.2.11.1.1.18
		extremeWingStatsRfdWlRadioStatDetailTxRate OBJECT-TYPE
			SYNTAX Unsigned32
			UNITS "Mbps"
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"The effective phy-layer transmit rate
				
				XPath: /extremeWing-stats/rf_domain[name=key1]/wireless/radio-stats-details[radio_id=key2]/tx_rate"
			::= { extremeWingStatsRfdWlRadioStatDetailEntry 18 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.4.3.2.11.1.1.19
		extremeWingStatsRfdWlRadioStatDetailRxRate OBJECT-TYPE
			SYNTAX Unsigned32
			UNITS "Mbps"
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"The effective phy-layer receive rate
				
				XPath: /extremeWing-stats/rf_domain[name=key1]/wireless/radio-stats-details[radio_id=key2]/rx_rate"
			::= { extremeWingStatsRfdWlRadioStatDetailEntry 19 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.4.3.2.11.1.1.20
		extremeWingStatsRfdWlRadioStatDetailErrorRate OBJECT-TYPE
			SYNTAX Unsigned32
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"Ratio of errors to rx-packets in percentage
				
				XPath: /extremeWing-stats/rf_domain[name=key1]/wireless/radio-stats-details[radio_id=key2]/error_rate"
			::= { extremeWingStatsRfdWlRadioStatDetailEntry 20 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.4.3.2.11.1.1.21
		extremeWingStatsRfdWlRadioStatDetailQIndex OBJECT-TYPE
			SYNTAX Integer32
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"RF quality Index
				
				Measure the quality of the medium in percentage. It is a
				function of average retries and error rate. Its range is from
				0-100. Typically:
				  -1: no data available ( e.g. radio is not in wlan operation
				                          mode )
				  0-20: very poor quality
				  20-40: poor quality
				  40-60: average quality
				  60-100: good quality
				
				XPath: /extremeWing-stats/rf_domain[name=key1]/wireless/radio-stats-details[radio_id=key2]/q_index"
			::= { extremeWingStatsRfdWlRadioStatDetailEntry 21 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.4.3.2.11.1.1.22
		extremeWingStatsRfdWlRadioStatDetailNumClients OBJECT-TYPE
			SYNTAX Unsigned32
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"Total number of clients
				
				XPath: /extremeWing-stats/rf_domain[name=key1]/wireless/radio-stats-details[radio_id=key2]/num_clients"
			::= { extremeWingStatsRfdWlRadioStatDetailEntry 22 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.4.3.2.11.1.1.23
		extremeWingStatsRfdWlRadioStatDetailNumBClients OBJECT-TYPE
			SYNTAX Unsigned32
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"Number of 11b clients
				
				XPath: /extremeWing-stats/rf_domain[name=key1]/wireless/radio-stats-details[radio_id=key2]/num_b_clients"
			::= { extremeWingStatsRfdWlRadioStatDetailEntry 23 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.4.3.2.11.1.1.24
		extremeWingStatsRfdWlRadioStatDetailNumBgClients OBJECT-TYPE
			SYNTAX Unsigned32
			MAX-ACCESS read-only
			STATUS current
