                        MAX-ACCESS not-accessible
                        STATUS current
                        DESCRIPTION
                                "Description."
                        ::= { extremeWingCfgDevSensor 1 }


                -- 1.3.6.1.4.1.1916.2.131.50.1.3.18.33.1.1
                extremeWingCfgDevEnvSensorEntry OBJECT-TYPE
                        SYNTAX ExtremeWingCfgDevEnvSensorEntry
                        MAX-ACCESS not-accessible
                        STATUS current
                        DESCRIPTION
                                "An entry in the table."
                        INDEX { extremeWingCfgDevMac }
                        ::= { extremeWingCfgDevEnvSensorTable 1 }


                ExtremeWingCfgDevEnvSensorEntry ::=
                        SEQUENCE {
                                extremeWingCfgDevEnvSensorHumidity
                                        TruthValue,
                                extremeWingCfgDevEnvSensorMotion
                                        TruthValue,
                                extremeWingCfgDevEnvSensorTemperature
                                        TruthValue
                         }

                -- 1.3.6.1.4.1.1916.2.131.50.1.3.18.33.1.1.1
                extremeWingCfgDevEnvSensorHumidity OBJECT-TYPE
                        SYNTAX TruthValue
                        MAX-ACCESS read-write
                        STATUS current
                        DESCRIPTION
                                "Enable (turn on) the humidity sensor.

                                XPath: /extremeWing-config/device[mac=key1]/environmental_sensor/humidity"
                        DEFVAL { true }
                        ::= { extremeWingCfgDevEnvSensorEntry 1 }


                -- 1.3.6.1.4.1.1916.2.131.50.1.3.18.33.1.1.2
                extremeWingCfgDevEnvSensorMotion OBJECT-TYPE
                        SYNTAX TruthValue
                        MAX-ACCESS read-write
                        STATUS current
                        DESCRIPTION
