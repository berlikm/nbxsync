			SYNTAX Counter64
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"Number of packets of data transmitted from AP to client
				
				XPath: /extremeWing-stats/rf_domain[name=key1]/wireless/client-stats[mac=key2]/tx_pkts"
			::= { extremeWingStatsRfdWlClientStatEntry 7 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.4.3.2.5.1.1.8
