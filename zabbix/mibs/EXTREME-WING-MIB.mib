				2.4GHz-wlan
				5GHz-wlan
				sensor
				
				XPath: /extremeWing-config/ap300[mac=key1]/interface[name=key2]/rf_mode"
			::= { extremeWingCfgLegacyApIfEntry 5 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.33.2.1.6
		extremeWingCfgLegacyApIfAntennaDiversity OBJECT-TYPE
			SYNTAX TruthValue
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
