				XPath: /extremeWing-config/device[mac=key1]/meshpoint_device[name=key2]/preferred_neighbor"
			::= { extremeWingCfgDevMeshpointDevEntry 5 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.18.31.1.1.6
		extremeWingCfgDevMeshpointDevPreferredIf OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Preferred interface
				
				Values:
				none,
				2.4GHz,
				5GHz
				
				XPath: /extremeWing-config/device[mac=key1]/meshpoint_device[name=key2]/preferred_interface"
			DEFVAL { "none" }
			::= { extremeWingCfgDevMeshpointDevEntry 6 }

		-- 1.3.6.1.4.1.1916.2.131.50.1.3.18.31.1.1.7
		extremeWingCfgDevMeshpointDevMonitorCriticalResources OBJECT-TYPE
			SYNTAX TruthValue
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"
				
				XPath: /extremeWing-config/device[mac=key1]/meshpoint_device[name=key2]/monitor_critical_resources"
			DEFVAL { false }
			::= { extremeWingCfgDevMeshpointDevEntry 7 }

		-- 1.3.6.1.4.1.1916.2.131.50.1.3.18.31.1.1.8
		extremeWingCfgDevMeshpointDevMonitorPriPortLink OBJECT-TYPE
			SYNTAX TruthValue
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"
				
				XPath: /extremeWing-config/device[mac=key1]/meshpoint_device[name=key2]/monitor_pri_port_link"
			DEFVAL { false }
			::= { extremeWingCfgDevMeshpointDevEntry 8 }


		-- 1.3.6.1.4.1.1916.2.131.50.1.3.18.31.1.1.9
		extremeWingCfgDevMeshpointDevPathMethod OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Path selection method for determining the root path
				none,
				uniform,
				mobile-snr-leaf,
				pcr-weighted,
				snr-leaf.
				XPath: /extremeWing-config/device[mac=key1]/meshpoint_device[name=key2]/path_method
				"
			DEFVAL { "none" }
			::= { extremeWingCfgDevMeshpointDevEntry 9 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.18.31.1.1.10
		extremeWingCfgDevMeshpointDevHysteresisPeriod OBJECT-TYPE
			SYNTAX Unsigned32 (0..600)
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Path method hysteresis of candidate must be sustained for period of time
				XPath: /extremeWing-config/device[mac=key1]/meshpoint_device[name=key2]/hysteresis_period"
			DEFVAL { 1 }
			::= { extremeWingCfgDevMeshpointDevEntry 10 }


		-- 1.3.6.1.4.1.1916.2.131.50.1.3.18.31.1.1.11
		extremeWingCfgDevMeshpointDevHysteresisSnrDelta OBJECT-TYPE
			SYNTAX Unsigned32 (0..100)
			UNITS "db"
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Path method hysteresis SNR of candidate must have dB level better than current
				XPath: /extremeWing-config/device[mac=key1]/meshpoint_device[name=key2]/hysteresis_snr_delta
				"
			DEFVAL { 1 }
			::= { extremeWingCfgDevMeshpointDevEntry 11 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.18.31.1.1.12
		extremeWingCfgDevMeshpointDevHysteresisSnrMin OBJECT-TYPE
			SYNTAX Integer32 (-100..0)
			UNITS "db"
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Path method hysteresis SNR of candidate must be above minimum threshold
				XPath: /extremeWing-config/device[mac=key1]/meshpoint_device[name=key2]/hysteresis_snr_min
				"
			DEFVAL { 0 }
			::= { extremeWingCfgDevMeshpointDevEntry 12 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.18.31.1.1.13
		extremeWingCfgDevMeshpointDevExcludeWiredPeer OBJECT-TYPE
			SYNTAX TruthValue
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Excluded a mesh link from forming with a mesh device that is a wired peer
				XPath: /extremeWing-config/device[mac=key1]/meshpoint_device[name=key2]/exclude_wired_peer
				"
			DEFVAL { false }
			::= { extremeWingCfgDevMeshpointDevEntry 13 }


		-- 1.3.6.1.4.1.1916.2.131.50.1.3.18.31.1.1.14
		extremeWingCfgDevMeshpointDevHysteresisRootSelSnrDelta OBJECT-TYPE
			SYNTAX Unsigned32 (1..100)
			UNITS "dB"
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Root selection method hysteresis SNR delta range that a candidate must sustain
				
				XPATH: /extremeWing-config/device[mac=key1]/meshpoint_device[name=key2]/hysteresis_root_sel_snr_delta"
			DEFVAL { 1 }
			::= { extremeWingCfgDevMeshpointDevEntry 14 }


		-- 1.3.6.1.4.1.1916.2.131.50.1.3.18.31.1.1.15
		extremeWingCfgDevMeshpointDevRootSelectMethod OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Root selection method for determining whether the meshpoint is a root or non-root
				
				none
				auto-mint
				
				XPATH: /extremeWing-config/device[mac=key1]/meshpoint_device[name=key2]/root_select_method"
			DEFVAL { "none" }
			::= { extremeWingCfgDevMeshpointDevEntry 15 }


		-- 1.3.6.1.4.1.1916.2.131.50.1.3.18.31.1.1.16
		extremeWingCfgDevMeshpointDevRootSelectCostRoot OBJECT-TYPE
			SYNTAX TruthValue
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Set as cost root for meshpoint root selection
				
				XPATH: /extremeWing-config/device[mac=key1]/meshpoint_device[name=key2]/root_select_cost_root"
			DEFVAL { false }
			::= { extremeWingCfgDevMeshpointDevEntry 16 }



-- /extremeWing-config/device/gre
                -- 1.3.6.1.4.1.1916.2.131.50.1.3.18.32
                extremeWingCfgDevGre OBJECT IDENTIFIER ::= { extremeWingCfgDev 32 }


-- /extremeWing-config/device/gre_tunnel
                -- 1.3.6.1.4.1.1916.2.131.50.1.3.18.32.1
                extremeWingCfgDevGreTunnelTable OBJECT-TYPE
                        SYNTAX SEQUENCE OF ExtremeWingCfgDevGreTunnelEntry
                        MAX-ACCESS not-accessible
                        STATUS current
                        DESCRIPTION
                                "/extremeWing-config/device/l2tpv3_tunnel"
                        ::= { extremeWingCfgDevGre 1 }


                -- 1.3.6.1.4.1.1916.2.131.50.1.3.18.32.1.1
                extremeWingCfgDevGreTunnelEntry OBJECT-TYPE
                        SYNTAX ExtremeWingCfgDevGreTunnelEntry
                        MAX-ACCESS not-accessible
                        STATUS current
                        DESCRIPTION
                                "An entry in the table."
                        INDEX { extremeWingCfgDevMac, extremeWingCfgDevGreTunnelName }
                        ::= { extremeWingCfgDevGreTunnelTable 1 }


                ExtremeWingCfgDevGreTunnelEntry ::=
                        SEQUENCE {
                                extremeWingCfgDevGreTunnelName
                                        ExtremeWingIdentifier,
                                extremeWingCfgGreTunnelVlan
                                        DisplayString,
                                extremeWingCfgDevGreNativeTag
                                        Integer32,
                                extremeWingCfgDevGreNativeVlan
                                        Integer32,
                                extremeWingCfgDevGreDscpOutPkt
                                        Integer32,
                                extremeWingCfgDevGreDscpInPkt
                                        Integer32,
                                extremeWingCfgDevGreFailoverPingIntv
                                        Integer32,
                                extremeWingCfgDevGreFailoverRetries
                                        Integer32
                         }

                -- 1.3.6.1.4.1.1916.2.131.50.1.3.18.32.1.1.1
                extremeWingCfgDevGreTunnelName OBJECT-TYPE
                        SYNTAX ExtremeWingIdentifier (SIZE (1..32))
                        MAX-ACCESS read-only
                        STATUS current
                        DESCRIPTION
                                "tunnel name.

                                XPath: /extremeWing-config/device[mac=key1]/gre_tunnel[name=key2]/name"
                        ::= { extremeWingCfgDevGreTunnelEntry 1 }


                -- 1.3.6.1.4.1.1916.2.131.50.1.3.18.32.1.1.4
                extremeWingCfgGreTunnelVlan OBJECT-TYPE
                        SYNTAX DisplayString
                        MAX-ACCESS read-write
                        STATUS current
                        DESCRIPTION
                                "VLAN extended over GRE tunnel.

                                XPath: /extremeWing-config/device[mac=key1]/gre_tunnel[name=key2]/tunneled_vlan"
                        ::= { extremeWingCfgDevGreTunnelEntry 4 }


                -- 1.3.6.1.4.1.1916.2.131.50.1.3.18.32.1.1.5
                extremeWingCfgDevGreNativeTag OBJECT-TYPE
                        SYNTAX Integer32
                        MAX-ACCESS read-write
                        STATUS current
                        DESCRIPTION
                                "Tag the native vlan.

                                XPath: /extremeWing-config/device[mac=key1]/gre_tunnel[name=key2]/native_tagged"
                        ::= { extremeWingCfgDevGreTunnelEntry 5 }


                -- 1.3.6.1.4.1.1916.2.131.50.1.3.18.32.1.1.6
                extremeWingCfgDevGreNativeVlan OBJECT-TYPE
                        SYNTAX Integer32 (1..4095)
                        MAX-ACCESS read-write
                        STATUS current
                        DESCRIPTION
                                "Native VLAN for classifying untagged traffic.

                                XPath: /extremeWing-config/device[mac=key1]/gre_tunnel[name=key2]/native_vlan"
                        ::= { extremeWingCfgDevGreTunnelEntry 6 }


                -- 1.3.6.1.4.1.1916.2.131.50.1.3.18.32.1.1.7
                extremeWingCfgDevGreDscpOutPkt OBJECT-TYPE
                        SYNTAX Integer32 (0..63)
                        MAX-ACCESS read-write
                        STATUS current
                        DESCRIPTION
                                "DSCP to set for outer packet
                                XPath: /extremeWing-config/device[mac=key1]/gre_tunnel[name=key2]/dscp/code_point"
                        ::= { extremeWingCfgDevGreTunnelEntry 7 }


                -- 1.3.6.1.4.1.1916.2.131.50.1.3.18.32.1.1.8
                extremeWingCfgDevGreDscpInPkt OBJECT-TYPE
                        SYNTAX Integer32
                        MAX-ACCESS read-write
                        STATUS current
                        DESCRIPTION
                                "Copy DSCP value from inner packet
                                XPath: /extremeWing-config/device[mac=key1]/gre_tunnel[name=key2]/dscp/reflect"
                        ::= { extremeWingCfgDevGreTunnelEntry 8 }


                -- 1.3.6.1.4.1.1916.2.131.50.1.3.18.32.1.1.9
                extremeWingCfgDevGreFailoverPingIntv OBJECT-TYPE
                        SYNTAX Integer32 (0..86400)
                        MAX-ACCESS read-write
                        STATUS current
                        DESCRIPTION
                                "ping interval in seconds

                                XPath: /extremeWing-config/device[mac=key1]/gre_tunnel[name=key2]/failover/interval"
                        ::= { extremeWingCfgDevGreTunnelEntry 9 }


                -- 1.3.6.1.4.1.1916.2.131.50.1.3.18.32.1.1.10
                extremeWingCfgDevGreFailoverRetries OBJECT-TYPE
                        SYNTAX Integer32 (0..63)
                        MAX-ACCESS read-write
                        STATUS current
                        DESCRIPTION
                                "Number of retrys in case no ping response received

                                XPath: /extremeWing-config/device[mac=key1]/gre_tunnel[name=key2]/failover/retry"
                        ::= { extremeWingCfgDevGreTunnelEntry 10 }


-- /extremeWing-config/device/l2tpv3_tunnel/peer
                -- 1.3.6.1.4.1.1916.2.131.50.1.3.18.32.2
                extremeWingCfgDevGreTunnelPeerTable OBJECT-TYPE
                        SYNTAX SEQUENCE OF ExtremeWingCfgDevGreTunnelPeerEntry
                        MAX-ACCESS not-accessible
                        STATUS current
                        DESCRIPTION
                                "/extremeWing-config/device/gre_tunnel/peer_ip"
                        ::= { extremeWingCfgDevGre 2 }


                -- 1.3.6.1.4.1.1916.2.131.50.1.3.18.32.2.1
                extremeWingCfgDevGreTunnelPeerEntry OBJECT-TYPE
                        SYNTAX ExtremeWingCfgDevGreTunnelPeerEntry
                        MAX-ACCESS not-accessible
                        STATUS current
                        DESCRIPTION
                                "An entry in the table."
                        INDEX { extremeWingCfgDevMac, extremeWingCfgDevGreTunnelName, extremeWingCfgDevGreTunnelPeerId }
                        ::= { extremeWingCfgDevGreTunnelPeerTable 1 }


                ExtremeWingCfgDevGreTunnelPeerEntry ::=
                        SEQUENCE {
                                extremeWingCfgDevGreTunnelPeerId
                                        INTEGER,
                                extremeWingCfgDevGreTunnelPeerIp
                                        DisplayString
                         }

                -- 1.3.6.1.4.1.1916.2.131.50.1.3.18.32.2.1.1
                extremeWingCfgDevGreTunnelPeerId OBJECT-TYPE
                        SYNTAX INTEGER
                                {
                                primary(1),
                                secondary(2)
                                }
                        MAX-ACCESS read-only
                        STATUS current
                        DESCRIPTION
                                "Primary peer to establish the tunnel and secondary peer for failover.

                                XPath: /extremeWing-config/device[mac=key1]/gre_tunnel[name=key2]/peer_ip[peer_idx=key3]/peer_idx"
                        ::= { extremeWingCfgDevGreTunnelPeerEntry 1 }


                -- 1.3.6.1.4.1.1916.2.131.50.1.3.18.32.2.1.3
                extremeWingCfgDevGreTunnelPeerIp OBJECT-TYPE
                        SYNTAX DisplayString
                        MAX-ACCESS read-write
                        STATUS current
                        DESCRIPTION
                                "IP address of peer.

                                XPath: /extremeWing-config/device[mac=key1]/gre_tunnel[name=key2]/peer_ip[peer_idx=key3]/ip"
                        ::= { extremeWingCfgDevGreTunnelPeerEntry 3 }


