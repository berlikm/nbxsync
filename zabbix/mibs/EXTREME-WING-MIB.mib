					Unsigned32,
				extremeWingCfgWlanClientLoadBalProbeReqIntvl5ghz
					Unsigned32,
				extremeWingCfgWlanClientLoadBalProbeReqIntvl24ghz
					Unsigned32,
				extremeWingCfgWlanClientLoadBalBandDiscoveryIntvl
					Unsigned32,
				extremeWingCfgWlanClientLoadBalCapabilityAgeoutTime
					Unsigned32,
