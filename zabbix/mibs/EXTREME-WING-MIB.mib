-- /extremeWing-config/profile/envirvironmental_sensor
                -- 1.3.6.1.4.1.1916.2.131.50.1.3.16.27.1
                extremeWingCfgProfEnvSensorTable OBJECT-TYPE
                        SYNTAX SEQUENCE OF ExtremeWingCfgProfEnvSensorEntry
                        MAX-ACCESS not-accessible
                        STATUS current
                        DESCRIPTION
                                "Description."
                        ::= { extremeWingCfgProfSensor 1 }


                -- 1.3.6.1.4.1.1916.2.131.50.1.3.16.27.1.1
                extremeWingCfgProfEnvSensorEntry OBJECT-TYPE
                        SYNTAX ExtremeWingCfgProfEnvSensorEntry
                        MAX-ACCESS not-accessible
                        STATUS current
                        DESCRIPTION
                                "An entry in the table."
                        INDEX { extremeWingCfgProfName }
                        ::= { extremeWingCfgProfEnvSensorTable 1 }


                ExtremeWingCfgProfEnvSensorEntry ::=
                        SEQUENCE {
                                extremeWingCfgProfEnvSensorHumidity
                                        TruthValue,
                                extremeWingCfgProfEnvSensorMotion
                                        TruthValue,
                                extremeWingCfgProfEnvSensorTemperature
                                        TruthValue
                         }

                -- 1.3.6.1.4.1.1916.2.131.50.1.3.16.27.1.1.1
                extremeWingCfgProfEnvSensorHumidity OBJECT-TYPE
                        SYNTAX TruthValue
                        MAX-ACCESS read-write
                        STATUS current
                        DESCRIPTION
                                "Enable (turn on) the humidity sensor.

                                XPath: /extremeWing-config/profile[name=key1]/environmental_sensor/humidity"
                        DEFVAL { true }
                        ::= { extremeWingCfgProfEnvSensorEntry 1 }


                -- 1.3.6.1.4.1.1916.2.131.50.1.3.16.27.1.1.2
                extremeWingCfgProfEnvSensorMotion OBJECT-TYPE
                        SYNTAX TruthValue
                        MAX-ACCESS read-write
                        STATUS current
                        DESCRIPTION
                                "Enable (turn on) the motion sensor.

                                XPath: /extremeWing-config/profile[name=key1]/environmental_sensor/motion"
                        DEFVAL { true }
                        ::= { extremeWingCfgProfEnvSensorEntry 2 }


                -- 1.3.6.1.4.1.1916.2.131.50.1.3.16.27.1.1.3
                extremeWingCfgProfEnvSensorTemperature OBJECT-TYPE
                        SYNTAX TruthValue
                        MAX-ACCESS read-write
                        STATUS current
                        DESCRIPTION
                                "Enable (turn on) the temperature sensor.

                                XPath: /extremeWing-config/profile[name=key1]/environmental_sensor/temperature"
                        DEFVAL { true }
                        ::= { extremeWingCfgProfEnvSensorEntry 3 }


-- /extremeWing-config/profile/environmental_sensor
                -- 1.3.6.1.4.1.1916.2.131.50.1.3.16.27.2
                extremeWingCfgProfLightSensorTable OBJECT-TYPE
                        SYNTAX SEQUENCE OF ExtremeWingCfgProfLightSensorEntry
                        MAX-ACCESS not-accessible
                        STATUS current
                        DESCRIPTION
                                "Description."
                        ::= { extremeWingCfgProfSensor 2 }


                -- 1.3.6.1.4.1.1916.2.131.50.1.3.16.27.2.1
                extremeWingCfgProfLightSensorEntry OBJECT-TYPE
                        SYNTAX ExtremeWingCfgProfLightSensorEntry
                        MAX-ACCESS not-accessible
                        STATUS current
                        DESCRIPTION
                                "An entry in the table."
                        INDEX { extremeWingCfgProfName }
                        ::= { extremeWingCfgProfLightSensorTable 1 }


                ExtremeWingCfgProfLightSensorEntry ::=
                        SEQUENCE {
                                extremeWingCfgProfLightSensor
                                        TruthValue,
                                extremeWingCfgProfLightSensorHoldTime
                                        Integer32,
                                extremeWingCfgProfLightSensorThresholdRadioShutdown
                                        DisplayString,
                                extremeWingCfgProfLightSensorLowLimitThreshold
                                        Integer32,
                                extremeWingCfgProfLightSensorHighLimitThreshold
                                        Integer32
                         }

                -- 1.3.6.1.4.1.1916.2.131.50.1.3.16.27.2.1.1
                extremeWingCfgProfLightSensor OBJECT-TYPE
                        SYNTAX TruthValue
                        UNITS "true"
                        MAX-ACCESS read-write
                        STATUS current
                        DESCRIPTION
                                "Enable (turn on) the light sensor..

                                XPath: /extremeWing-config/profile[name=key1]/environmental_sensor/light"
                        ::= { extremeWingCfgProfLightSensorEntry 1 }


                -- 1.3.6.1.4.1.1916.2.131.50.1.3.16.27.2.1.2
                extremeWingCfgProfLightSensorHoldTime OBJECT-TYPE
                        SYNTAX Integer32 (2..201)
                        UNITS "seconds"
                        MAX-ACCESS read-write
                        STATUS current
                        DESCRIPTION
                                "The interval of time (in seconds) during which the light sensor polls the environment for light intensity to determine whehter the light is on or off.

                                XPath: /extremeWing-config/profile[name=key1]/environmental_sensor/light_holdtime"
                        ::= { extremeWingCfgProfLightSensorEntry 2 }


                -- 1.3.6.1.4.1.1916.2.131.50.1.3.16.27.2.1.3
                extremeWingCfgProfLightSensorThresholdRadioShutdown OBJECT-TYPE
                        SYNTAX DisplayString
                        MAX-ACCESS read-write
                        STATUS current
                        DESCRIPTION
                                "Shutdown the AP radio(s) when the light intensity drops below the lower limit -- signifying that the light is off and the facility is unoccupied..

                                enum all,
                                enum radio-1,
                                enum radio-2


                                XPath: /extremeWing-config/profile[name=key1]/environmental_sensor/light_radio_shutdown"
                        DEFVAL { "none" }
                        ::= { extremeWingCfgProfLightSensorEntry 3 }


                -- 1.3.6.1.4.1.1916.2.131.50.1.3.16.27.2.1.4
                extremeWingCfgProfLightSensorLowLimitThreshold OBJECT-TYPE
                        SYNTAX Integer32 (0..1000)
                        UNITS "lux"
                        MAX-ACCESS read-write
                        STATUS current
                        DESCRIPTION
                                "The lower limit (in lux) at which the light sensor determines the lighting is off.


                                XPath: /extremeWing-config/profile[name=key1]/environmental_sensor/light_threshold_low"
                        ::= { extremeWingCfgProfLightSensorEntry 4 }


                -- 1.3.6.1.4.1.1916.2.131.50.1.3.16.27.2.1.5
                extremeWingCfgProfLightSensorHighLimitThreshold OBJECT-TYPE
                        SYNTAX Integer32 (100..10000)
                        UNITS "lux"
                        MAX-ACCESS read-write
                        STATUS current
                        DESCRIPTION
                                "The upper limit (in lux) at which the light sensor determines the lighting is on.

                                XPath: /extremeWing-config/profile[name=key1]/environmental_sensor/light_threshold_high"
                        ::= { extremeWingCfgProfLightSensorEntry 5 }


-- /extremeWing-config/profile/environmental_sensor
