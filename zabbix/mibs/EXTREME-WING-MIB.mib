				XPath: /extremeWing-config/profile[name=key1]/interface[name=key2]/ospf_auth_key"
			::= { extremeWingCfgProfIfVlanOspfEntry 2 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.16.2.13.1.3
