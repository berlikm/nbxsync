-- /extremeWing-config/profile/controller_host
                -- 1.3.6.1.4.1.1916.2.131.50.1.3.16.19
                extremeWingCfgProfControllerHost OBJECT IDENTIFIER ::= { extremeWingCfgProf 19 }


                -- 1.3.6.1.4.1.1916.2.131.50.1.3.16.19.1
                extremeWingCfgProfControllerHostTable OBJECT-TYPE
                        SYNTAX SEQUENCE OF ExtremeWingCfgProfControllerHostEntry
                        MAX-ACCESS not-accessible
                        STATUS current
                        DESCRIPTION
                                "WLAN controller configuration

                                /extremeWing-config/profile/controller_host"
                        ::= { extremeWingCfgProfControllerHost 1 }


                -- 1.3.6.1.4.1.1916.2.131.50.1.3.16.19.1.1
                extremeWingCfgProfControllerHostEntry OBJECT-TYPE
                        SYNTAX ExtremeWingCfgProfControllerHostEntry
                        MAX-ACCESS not-accessible
                        STATUS current
                        DESCRIPTION
                                "An entry in the table."
                        INDEX { extremeWingCfgProfName, extremeWingCfgProfControllerHostHost, extremeWingCfgProfControllerHostPool, extremeWingCfgProfControllerHostLevel }
                        ::= { extremeWingCfgProfControllerHostTable 1 }


                ExtremeWingCfgProfControllerHostEntry ::=
                        SEQUENCE {
                                extremeWingCfgProfControllerHostHost
                                        DisplayString,
                                extremeWingCfgProfControllerHostPool
                                        Unsigned32,
                                extremeWingCfgProfControllerHostLevel
                                        Unsigned32,
                                extremeWingCfgProfControllerHostRowStatus
                                        RowStatus,
                                extremeWingCfgProfControllerHostForce
                                        TruthValue,
                                extremeWingCfgProfControllerHostRemoteVpnClient
                                        TruthValue,
                                extremeWingCfgProfControllerHostIPSecSecure
                                        TruthValue,
                                extremeWingCfgProfControllerHostIPSecGw
                                        IpAddress
                         }

                -- 1.3.6.1.4.1.1916.2.131.50.1.3.16.19.1.1.1
                extremeWingCfgProfControllerHostHost OBJECT-TYPE
                        SYNTAX DisplayString
                        MAX-ACCESS read-only
                        STATUS current
                        DESCRIPTION
                                "IP address or hostname of controller.

                                As this object is indirectly part of the key,
                                to change its value the row must be deleted and created with
                                the new key.

                                XPath: /extremeWing-config/profile[name=key1]/controller_host[host=key2,pool=key3,level=key4]/host"
                        ::= { extremeWingCfgProfControllerHostEntry 1 }


                -- 1.3.6.1.4.1.1916.2.131.50.1.3.16.19.1.1.2
                extremeWingCfgProfControllerHostPool OBJECT-TYPE
                        SYNTAX Unsigned32 (1..2)
                        MAX-ACCESS read-only
                        STATUS current
                        DESCRIPTION
                                "Pool this controller belongs to.

                                As this object is indirectly part of the key,
                                to change its value the row must be deleted and created with
                                the new key.

                                XPath: /extremeWing-config/profile[name=key1]/controller_host[host=key2,pool=key3,level=key4]/pool"
                        ::= { extremeWingCfgProfControllerHostEntry 2 }


                -- 1.3.6.1.4.1.1916.2.131.50.1.3.16.19.1.1.3
                extremeWingCfgProfControllerHostLevel OBJECT-TYPE
                        SYNTAX Unsigned32 (1..2)
                        MAX-ACCESS read-only
                        STATUS current
                        DESCRIPTION
                                "Routing level for controller link.

                                As this object is indirectly part of the key,
                                to change its value the row must be deleted and created with
                                the new key.

                                Values:
                                1  Level 1 (local)
                                2  Level 2 (inter-site)

                                XPath: /extremeWing-config/profile[name=key1]/controller_host[host=key2,pool=key3,level=key4]/level"
                        ::= { extremeWingCfgProfControllerHostEntry 3 }


                -- 1.3.6.1.4.1.1916.2.131.50.1.3.16.19.1.1.4
                extremeWingCfgProfControllerHostRowStatus OBJECT-TYPE
                        SYNTAX RowStatus
                                {
                                active(1),
                                createAndGo(4),
                                destroy(6)
                                }
                        MAX-ACCESS read-write
                        STATUS current
                        DESCRIPTION
                                "The status of this conceptual row.

                                XPath: /extremeWing-config/profile[name=key1]/controller_host[host=key2,pool=key3,level=key4]/row_status"
                        ::= { extremeWingCfgProfControllerHostEntry 4 }


                -- 1.3.6.1.4.1.1916.2.131.50.1.3.16.19.1.1.5
                extremeWingCfgProfControllerHostForce OBJECT-TYPE
                        SYNTAX TruthValue
                        MAX-ACCESS read-write
                        STATUS current
                        DESCRIPTION
                                "Force link to be created even when unnecessary.

                                XPath: /extremeWing-config/profile[name=key1]/controller_host[host=key2,pool=key3,level=key4]/force"
                        DEFVAL { false }
                        ::= { extremeWingCfgProfControllerHostEntry 5 }


                -- 1.3.6.1.4.1.1916.2.131.50.1.3.16.19.1.1.6
                extremeWingCfgProfControllerHostRemoteVpnClient OBJECT-TYPE
                        SYNTAX TruthValue
                        MAX-ACCESS read-write
                        STATUS current
                        DESCRIPTION
                                "Secure controller link using remote vpn connection.

                                XPath: /extremeWing-config/profile[name=key1]/controller_host[host=key2,pool=key3,level=key4]/remote_vpn_client"
                        DEFVAL { false }
                        ::= { extremeWingCfgProfControllerHostEntry 6 }


                -- 1.3.6.1.4.1.1916.2.131.50.1.3.16.19.1.1.7
                extremeWingCfgProfControllerHostIPSecSecure OBJECT-TYPE
                        SYNTAX TruthValue
                        MAX-ACCESS read-write
                        STATUS current
                        DESCRIPTION
                                "IPSec secure controller link.

                                XPath: /extremeWing-config/profile[name=key1]/controller_host[host=key2,pool=key3,level=key4]/ipsec_secure"
                        DEFVAL { false }
                        ::= { extremeWingCfgProfControllerHostEntry 7 }


                -- 1.3.6.1.4.1.1916.2.131.50.1.3.16.19.1.1.8
                extremeWingCfgProfControllerHostIPSecGw OBJECT-TYPE
                        SYNTAX IpAddress
                        MAX-ACCESS read-write
                        STATUS current
                        DESCRIPTION
                                "IP address or hostname of controller.

                                XPath: /extremeWing-config/profile[name=key1]/controller_host[host=key2,pool=key3,level=key4]/ipsec_gw"
                        ::= { extremeWingCfgProfControllerHostEntry 8 }
		
