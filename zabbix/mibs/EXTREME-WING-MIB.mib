		extremeWingCfgAutoProvisionPolicyRulePrecedence OBJECT-TYPE
			SYNTAX Unsigned32 (1..10000)
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"The precedence number for the Provisioning Policy Entry.
				1 is the highest precedence rule and 10000 is the lowest precedence rule.
				XPATH: /extremeWing-config/auto_provisioning_policy[name=key1]/rule[precedence=key2]/precedence"
			::= { extremeWingCfgAutoProvisionPolicyRuleEntry 1 }

		
