-- /extremeWing-config/profile
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.16.18
		extremeWingCfgProfVpn OBJECT IDENTIFIER ::= { extremeWingCfgProf 18 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.16.18.1
		extremeWingCfgProfVpnTable OBJECT-TYPE
			SYNTAX SEQUENCE OF ExtremeWingCfgProfVpnEntry
			MAX-ACCESS not-accessible
			STATUS current
			DESCRIPTION
				"
				
				/extremeWing-config/profile"
			::= { extremeWingCfgProfVpn 1 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.16.18.1.1
		extremeWingCfgProfVpnEntry OBJECT-TYPE
			SYNTAX ExtremeWingCfgProfVpnEntry
			MAX-ACCESS not-accessible
			STATUS current
			DESCRIPTION
				"An entry in the table."
			INDEX { extremeWingCfgProfName }
			::= { extremeWingCfgProfVpnTable 1 }

		
		ExtremeWingCfgProfVpnEntry ::=
			SEQUENCE { 
				extremeWingCfgProfVpnLifetimeSeconds
					Unsigned32,
				extremeWingCfgProfVpnLifetimeKb
					Unsigned32,
				extremeWingCfgProfVpnIkev1GlobalDpdKeepalive
					Unsigned32,
				extremeWingCfgProfVpnIkev1GlobalDpdRetries
					Unsigned32,
				extremeWingCfgProfVpnIkev1GlobalNatKeepalive
					Unsigned32,
				extremeWingCfgProfVpnIkev2GlobalDpdKeepalive
					Unsigned32,
				extremeWingCfgProfVpnIkev2GlobalDpdRetries
					Unsigned32,
				extremeWingCfgProfVpnIkev2GlobalNatKeepalive
					Unsigned32,
				extremeWingCfgProfVpnCookieChallengeThreshold
					Unsigned32,
				extremeWingCfgProfVpnMaxInNegotiationSa
					Unsigned32,
				extremeWingCfgProfVpnDfBit
					DisplayString
			 }

		-- 1.3.6.1.4.1.1916.2.131.50.1.3.16.18.1.1.1
		extremeWingCfgProfVpnLifetimeSeconds OBJECT-TYPE
			SYNTAX Unsigned32 (120..2147483646)
			UNITS "seconds"
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Time-based IPsec security association lifetime.
				
				XPath: /extremeWing-config/profile[name=key1]/lifetime_seconds"
			DEFVAL { 3600 }
			::= { extremeWingCfgProfVpnEntry 1 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.16.18.1.1.2
		extremeWingCfgProfVpnLifetimeKb OBJECT-TYPE
			SYNTAX Unsigned32 (500..2147483646)
			UNITS "kilobytes"
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Data-based IPsec security association lifetime.
				
				XPath: /extremeWing-config/profile[name=key1]/lifetime_kb"
			DEFVAL { 4608000 }
			::= { extremeWingCfgProfVpnEntry 2 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.16.18.1.1.3
		extremeWingCfgProfVpnIkev1GlobalDpdKeepalive OBJECT-TYPE
			SYNTAX Unsigned32 (10..3600)
			UNITS "seconds"
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Global setting for frequency of IKE keepalive messages for Dead Peer Detection.
				
				XPath: /extremeWing-config/profile[name=key1]/ikev1_dpd_keepalive"
