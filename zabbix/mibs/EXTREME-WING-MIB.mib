			SYNTAX SEQUENCE OF ExtremeWingCfgProfVpnTransformEntry
			MAX-ACCESS not-accessible
			STATUS current
			DESCRIPTION
				"
				
				/extremeWing-config/profile/ipsec_transform_set"
			::= { extremeWingCfgProfVpn 8 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.16.18.8.1
		extremeWingCfgProfVpnTransformEntry OBJECT-TYPE
			SYNTAX ExtremeWingCfgProfVpnTransformEntry
			MAX-ACCESS not-accessible
			STATUS current
			DESCRIPTION
				"An entry in the table."
			INDEX { extremeWingCfgProfName, extremeWingCfgProfVpnTransformName }
			::= { extremeWingCfgProfVpnTransformTable 1 }

		
		ExtremeWingCfgProfVpnTransformEntry ::=
			SEQUENCE { 
				extremeWingCfgProfVpnTransformName
					ExtremeWingIdentifier,
				extremeWingCfgProfVpnTransformCipherAlgo
					DisplayString,
				extremeWingCfgProfVpnTransformAuthAlgo
					DisplayString,
				extremeWingCfgProfVpnTransformMode
					DisplayString
			 }

		-- 1.3.6.1.4.1.1916.2.131.50.1.3.16.18.8.1.1
		extremeWingCfgProfVpnTransformName OBJECT-TYPE
			SYNTAX ExtremeWingIdentifier
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"
				
				XPath: /extremeWing-config/profile[name=key1]/ipsec_transform_set[name=key2]/name"
			::= { extremeWingCfgProfVpnTransformEntry 1 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.16.18.8.1.3
		extremeWingCfgProfVpnTransformCipherAlgo OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Encryption method protecting data transmission.
				
				Values:
				esp-null,
				des,
				3des,
				aes,
				aes-192,
				aes-256
				
				XPath: /extremeWing-config/profile[name=key1]/ipsec_transform_set[name=key2]/cipher_algo"
			DEFVAL { "aes-256" }
			::= { extremeWingCfgProfVpnTransformEntry 3 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.16.18.8.1.4
		extremeWingCfgProfVpnTransformAuthAlgo OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Authentication scheme used to validate identity.
				
				Values:
				md5-hmac,
				sha-hmac
				
				XPath: /extremeWing-config/profile[name=key1]/ipsec_transform_set[name=key2]/auth_algo"
			DEFVAL { "sha-hmac" }
			::= { extremeWingCfgProfVpnTransformEntry 4 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.16.18.8.1.5
		extremeWingCfgProfVpnTransformMode OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"IPsec tunnel type - tunnel mode is used for site-to-site vpn and transport mode is used to remote-vpn.
				
				Values:
				tunnel,
				transport
				
				XPath: /extremeWing-config/profile[name=key1]/ipsec_transform_set[name=key2]/mode"
			DEFVAL { "tunnel" }
			::= { extremeWingCfgProfVpnTransformEntry 5 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.16.18.9
		extremeWingCfgProfVpnCryptoTable OBJECT-TYPE
			SYNTAX SEQUENCE OF ExtremeWingCfgProfVpnCryptoEntry
			MAX-ACCESS not-accessible
			STATUS current
			DESCRIPTION
				"
				
				/extremeWing-config/profile/crypto_map"
			::= { extremeWingCfgProfVpn 9 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.16.18.9.1
		extremeWingCfgProfVpnCryptoEntry OBJECT-TYPE
			SYNTAX ExtremeWingCfgProfVpnCryptoEntry
			MAX-ACCESS not-accessible
			STATUS current
			DESCRIPTION
				"An entry in the table."
			INDEX { extremeWingCfgProfName, extremeWingCfgProfVpnCryptoName }
			::= { extremeWingCfgProfVpnCryptoTable 1 }

		
		ExtremeWingCfgProfVpnCryptoEntry ::=
			SEQUENCE { 
				extremeWingCfgProfVpnCryptoName
					ExtremeWingIdentifier
			 }

		-- 1.3.6.1.4.1.1916.2.131.50.1.3.16.18.9.1.1
		extremeWingCfgProfVpnCryptoName OBJECT-TYPE
			SYNTAX ExtremeWingIdentifier
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"
				
				XPath: /extremeWing-config/profile[name=key1]/crypto_map[name=key2]/name"
			::= { extremeWingCfgProfVpnCryptoEntry 1 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.16.18.10
		extremeWingCfgProfVpnCryptoInstTable OBJECT-TYPE
			SYNTAX SEQUENCE OF ExtremeWingCfgProfVpnCryptoInstEntry
			MAX-ACCESS not-accessible
			STATUS current
			DESCRIPTION
				"
				
				/extremeWing-config/profile/crypto_map/crypto_map_entry"
			::= { extremeWingCfgProfVpn 10 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.16.18.10.1
		extremeWingCfgProfVpnCryptoInstEntry OBJECT-TYPE
			SYNTAX ExtremeWingCfgProfVpnCryptoInstEntry
			MAX-ACCESS not-accessible
			STATUS current
			DESCRIPTION
				"An entry in the table."
			INDEX { extremeWingCfgProfName, extremeWingCfgProfVpnCryptoName, extremeWingCfgProfVpnCryptoInstSequence }
			::= { extremeWingCfgProfVpnCryptoInstTable 1 }

		
		ExtremeWingCfgProfVpnCryptoInstEntry ::=
			SEQUENCE { 
				extremeWingCfgProfVpnCryptoInstSequence
					Unsigned32,
				extremeWingCfgProfVpnCryptoInstType
					DisplayString,
				extremeWingCfgProfVpnCryptoInstIpAcl
					ExtremeWingIdentifier,
				extremeWingCfgProfVpnCryptoInstTransformSet
					ExtremeWingIdentifier,
				extremeWingCfgProfVpnCryptoInstLocalip
					DisplayString,
				extremeWingCfgProfVpnCryptoInstPfs
					DisplayString,
				extremeWingCfgProfVpnCryptoInstLifetimeSeconds
					Unsigned32,
				extremeWingCfgProfVpnCryptoInstLifetimeKb
					Unsigned32,
				extremeWingCfgProfVpnCryptoInstRemoteType
					DisplayString,
				extremeWingCfgProfVpnCryptoInstModeconfig
					DisplayString,
				extremeWingCfgProfVpnCryptoInstPeer
					DisplayString,
				extremeWingCfgProfVpnCryptoInstProtocol
					DisplayString,
				extremeWingCfgProfVpnCryptoInstMode
					DisplayString
			 }

		-- 1.3.6.1.4.1.1916.2.131.50.1.3.16.18.10.1.1
		extremeWingCfgProfVpnCryptoInstSequence OBJECT-TYPE
			SYNTAX Unsigned32 (1..1000)
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"
				
				XPath: /extremeWing-config/profile[name=key1]/crypto_map[name=key2]/crypto_map_entry[sequence=key3]/sequence"
			::= { extremeWingCfgProfVpnCryptoInstEntry 1 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.16.18.10.1.3
		extremeWingCfgProfVpnCryptoInstType OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"
				
				Values:
				site-to-site-auto,
				remote-vpn,
				site-to-site-manual
				
				XPath: /extremeWing-config/profile[name=key1]/crypto_map[name=key2]/crypto_map_entry[sequence=key3]/type"
			DEFVAL { "site-to-site-auto" }
			::= { extremeWingCfgProfVpnCryptoInstEntry 3 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.16.18.10.1.4
		extremeWingCfgProfVpnCryptoInstIpAcl OBJECT-TYPE
			SYNTAX ExtremeWingIdentifier
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Access list for traffic that should be protected by IPsec.
				
				XPath: /extremeWing-config/profile[name=key1]/crypto_map[name=key2]/crypto_map_entry[sequence=key3]/ip_acl"
			::= { extremeWingCfgProfVpnCryptoInstEntry 4 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.16.18.10.1.5
		extremeWingCfgProfVpnCryptoInstTransformSet OBJECT-TYPE
			SYNTAX ExtremeWingIdentifier
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"NOTE: This column is valid only if extremeWingCfgProfVpnCryptoInstType sets to site-to-site-auto or remote-vpn
				
				IPsec transform (encryption and hash algorithms) to use.
				
				XPath: /extremeWing-config/profile[name=key1]/crypto_map[name=key2]/crypto_map_entry[sequence=key3]/ipsec_transform_set"
			::= { extremeWingCfgProfVpnCryptoInstEntry 5 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.16.18.10.1.6
		extremeWingCfgProfVpnCryptoInstLocalip OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Use this IP as local tunnel endpoint address, instead of the interface IP (Advanced Configuration).
				
				XPath: /extremeWing-config/profile[name=key1]/crypto_map[name=key2]/crypto_map_entry[sequence=key3]/localip"
			::= { extremeWingCfgProfVpnCryptoInstEntry 6 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.16.18.10.1.7
		extremeWingCfgProfVpnCryptoInstPfs OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"NOTE: This column is valid only if extremeWingCfgProfVpnCryptoInstType sets to site-to-site-auto or remote-vpn
				
				Perfect Forward Secrecy.
				
				Values:
				none,
				2,
				5,
				14
				
				XPath: /extremeWing-config/profile[name=key1]/crypto_map[name=key2]/crypto_map_entry[sequence=key3]/pfs"
			DEFVAL { "none" }
			::= { extremeWingCfgProfVpnCryptoInstEntry 7 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.16.18.10.1.8
		extremeWingCfgProfVpnCryptoInstLifetimeSeconds OBJECT-TYPE
			SYNTAX Unsigned32 (120..2147483646)
			UNITS "seconds"
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Time-based IPsec security association lifetime.
				
				XPath: /extremeWing-config/profile[name=key1]/crypto_map[name=key2]/crypto_map_entry[sequence=key3]/lifetime_seconds"
			::= { extremeWingCfgProfVpnCryptoInstEntry 8 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.16.18.10.1.9
		extremeWingCfgProfVpnCryptoInstLifetimeKb OBJECT-TYPE
			SYNTAX Unsigned32 (500..2147483646)
			UNITS "kilobytes"
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Volume-based IPsec security association lifetime.
				
				XPath: /extremeWing-config/profile[name=key1]/crypto_map[name=key2]/crypto_map_entry[sequence=key3]/lifetime_kb"
			::= { extremeWingCfgProfVpnCryptoInstEntry 9 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.16.18.10.1.10
		extremeWingCfgProfVpnCryptoInstRemoteType OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"NOTE: This column is valid only if extremeWingCfgProfVpnCryptoInstType sets to remote-vpn
				
				Remote VPN client type.
				
				Values:
				none,
				xauth
				
				XPath: /extremeWing-config/profile[name=key1]/crypto_map[name=key2]/crypto_map_entry[sequence=key3]/remote_type"
			DEFVAL { "xauth" }
			::= { extremeWingCfgProfVpnCryptoInstEntry 10 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.16.18.10.1.11
		extremeWingCfgProfVpnCryptoInstModeconfig OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"NOTE: This column is valid only if extremeWingCfgProfVpnCryptoInstType sets to remote-vpn
				
				Choose the modeconfig method to use.
				
				Values:
				push,
				pull
				
				XPath: /extremeWing-config/profile[name=key1]/crypto_map[name=key2]/crypto_map_entry[sequence=key3]/modeconfig"
			DEFVAL { "push" }
