                                "External webportal fail page URL

                                XPath: /extremeWing-config/captive_portal[name=key1]/external_pages/fail"
                        ::= { extremeWingCfgCaptPrtlEntry 19 }

                -- 1.3.6.1.4.1.1916.2.131.50.1.3.10.1.1.20
                extremeWingCfgCaptPrtlExternalAgreementUrl OBJECT-TYPE
                        SYNTAX DisplayString
                        MAX-ACCESS read-write
                        STATUS current
                        DESCRIPTION
