				Values:
				auto,
				force-authorized,
				force-unauthorized
				
				XPath: /extremeWing-config/profile[name=key1]/interface[name=key2]/port_control"
			DEFVAL { "force-authorized" }
			::= { extremeWingCfgProfIfDot1xAuthEntry 3 }

		
