			SYNTAX Counter64
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"Number of packets of data dropped on transmission
				
				XPath: /extremeWing-stats/device[mac=key1]/wireless/radio-stats[radio_id=key2]/tx_dropped"
			::= { extremeWingStatsDevWlRadioStatEntry 10 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.4.2.25.10.1.1.11
		extremeWingStatsDevWlRadioStatRxErrors OBJECT-TYPE
			SYNTAX Counter64
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"Number of packets of data received with errors
				
				XPath: /extremeWing-stats/device[mac=key1]/wireless/radio-stats[radio_id=key2]/rx_errors"
			::= { extremeWingStatsDevWlRadioStatEntry 11 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.4.2.25.10.1.1.12
		extremeWingStatsDevWlRadioStatTIndex OBJECT-TYPE
			SYNTAX Integer32
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"Traffic Utilization Index
				
				Measures the efficiency the medium under consideration
				is used. It is the percentage of the current data throughput
				over the theoretical data rate limit, which is derived
				the current maximum physical rate configured over the medium
				based on past empirical data. This index could assist end user
				in site planning and expansion. The numerical value might be
				further classified as:
				  -1: no data available ( e.g. radio is not in wlan operation
				                          mode )
				  0-20 : very low utilization
				  20-40: low utilization
				  40-60: moderate utilization
				  60 and above: high utilization
				
				XPath: /extremeWing-stats/device[mac=key1]/wireless/radio-stats[radio_id=key2]/t_index"
			::= { extremeWingStatsDevWlRadioStatEntry 12 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.4.2.25.10.1.1.13
		extremeWingStatsDevWlRadioStatTxBps OBJECT-TYPE
			SYNTAX Unsigned32
			UNITS "kbps"
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"User data transmit rate
				
				XPath: /extremeWing-stats/device[mac=key1]/wireless/radio-stats[radio_id=key2]/tx_bps"
			::= { extremeWingStatsDevWlRadioStatEntry 13 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.4.2.25.10.1.1.14
		extremeWingStatsDevWlRadioStatRxBps OBJECT-TYPE
			SYNTAX Unsigned32
			UNITS "kbps"
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"User data receive rate
				
				XPath: /extremeWing-stats/device[mac=key1]/wireless/radio-stats[radio_id=key2]/rx_bps"
			::= { extremeWingStatsDevWlRadioStatEntry 14 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.4.2.25.10.1.1.15
		extremeWingStatsDevWlRadioStatSignal OBJECT-TYPE
			SYNTAX Integer32
			UNITS "dbm"
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"Signal strength in units of dbm
				
				XPath: /extremeWing-stats/device[mac=key1]/wireless/radio-stats[radio_id=key2]/signal"
			::= { extremeWingStatsDevWlRadioStatEntry 15 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.4.2.25.10.1.1.16
		extremeWingStatsDevWlRadioStatNoise OBJECT-TYPE
			SYNTAX Integer32
			UNITS "dbm"
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"Noise level in units of dbm
				
				XPath: /extremeWing-stats/device[mac=key1]/wireless/radio-stats[radio_id=key2]/noise"
			::= { extremeWingStatsDevWlRadioStatEntry 16 }

		
