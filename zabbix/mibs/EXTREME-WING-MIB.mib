		extremeWingCfgProfIgsIpIgmpSnooping OBJECT-TYPE
			SYNTAX TruthValue
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Enable/Disable igmp snooping; if set to disable, then per vlan bridge configuration is ignored
				
				XPath: /extremeWing-config/profile[name=key1]/ip_igmp_snooping"
			DEFVAL { true }
			::= { extremeWingCfgProfIgsEntry 1 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.16.22.1.1.2
		extremeWingCfgProfIgsIpIgmpSnoopingForwardUnknownMulticast OBJECT-TYPE
			SYNTAX TruthValue
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Enable/Disable unknown multicast fowarding
				
				XPath: /extremeWing-config/profile[name=key1]/ip_igmp_snooping_forward_unknown_multicast"
			DEFVAL { false }
			::= { extremeWingCfgProfIgsEntry 2 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.16.22.1.1.3
		extremeWingCfgProfIgsIpIgmpSnoopingQuerier OBJECT-TYPE
			SYNTAX TruthValue
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Enable/Disable on board IGMP querier on the device
				
				XPath: /extremeWing-config/profile[name=key1]/ip_igmp_snooping_querier"
			DEFVAL { false }
			::= { extremeWingCfgProfIgsEntry 3 }

		
