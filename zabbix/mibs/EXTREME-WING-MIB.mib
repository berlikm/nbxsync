			SEQUENCE { 
				extremeWingCfgAssocAclRulePrecedence
					Unsigned32,
				extremeWingCfgAssocAclRulePermit
					TruthValue,
				extremeWingCfgAssocAclRuleMac0
					MacAddress,
				extremeWingCfgAssocAclRuleMac1
					MacAddress
			 }

		-- 1.3.6.1.4.1.1916.2.131.50.1.3.8.2.1.1
		extremeWingCfgAssocAclRulePrecedence OBJECT-TYPE
			SYNTAX Unsigned32 (1..1000)
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"The index/precedence of a particular rule. Rules are matched
				in order of increasing precedence.
				
				XPath: /extremeWing-config/assoc_acl[name=key1]/rule[precedence=key2]/precedence"
			::= { extremeWingCfgAssocAclRuleEntry 1 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.8.2.1.3
		extremeWingCfgAssocAclRulePermit OBJECT-TYPE
			SYNTAX TruthValue
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Configure whether to disallow access if a MAC matches
				this rule, or to fall through to the next rule.
				
				XPath: /extremeWing-config/assoc_acl[name=key1]/rule[precedence=key2]/permit"
			DEFVAL { false }
			::= { extremeWingCfgAssocAclRuleEntry 3 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.8.2.1.4
		extremeWingCfgAssocAclRuleMac0 OBJECT-TYPE
			SYNTAX MacAddress
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"The starting MAC address in the range of MACs that apply to
				this rule.
				
				XPath: /extremeWing-config/assoc_acl[name=key1]/rule[precedence=key2]/mac0"
			DEFVAL { '000000000000'h }
			::= { extremeWingCfgAssocAclRuleEntry 4 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.8.2.1.5
		extremeWingCfgAssocAclRuleMac1 OBJECT-TYPE
			SYNTAX MacAddress
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"The ending MAC address in the range of MACs that apply to
				this rule.
				
				XPath: /extremeWing-config/assoc_acl[name=key1]/rule[precedence=key2]/mac1"
			DEFVAL { 'FFFFFFFFFFFF'h }
			::= { extremeWingCfgAssocAclRuleEntry 5 }

		
-- /extremeWing-config/smart_rf_policy
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.9
