			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Enable / disable logging for this Route Map.
				
				XPath: /extremeWing-config/routing_policy[name=key1]/logging"
			DEFVAL { false }
			::= { extremeWingCfgRouteEntry 3 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.31.1.1.4
		extremeWingCfgRouteLocalPbr OBJECT-TYPE
			SYNTAX TruthValue
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Enable/Disable Policy Based Routing for packets generated by the device.
				
				XPath: /extremeWing-config/routing_policy[name=key1]/local_pbr"
			DEFVAL { true }
			::= { extremeWingCfgRouteEntry 4 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.31.1.1.5
		extremeWingCfgRouteUseCrm OBJECT-TYPE
			SYNTAX TruthValue
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Use Critical Resource Monitoring to monitor the status of a link. This will determine the state of next-hop in Route Map, via which Critical Resources are being monitored. Link monitoring is used for failover to a secondary next-hop
				
				XPath: /extremeWing-config/routing_policy[name=key1]/use_crm"
			DEFVAL { true }
			::= { extremeWingCfgRouteEntry 5 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.31.2
		extremeWingCfgRouteMapTable OBJECT-TYPE
			SYNTAX SEQUENCE OF ExtremeWingCfgRouteMapEntry
			MAX-ACCESS not-accessible
			STATUS current
			DESCRIPTION
				"
				
				/extremeWing-config/routing_policy"
			::= { extremeWingCfgRoute 2 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.31.2.1
		extremeWingCfgRouteMapEntry OBJECT-TYPE
			SYNTAX ExtremeWingCfgRouteMapEntry
			MAX-ACCESS not-accessible
			STATUS current
			DESCRIPTION
				"An entry in the table."
			INDEX { extremeWingCfgRouteName, extremeWingCfgRouteMapPrecedence }
			::= { extremeWingCfgRouteMapTable 1 }

		
		ExtremeWingCfgRouteMapEntry ::=
			SEQUENCE { 
				extremeWingCfgRouteMapPrecedence
					Unsigned32,
				extremeWingCfgRouteMapMatchClauseAcl
					ExtremeWingIdentifier,
				extremeWingCfgRouteMapMatchClauseDscp
					Unsigned32,
				extremeWingCfgRouteMapMatchClauseWlan
					ExtremeWingIdentifier,
				extremeWingCfgRouteMapRolePolicy
					ExtremeWingIdentifier,
				extremeWingCfgRouteMapUserRole
					ExtremeWingIdentifier,
				extremeWingCfgRouteMapMatchClauseIncomingInterface
					DisplayString,
				extremeWingCfgRouteMapNextHop1
					DisplayString,
				extremeWingCfgRouteMapNextHop2
					DisplayString,
				extremeWingCfgRouteMapSetClauseDefaultNextHop
					DisplayString,
				extremeWingCfgRouteMapSetClauseFallback
					TruthValue,
				extremeWingCfgRouteMapSetClauseMarkDscp
					Unsigned32
			 }

		-- 1.3.6.1.4.1.1916.2.131.50.1.3.31.2.1.1
		extremeWingCfgRouteMapPrecedence OBJECT-TYPE
			SYNTAX Unsigned32 (1..100)
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"
				
				XPath: /extremeWing-config/routing_policy[name=key1]/route_map[precedence=key2]/precedence"
			::= { extremeWingCfgRouteMapEntry 1 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.31.2.1.3
		extremeWingCfgRouteMapMatchClauseAcl OBJECT-TYPE
			SYNTAX ExtremeWingIdentifier
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"IP access list to be used as match criterion for the route map.
				
				XPath: /extremeWing-config/routing_policy[name=key1]/route_map[precedence=key2]/match_clause_acl"
			::= { extremeWingCfgRouteMapEntry 3 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.31.2.1.4
		extremeWingCfgRouteMapMatchClauseDscp OBJECT-TYPE
			SYNTAX Unsigned32 (0..63)
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"IP DSCP value to be used as match criterion for the route map.
				
				XPath: /extremeWing-config/routing_policy[name=key1]/route_map[precedence=key2]/match_clause_dscp"
			::= { extremeWingCfgRouteMapEntry 4 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.31.2.1.5
		extremeWingCfgRouteMapMatchClauseWlan OBJECT-TYPE
			SYNTAX ExtremeWingIdentifier
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"WLAN to be used as match criterion for the route map.
				
				XPath: /extremeWing-config/routing_policy[name=key1]/route_map[precedence=key2]/match_clause_wlan"
			::= { extremeWingCfgRouteMapEntry 5 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.31.2.1.6
		extremeWingCfgRouteMapRolePolicy OBJECT-TYPE
			SYNTAX ExtremeWingIdentifier
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"
				
				XPath: /extremeWing-config/routing_policy[name=key1]/route_map[precedence=key2]/match_clause_role/role_policy"
			::= { extremeWingCfgRouteMapEntry 6 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.31.2.1.7
		extremeWingCfgRouteMapUserRole OBJECT-TYPE
			SYNTAX ExtremeWingIdentifier
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"
				
				XPath: /extremeWing-config/routing_policy[name=key1]/route_map[precedence=key2]/match_clause_role/user_role"
			::= { extremeWingCfgRouteMapEntry 7 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.31.2.1.8
		extremeWingCfgRouteMapMatchClauseIncomingInterface OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Name of the interface on which the packet is received. This can be a VLAN or a WWAN interface
				
				XPath: /extremeWing-config/routing_policy[name=key1]/route_map[precedence=key2]/match_clause_incoming_interface"
			::= { extremeWingCfgRouteMapEntry 8 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.31.2.1.9
		extremeWingCfgRouteMapNextHop1 OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"
				
				XPath: /extremeWing-config/routing_policy[name=key1]/route_map[precedence=key2]/set_clause_next_hop/next_hop1"
			::= { extremeWingCfgRouteMapEntry 9 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.31.2.1.11
		extremeWingCfgRouteMapNextHop2 OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"
				
				XPath: /extremeWing-config/routing_policy[name=key1]/route_map[precedence=key2]/set_clause_next_hop/next_hop2"
			::= { extremeWingCfgRouteMapEntry 11 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.31.2.1.13
		extremeWingCfgRouteMapSetClauseDefaultNextHop OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"
				
				XPath: /extremeWing-config/routing_policy[name=key1]/route_map[precedence=key2]/set_clause_default_next_hop"
			::= { extremeWingCfgRouteMapEntry 13 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.31.2.1.14
		extremeWingCfgRouteMapSetClauseFallback OBJECT-TYPE
			SYNTAX TruthValue
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Fallback to destination based routing if none of the next-hops are reachable
				
				XPath: /extremeWing-config/routing_policy[name=key1]/route_map[precedence=key2]/set_clause_fallback"
			DEFVAL { true }
			::= { extremeWingCfgRouteMapEntry 14 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.31.2.1.15
		extremeWingCfgRouteMapSetClauseMarkDscp OBJECT-TYPE
			SYNTAX Unsigned32 (0..63)
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"
				
				XPath: /extremeWing-config/routing_policy[name=key1]/route_map[precedence=key2]/set_clause_mark_dscp"
			::= { extremeWingCfgRouteMapEntry 15 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.32
		extremeWingCfgl2tpv3Policy OBJECT IDENTIFIER ::= { extremeWingConfig 32 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.32.1
		extremeWingCfgl2tpv3PolicyTable OBJECT-TYPE
			SYNTAX SEQUENCE OF ExtremeWingCfgl2tpv3PolicyEntry
			MAX-ACCESS not-accessible
			STATUS current
			DESCRIPTION
				"extremeWing Cfg l2tpv3 Policy Table"
			::= { extremeWingCfgl2tpv3Policy 1 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.32.1.1
		extremeWingCfgl2tpv3PolicyEntry OBJECT-TYPE
			SYNTAX ExtremeWingCfgl2tpv3PolicyEntry
			MAX-ACCESS not-accessible
			STATUS current
			DESCRIPTION
				"An entry in the table."
			INDEX { extremeWingCfgl2tpv3PolicyName }
			::= { extremeWingCfgl2tpv3PolicyTable 1 }

		
		ExtremeWingCfgl2tpv3PolicyEntry ::=
			SEQUENCE { 
				extremeWingCfgl2tpv3PolicyName
					ExtremeWingIdentifier,
				extremeWingCfgl2tpv3PolicyHelloInterval
					Unsigned32,
				extremeWingCfgl2tpv3PolicyRetryAttempts
					Unsigned32,
				extremeWingCfgl2tpv3PolicyRetryInterval
					Unsigned32,
				extremeWingCfgl2tpv3PolicyHideAVPs
					TruthValue,
				extremeWingCfgl2tpv3PolicyCookieSize
					DisplayString,
				extremeWingCfgl2tpv3PolicyRxWindowSize
					Unsigned32,
				extremeWingCfgl2tpv3PolicyTxWindowSize
					Unsigned32,
				extremeWingCfgl2tpv3PolicySequencingRequired
					TruthValue,
				extremeWingCfgl2tpv3PolicyReconnectInterval
					Unsigned32,
				extremeWingCfgl2tpv3PolicyReconnectAttempts
					Unsigned32
			 }

		-- 1.3.6.1.4.1.1916.2.131.50.1.3.32.1.1.1
		extremeWingCfgl2tpv3PolicyName OBJECT-TYPE
			SYNTAX ExtremeWingIdentifier (SIZE (1..31))
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"l2tpv3 Policy Name.
				
				XPath: /extremeWing-config/l2tpv3_policy[name=key1]/name"
			::= { extremeWingCfgl2tpv3PolicyEntry 1 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.32.1.1.3
		extremeWingCfgl2tpv3PolicyHelloInterval OBJECT-TYPE
			SYNTAX Unsigned32 (1..3600)
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Time in seconds for sending Hello Keepalive packets.
				
				XPath: /extremeWing-config/l2tpv3_policy[name=key1]/hello_interval"
			::= { extremeWingCfgl2tpv3PolicyEntry 3 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.32.1.1.4
		extremeWingCfgl2tpv3PolicyRetryAttempts OBJECT-TYPE
			SYNTAX Unsigned32 (1..10)
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Number tries before declaring a peer dead.
				
				XPath: /extremeWing-config/l2tpv3_policy[name=key1]/retry_attempts"
			::= { extremeWingCfgl2tpv3PolicyEntry 4 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.32.1.1.5
		extremeWingCfgl2tpv3PolicyRetryInterval OBJECT-TYPE
			SYNTAX Unsigned32 (1..250)
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Time between successive retries.
				
				XPath: /extremeWing-config/l2tpv3_policy[name=key1]/retry_interval"
			::= { extremeWingCfgl2tpv3PolicyEntry 5 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.32.1.1.6
		extremeWingCfgl2tpv3PolicyHideAVPs OBJECT-TYPE
			SYNTAX TruthValue
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Hide the AVPs.
				
				XPath: /extremeWing-config/l2tpv3_policy[name=key1]/hide_avps"
			::= { extremeWingCfgl2tpv3PolicyEntry 6 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.32.1.1.7
		extremeWingCfgl2tpv3PolicyCookieSize OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Size of the Cookies in the session.

                                 Values:
                                 0,
                                 4,
                                 8  
				
				XPath: /extremeWing-config/l2tpv3_policy[name=key1]/cookie_size"
			::= { extremeWingCfgl2tpv3PolicyEntry 7 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.32.1.1.8
		extremeWingCfgl2tpv3PolicyRxWindowSize OBJECT-TYPE
			SYNTAX Unsigned32 (1..15)
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Rx Window size.
				
				XPath: /extremeWing-config/l2tpv3_policy[name=key1]/rx_window_size"
			::= { extremeWingCfgl2tpv3PolicyEntry 8 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.32.1.1.9
		extremeWingCfgl2tpv3PolicyTxWindowSize OBJECT-TYPE
			SYNTAX Unsigned32 (1..15)
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Tx Window size.
				
				XPath: /extremeWing-config/l2tpv3_policy[name=key1]/tx_window_size"
			::= { extremeWingCfgl2tpv3PolicyEntry 9 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.32.1.1.10
		extremeWingCfgl2tpv3PolicySequencingRequired OBJECT-TYPE
			SYNTAX TruthValue
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Sequence the packets receive/sent.
				
				XPath: /extremeWing-config/l2tpv3_policy[name=key1]/sequencing_required"
			::= { extremeWingCfgl2tpv3PolicyEntry 10 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.32.1.1.11
		extremeWingCfgl2tpv3PolicyReconnectInterval OBJECT-TYPE
			SYNTAX Unsigned32 (1..3600)
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Time between two sucessive retry attempts.
				
				XPath: /extremeWing-config/l2tpv3_policy[name=key1]/reconnect_interval"
			::= { extremeWingCfgl2tpv3PolicyEntry 11 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.32.1.1.12
		extremeWingCfgl2tpv3PolicyReconnectAttempts OBJECT-TYPE
			SYNTAX Unsigned32 (0..250)
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Number of reconnect to peer attempts, 0: try to reconnect for ever.
				
				XPath: /extremeWing-config/l2tpv3_policy[name=key1]/reconnect_attempts"
			::= { extremeWingCfgl2tpv3PolicyEntry 12 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.33
		extremeWingCfgLegacyAp OBJECT IDENTIFIER ::= { extremeWingConfig 33 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.33.1
		extremeWingCfgLegacyApTable OBJECT-TYPE
			SYNTAX SEQUENCE OF ExtremeWingCfgLegacyApEntry
			MAX-ACCESS not-accessible
			STATUS current
			DESCRIPTION
				"Legacy AP (AP300) configuraion.
				
				/extremeWing-config/ap300"
			::= { extremeWingCfgLegacyAp 1 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.33.1.1
		extremeWingCfgLegacyApEntry OBJECT-TYPE
			SYNTAX ExtremeWingCfgLegacyApEntry
			MAX-ACCESS not-accessible
			STATUS current
			DESCRIPTION
				"An entry in the table."
			INDEX { extremeWingCfgLegacyApIndex }
			::= { extremeWingCfgLegacyApTable 1 }

		
		ExtremeWingCfgLegacyApEntry ::=
			SEQUENCE { 
				extremeWingCfgLegacyApIndex
					ExtremeWingIdentifier,
				extremeWingCfgLegacyApCountryCode
					DisplayString,
				extremeWingCfgLegacyApLed
					TruthValue,
				extremeWingCfgLegacyApLocation
					DisplayString,
				extremeWingCfgLegacyApIpAddr
					DisplayString,
				extremeWingCfgLegacyApGateway
					IpAddress,
				extremeWingCfgLegacyApPreferredControllerGroup
					DisplayString
			 }

		-- 1.3.6.1.4.1.1916.2.131.50.1.3.33.1.1.1
		extremeWingCfgLegacyApIndex OBJECT-TYPE
			SYNTAX ExtremeWingIdentifier
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"AP index.
				
				Values:
				MAC address in string format with - as the sepearator,
				e.g. 00-A0-F8-BC-E9-21
				default-ap300
				
				XPath: /extremeWing-config/ap300[mac=key1]/mac"
			::= { extremeWingCfgLegacyApEntry 1 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.33.1.1.3
		extremeWingCfgLegacyApCountryCode OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"The country of operation.
				
				Values:
				not-set ae ai an ar at au ba bb be bg bh bm bo br bs bw by
				ca ch cl cn co cr cx cy cz de dk do dz ec ee eg es fi fk fr
				gb gf gp gr gt gu gy hk hn hr ht hu id ie il in is it jm jo
				jp ke kr kw ky kz lb li lk lt lu lv ma md mk mq mt mx my mp
				me nf ng ni nl no nu nz na om pa pe ph pk pl pr pt py qa
				ro rs ru sa se sg si sk sv th tr tn tt tw ua us uy ve vg vi
				vn za
				
				XPath: /extremeWing-config/ap300[mac=key1]/country_code"
			::= { extremeWingCfgLegacyApEntry 3 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.33.1.1.4
		extremeWingCfgLegacyApLed OBJECT-TYPE
			SYNTAX TruthValue
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Turn LEDs on/off on the AP.
				
				XPath: /extremeWing-config/ap300[mac=key1]/led"
			DEFVAL { true }
			::= { extremeWingCfgLegacyApEntry 4 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.33.1.1.5
		extremeWingCfgLegacyApLocation OBJECT-TYPE
			SYNTAX DisplayString (SIZE (0..64))
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"The location of this AP.
				
				XPath: /extremeWing-config/ap300[mac=key1]/location"
			::= { extremeWingCfgLegacyApEntry 5 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.33.1.1.6
		extremeWingCfgLegacyApIpAddr OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"The IP address for AP adoption, network mask /32
				has to be specified. (e.g. 10.0.0.1/8)
				
				XPath: /extremeWing-config/ap300[mac=key1]/ap300_ip_address"
			::= { extremeWingCfgLegacyApEntry 6 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.33.1.1.7
		extremeWingCfgLegacyApGateway OBJECT-TYPE
			SYNTAX IpAddress
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"The IP gateway for AP adoption (e.g. 10.0.0.1).
				
				XPath: /extremeWing-config/ap300[mac=key1]/ap300_gw"
			::= { extremeWingCfgLegacyApEntry 7 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.33.1.1.8
		extremeWingCfgLegacyApPreferredControllerGroup OBJECT-TYPE
			SYNTAX DisplayString (SIZE (0..64))
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Controller which the AP will prefer for adoption.
				
				XPath: /extremeWing-config/ap300[mac=key1]/preferred_controller_group"
			::= { extremeWingCfgLegacyApEntry 8 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.33.2
		extremeWingCfgLegacyApIfTable OBJECT-TYPE
			SYNTAX SEQUENCE OF ExtremeWingCfgLegacyApIfEntry
			MAX-ACCESS not-accessible
			STATUS current
			DESCRIPTION
				"Legacy AP radio interface configuration.
				
				/extremeWing-config/ap300/interface"
			::= { extremeWingCfgLegacyAp 2 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.33.2.1
		extremeWingCfgLegacyApIfEntry OBJECT-TYPE
			SYNTAX ExtremeWingCfgLegacyApIfEntry
			MAX-ACCESS not-accessible
			STATUS current
			DESCRIPTION
				"An entry in the table."
			INDEX { extremeWingCfgLegacyApIndex, extremeWingCfgLegacyApIfName }
			::= { extremeWingCfgLegacyApIfTable 1 }

		
		ExtremeWingCfgLegacyApIfEntry ::=
			SEQUENCE { 
				extremeWingCfgLegacyApIfName
					ExtremeWingIdentifier,
				extremeWingCfgLegacyApIfDescr
					DisplayString,
				extremeWingCfgLegacyApIfShutdown
					TruthValue,
				extremeWingCfgLegacyApIfRfMode
					DisplayString,
				extremeWingCfgLegacyApIfAntennaDiversity
					TruthValue,
				extremeWingCfgLegacyApIfBeaconInterval
					DisplayString,
				extremeWingCfgLegacyApIfChannel
					DisplayString,
				extremeWingCfgLegacyApIfMaxClients
					Unsigned32,
				extremeWingCfgLegacyApIfPlacement
					DisplayString,
				extremeWingCfgLegacyApIfPower
					Unsigned32,
				extremeWingCfgLegacyApIfPreambleShort
					TruthValue,
				extremeWingCfgLegacyApIfOnChannelScan
					TruthValue,
				extremeWingCfgLegacyApIfRtsThreshold
					Unsigned32,
				extremeWingCfgLegacyApIfQosPolicy
					ExtremeWingIdentifier,
				extremeWingCfgLegacyApIfWirelessClientPower
					Unsigned32
			 }

		-- 1.3.6.1.4.1.1916.2.131.50.1.3.33.2.1.1
		extremeWingCfgLegacyApIfName OBJECT-TYPE
			SYNTAX ExtremeWingIdentifier
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"Radio interface name.
				
				XPath: /extremeWing-config/ap300[mac=key1]/interface[name=key2]/name"
			::= { extremeWingCfgLegacyApIfEntry 1 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.33.2.1.3
		extremeWingCfgLegacyApIfDescr OBJECT-TYPE
			SYNTAX DisplayString (SIZE (0..64))
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
