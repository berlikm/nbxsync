			::= { extremeWingCfgMcxMeshpointQosEntry 22 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.35.2.1.23
		extremeWingCfgMcxMeshpointQosNeighborRlDownThreshVideo OBJECT-TYPE
			SYNTAX Unsigned32 (0..100)
			UNITS "%"
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
