			::= { extremeWingStatsRfdWlClientStatEntry 16 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.4.3.2.5.1.1.17
		extremeWingStatsRfdWlClientStatTxRate OBJECT-TYPE
			SYNTAX Unsigned32
			UNITS "Mbps"
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"The effective phy-layer transmit rate
				
				XPath: /extremeWing-stats/rf_domain[name=key1]/wireless/client-stats[mac=key2]/tx_rate"
			::= { extremeWingStatsRfdWlClientStatEntry 17 }

		
