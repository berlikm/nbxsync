		-- 1.3.6.1.4.1.1916.2.131.50.1.5.2.3
		extremeWingActionFileMD5sumRun OBJECT-TYPE
			SYNTAX ExtremeWingDoActionNow
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
