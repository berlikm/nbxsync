		extremeWingCfgDevIfDot1xAuthPortControl OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Set 802.1x port state
				
				Values:
				auto,
				force-authorized,
				force-unauthorized
				
				XPath: /extremeWing-config/device[mac=key1]/interface[name=key2]/port_control"
			DEFVAL { "force-authorized" }
			::= { extremeWingCfgDevIfDot1xAuthEntry 3 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.18.3.16.1.4
		extremeWingCfgDevIfDot1xAuthReauthenticate OBJECT-TYPE
			SYNTAX TruthValue
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Enable 802.1x re-authentication
				
				XPath: /extremeWing-config/device[mac=key1]/interface[name=key2]/reauthenticate"
			DEFVAL { false }
			::= { extremeWingCfgDevIfDot1xAuthEntry 4 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.18.3.16.1.5
		extremeWingCfgDevIfDot1xAuthMaxReauthCount OBJECT-TYPE
			SYNTAX Unsigned32 (1..10)
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Number of reauthentication attempts before a port is moved to unauthorized
				
				XPath: /extremeWing-config/device[mac=key1]/interface[name=key2]/max_reauth_count"
			DEFVAL { 2 }
			::= { extremeWingCfgDevIfDot1xAuthEntry 5 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.18.3.16.1.6
		extremeWingCfgDevIfDot1xAuthMaxReq OBJECT-TYPE
			SYNTAX Unsigned32 (1..10)
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Number of times 802.1x will retry authentication with the Radius Server before giving up and returning failed to the supplicant.
				
				XPath: /extremeWing-config/device[mac=key1]/interface[name=key2]/max_req"
			DEFVAL { 2 }
			::= { extremeWingCfgDevIfDot1xAuthEntry 6 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.18.3.16.1.7
		extremeWingCfgDevIfDot1xAuthQuietPeriod OBJECT-TYPE
			SYNTAX Unsigned32 (1..65535)
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Time in seconds 802.1x will wait after authentication fails
				
				XPath: /extremeWing-config/device[mac=key1]/interface[name=key2]/quiet_period"
			DEFVAL { 60 }
			::= { extremeWingCfgDevIfDot1xAuthEntry 7 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.18.3.16.1.8
		extremeWingCfgDevIfDot1xAuthReauthPeriod OBJECT-TYPE
			SYNTAX Unsigned32 (1..65535)
