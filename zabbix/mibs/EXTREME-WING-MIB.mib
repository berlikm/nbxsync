			SYNTAX DisplayString
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"
				XPATH: /extremeWing-config/auto_provisioning_policy[name=key1]/rule[precedence=key2]/controller_name"
			::= { extremeWingCfgAutoProvisionPolicyRuleEntry 7 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.27.2.1.8
		extremeWingCfgAutoProvisionPolicyRuleArea OBJECT-TYPE
			SYNTAX DisplayString (SIZE (0..64))
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
