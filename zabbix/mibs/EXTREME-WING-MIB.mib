		extremeWingCfgProfMeshpointDevHysteresisPeriod OBJECT-TYPE
			SYNTAX Unsigned32 (0..600)
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Path method hysteresis of candidate must be sustained for period of time
				XPath: /extremeWing-config/profile[name=key1]/meshpoint_device[name=key2]/hysteresis_period"
			DEFVAL { 1 }
			::= { extremeWingCfgProfMeshpointDevEntry 10 }


		-- 1.3.6.1.4.1.1916.2.131.50.1.3.16.25.1.1.11
		extremeWingCfgProfMeshpointDevHysteresisSnrDelta OBJECT-TYPE
			SYNTAX Unsigned32 (0..100)
			UNITS "db"
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Path method hysteresis SNR of candidate must have dB level better than current
				XPath: /extremeWing-config/profile[name=key1]/meshpoint_device[name=key2]/hysteresis_snr_delta
				"
			DEFVAL { 1 }
			::= { extremeWingCfgProfMeshpointDevEntry 11 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.16.25.1.1.12
		extremeWingCfgProfMeshpointDevHysteresisSnrMin OBJECT-TYPE
			SYNTAX Integer32 (-100..0)
			UNITS "db"
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Path method hysteresis SNR of candidate must be above minimum threshold
				XPath: /extremeWing-config/profile[name=key1]/meshpoint_device[name=key2]/hysteresis_snr_min
				"
			DEFVAL { 0 }
			::= { extremeWingCfgProfMeshpointDevEntry 12 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.16.25.1.1.13
		extremeWingCfgProfMeshpointDevExcludeWiredPeer OBJECT-TYPE
			SYNTAX TruthValue
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Excluded a mesh link from forming with a mesh device that is a wired peer
				XPath: /extremeWing-config/profile[name=key1]/meshpoint_device[name=key2]/exclude_wired_peer
				"
			DEFVAL { false }
			::= { extremeWingCfgProfMeshpointDevEntry 13 }


		-- 1.3.6.1.4.1.1916.2.131.50.1.3.16.25.1.1.14
		extremeWingCfgProfMeshpointDevHysteresisRootSelSnrDelta OBJECT-TYPE
			SYNTAX Unsigned32 (1..100)
			UNITS "db"
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Root selection method hysteresis SNR delta range that a candidate must sustain
				
				XPATH:/extremeWing-config/profile[name=key1]/meshpoint_device[name=key2]/hysteresis_root_sel_snr_delta"
			DEFVAL { 1 }
			::= { extremeWingCfgProfMeshpointDevEntry 14 }


		-- 1.3.6.1.4.1.1916.2.131.50.1.3.16.25.1.1.15
		extremeWingCfgProfMeshpointDevRootSelectMethod OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Root selection method for determining whether the meshpoint is a root or non-root
				
				none
				auto-mint
				
				XPath: /extremeWing-config/profile[name=key1]/meshpoint_device[name=key2]/root_select_method"
			DEFVAL { "none" }
			::= { extremeWingCfgProfMeshpointDevEntry 15 }


		-- 1.3.6.1.4.1.1916.2.131.50.1.3.16.25.1.1.16
		extremeWingCfgProfMeshpointDevRootSelectCostRoot OBJECT-TYPE
			SYNTAX TruthValue
