		-- 1.3.6.1.4.1.1916.2.131.50.1.4.3.2.11.1.1.1
		extremeWingStatsRfdWlRadioStatDetailId OBJECT-TYPE
			SYNTAX ExtremeWingIdentifier
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"Unique ID for each radio interface in the form of
				AP-MAC:R%d. E.g., 00-A0-F8-00-00-00:R1
				
				XPath: /extremeWing-stats/rf_domain[name=key1]/wireless/radio-stats-details[radio_id=key2]/radio_id"
			::= { extremeWingStatsRfdWlRadioStatDetailEntry 1 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.4.3.2.11.1.1.2
