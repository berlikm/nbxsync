-- /extremeWing-config/wips_policy
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.14
		extremeWingCfgWips OBJECT IDENTIFIER ::= { extremeWingConfig 14 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.14.1
		extremeWingCfgWipsTable OBJECT-TYPE
			SYNTAX SEQUENCE OF ExtremeWingCfgWipsEntry
			MAX-ACCESS not-accessible
			STATUS current
			DESCRIPTION
				"
				
				/extremeWing-config/wips_policy"
			::= { extremeWingCfgWips 1 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.14.1.1
		extremeWingCfgWipsEntry OBJECT-TYPE
			SYNTAX ExtremeWingCfgWipsEntry
			MAX-ACCESS not-accessible
			STATUS current
			DESCRIPTION
				"An entry in the table."
			INDEX { extremeWingCfgWipsName }
			::= { extremeWingCfgWipsTable 1 }

		
		ExtremeWingCfgWipsEntry ::=
			SEQUENCE { 
				extremeWingCfgWipsName
					ExtremeWingIdentifier,
				extremeWingCfgWipsEnable
					TruthValue,
				extremeWingCfgWipsHistoryThrottleDuration
					Unsigned32,
				extremeWingCfgWipsApDetection
					TruthValue,
				extremeWingCfgWipsApDetectionAgeout
					Unsigned32,
				extremeWingCfgWipsApDetectionWaitTime
					Unsigned32,
				extremeWingCfgWipsDeviceCategorization
					ExtremeWingIdentifier
			 }

		-- 1.3.6.1.4.1.1916.2.131.50.1.3.14.1.1.1
		extremeWingCfgWipsName OBJECT-TYPE
			SYNTAX ExtremeWingIdentifier
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"
				
				XPath: /extremeWing-config/wips_policy[name=key1]/name"
			::= { extremeWingCfgWipsEntry 1 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.14.1.1.3
		extremeWingCfgWipsEnable OBJECT-TYPE
			SYNTAX TruthValue
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Specifies if the given wips policy is enabled or not
				
				XPath: /extremeWing-config/wips_policy[name=key1]/enable"
			DEFVAL { true }
			::= { extremeWingCfgWipsEntry 3 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.14.1.1.4
		extremeWingCfgWipsHistoryThrottleDuration OBJECT-TYPE
			SYNTAX Unsigned32 (30..86400)
			UNITS "seconds"
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"The duration for which event duplicates are not stored in history.
				
				XPath: /extremeWing-config/wips_policy[name=key1]/history_throttle_duration"
			DEFVAL { 120 }
			::= { extremeWingCfgWipsEntry 4 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.14.1.1.5
		extremeWingCfgWipsApDetection OBJECT-TYPE
			SYNTAX TruthValue
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"enable Rogue AP detection
				
				XPath: /extremeWing-config/wips_policy[name=key1]/ap_detection"
			DEFVAL { false }
			::= { extremeWingCfgWipsEntry 5 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.14.1.1.6
		extremeWingCfgWipsApDetectionAgeout OBJECT-TYPE
			SYNTAX Unsigned32 (30..86400)
			UNITS "seconds"
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"ageout time for rogue APs
				
				XPath: /extremeWing-config/wips_policy[name=key1]/ap_detection_ageout"
			DEFVAL { 300 }
			::= { extremeWingCfgWipsEntry 6 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.14.1.1.7
		extremeWingCfgWipsApDetectionWaitTime OBJECT-TYPE
			SYNTAX Unsigned32 (10..600)
			UNITS "seconds"
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"wait time to determine before an AP is identified as rogue
				
				XPath: /extremeWing-config/wips_policy[name=key1]/ap_detection_wait_time"
			DEFVAL { 60 }
			::= { extremeWingCfgWipsEntry 7 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.14.1.1.8
		extremeWingCfgWipsDeviceCategorization OBJECT-TYPE
			SYNTAX ExtremeWingIdentifier
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"
				
				XPath: /extremeWing-config/wips_policy[name=key1]/device_categorization"
			::= { extremeWingCfgWipsEntry 8 }

		
-- /extremeWing-config/dhcp_server_policy
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.15
		extremeWingCfgDhcpSvr OBJECT IDENTIFIER ::= { extremeWingConfig 15 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.15.1
		extremeWingCfgDhcpSvrTable OBJECT-TYPE
			SYNTAX SEQUENCE OF ExtremeWingCfgDhcpSvrEntry
			MAX-ACCESS not-accessible
			STATUS current
			DESCRIPTION
				"User definition for the on-board DHCP server.
				
				/extremeWing-config/dhcp_server_policy"
			::= { extremeWingCfgDhcpSvr 1 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.15.1.1
		extremeWingCfgDhcpSvrEntry OBJECT-TYPE
			SYNTAX ExtremeWingCfgDhcpSvrEntry
			MAX-ACCESS not-accessible
			STATUS current
			DESCRIPTION
				"An entry in the table."
			INDEX { extremeWingCfgDhcpSvrName }
			::= { extremeWingCfgDhcpSvrTable 1 }

		
		ExtremeWingCfgDhcpSvrEntry ::=
			SEQUENCE { 
				extremeWingCfgDhcpSvrName
					ExtremeWingIdentifier,
				extremeWingCfgDhcpSvrIgnoreBootp
					TruthValue,
				extremeWingCfgDhcpSvrPingInterval
					Unsigned32
			 }

		-- 1.3.6.1.4.1.1916.2.131.50.1.3.15.1.1.1
		extremeWingCfgDhcpSvrName OBJECT-TYPE
			SYNTAX ExtremeWingIdentifier
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"
				
				XPath: /extremeWing-config/dhcp_server_policy[name=key1]/name"
			::= { extremeWingCfgDhcpSvrEntry 1 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.15.1.1.3
		extremeWingCfgDhcpSvrIgnoreBootp OBJECT-TYPE
			SYNTAX TruthValue
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Configure DHCP server to ignore BOOTP requests.
				
				XPath: /extremeWing-config/dhcp_server_policy[name=key1]/ignore_bootp"
			DEFVAL { false }
			::= { extremeWingCfgDhcpSvrEntry 3 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.15.1.1.4
		extremeWingCfgDhcpSvrPingInterval OBJECT-TYPE
			SYNTAX Unsigned32 (1..10)
			UNITS "seconds"
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Ping timeout interval.
				
				XPath: /extremeWing-config/dhcp_server_policy[name=key1]/dhcpSvrPingInterval"
			DEFVAL { 1 }
			::= { extremeWingCfgDhcpSvrEntry 4 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.15.2
		extremeWingCfgDhcpSvrClassTable OBJECT-TYPE
			SYNTAX SEQUENCE OF ExtremeWingCfgDhcpSvrClassEntry
			MAX-ACCESS not-accessible
			STATUS current
			DESCRIPTION
				"
				
				/extremeWing-config/dhcp_server_policy/dhcp_class"
			::= { extremeWingCfgDhcpSvr 2 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.15.2.1
		extremeWingCfgDhcpSvrClassEntry OBJECT-TYPE
			SYNTAX ExtremeWingCfgDhcpSvrClassEntry
			MAX-ACCESS not-accessible
			STATUS current
			DESCRIPTION
				"An entry in the table."
			INDEX { extremeWingCfgDhcpSvrName, extremeWingCfgDhcpSvrClassName }
			::= { extremeWingCfgDhcpSvrClassTable 1 }

		
		ExtremeWingCfgDhcpSvrClassEntry ::=
			SEQUENCE { 
				extremeWingCfgDhcpSvrClassName
					ExtremeWingIdentifier,
				extremeWingCfgDhcpSvrClassMultipleUserClass
					TruthValue
			 }

		-- 1.3.6.1.4.1.1916.2.131.50.1.3.15.2.1.1
		extremeWingCfgDhcpSvrClassName OBJECT-TYPE
			SYNTAX ExtremeWingIdentifier
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"
				
				XPath: /extremeWing-config/dhcp_server_policy[name=key1]/dhcp_class[name=key2]/name"
			::= { extremeWingCfgDhcpSvrClassEntry 1 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.15.2.1.3
		extremeWingCfgDhcpSvrClassMultipleUserClass OBJECT-TYPE
			SYNTAX TruthValue
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Enable multiple user class option.
				
				XPath: /extremeWing-config/dhcp_server_policy[name=key1]/dhcp_class[name=key2]/multiple_user_class"
			DEFVAL { false }
			::= { extremeWingCfgDhcpSvrClassEntry 3 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.15.3
		extremeWingCfgDhcpSvrOptionTable OBJECT-TYPE
			SYNTAX SEQUENCE OF ExtremeWingCfgDhcpSvrOptionEntry
			MAX-ACCESS not-accessible
			STATUS current
			DESCRIPTION
				"Define an option; the value is assigned inside the pool.
				
				/extremeWing-config/dhcp_server_policy/dhcp_options"
			::= { extremeWingCfgDhcpSvr 3 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.15.3.1
		extremeWingCfgDhcpSvrOptionEntry OBJECT-TYPE
			SYNTAX ExtremeWingCfgDhcpSvrOptionEntry
			MAX-ACCESS not-accessible
			STATUS current
			DESCRIPTION
				"An entry in the table."
			INDEX { extremeWingCfgDhcpSvrName, extremeWingCfgDhcpSvrOptionName }
			::= { extremeWingCfgDhcpSvrOptionTable 1 }

		
		ExtremeWingCfgDhcpSvrOptionEntry ::=
			SEQUENCE { 
				extremeWingCfgDhcpSvrOptionName
					ExtremeWingIdentifier,
				extremeWingCfgDhcpSvrOptionCode
					Unsigned32,
				extremeWingCfgDhcpSvrOptionType
					DisplayString
			 }

		-- 1.3.6.1.4.1.1916.2.131.50.1.3.15.3.1.1
		extremeWingCfgDhcpSvrOptionName OBJECT-TYPE
			SYNTAX ExtremeWingIdentifier
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"
				
				XPath: /extremeWing-config/dhcp_server_policy[name=key1]/dhcp_options[name=key2]/name"
			::= { extremeWingCfgDhcpSvrOptionEntry 1 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.15.3.1.3
		extremeWingCfgDhcpSvrOptionCode OBJECT-TYPE
			SYNTAX Unsigned32 (0..254)
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"
				
				XPath: /extremeWing-config/dhcp_server_policy[name=key1]/dhcp_options[name=key2]/code"
			::= { extremeWingCfgDhcpSvrOptionEntry 3 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.15.3.1.4
		extremeWingCfgDhcpSvrOptionType OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"
				Values:
				ip
				ascii
				hexstring
				
				XPath: /extremeWing-config/dhcp_server_policy[name=key1]/dhcp_options[name=key2]/type"
			::= { extremeWingCfgDhcpSvrOptionEntry 4 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.15.4
		extremeWingCfgDhcpSvrPoolTable OBJECT-TYPE
			SYNTAX SEQUENCE OF ExtremeWingCfgDhcpSvrPoolEntry
			MAX-ACCESS not-accessible
			STATUS current
			DESCRIPTION
				"
				
				/extremeWing-config/dhcp_server_policy/dhcp_pools"
			::= { extremeWingCfgDhcpSvr 4 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.15.4.1
		extremeWingCfgDhcpSvrPoolEntry OBJECT-TYPE
			SYNTAX ExtremeWingCfgDhcpSvrPoolEntry
			MAX-ACCESS not-accessible
			STATUS current
			DESCRIPTION
				"An entry in the table."
			INDEX { extremeWingCfgDhcpSvrName, extremeWingCfgDhcpSvrPoolName }
			::= { extremeWingCfgDhcpSvrPoolTable 1 }

		
		ExtremeWingCfgDhcpSvrPoolEntry ::=
			SEQUENCE { 
				extremeWingCfgDhcpSvrPoolName
					ExtremeWingIdentifier,
				extremeWingCfgDhcpSvrPoolNetwork
					IpAddress,
				extremeWingCfgDhcpSvrPoolDomainName
					DisplayString,
				extremeWingCfgDhcpSvrPoolNetbiosNodeType
					DisplayString,
				extremeWingCfgDhcpSvrPoolBootfile
					DisplayString,
				extremeWingCfgDhcpSvrPoolLeaseTime
					Unsigned32,
				extremeWingCfgDhcpSvrPoolBootpNextServer
					DisplayString,
				extremeWingCfgDhcpSvrPoolUpdateDns
					DisplayString,
				extremeWingCfgDhcpSvrPoolDdnsDomainName
					DisplayString,
				extremeWingCfgDhcpSvrPoolDdnsTtl
					Unsigned32,
				extremeWingCfgDhcpSvrPoolDdnsMultiUserClass
					TruthValue,
				extremeWingCfgDhcpSvrPoolUnicastEnable
					TruthValue
			 }

		-- 1.3.6.1.4.1.1916.2.131.50.1.3.15.4.1.1
		extremeWingCfgDhcpSvrPoolName OBJECT-TYPE
			SYNTAX ExtremeWingIdentifier
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"Name of the IP pool from which IP addresses can be issued to
				DHCP client requests.
				
				XPath: /extremeWing-config/dhcp_server_policy[name=key1]/dhcp_pools[name=key2]/name"
			::= { extremeWingCfgDhcpSvrPoolEntry 1 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.15.4.1.3
		extremeWingCfgDhcpSvrPoolNetwork OBJECT-TYPE
			SYNTAX IpAddress
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Network address for the clients.
				
				XPath: /extremeWing-config/dhcp_server_policy[name=key1]/dhcp_pools[name=key2]/network"
			::= { extremeWingCfgDhcpSvrPoolEntry 3 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.15.4.1.4
		extremeWingCfgDhcpSvrPoolDomainName OBJECT-TYPE
			SYNTAX DisplayString (SIZE (1..255))
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"
				
				XPath: /extremeWing-config/dhcp_server_policy[name=key1]/dhcp_pools[name=key2]/domain_name"
			::= { extremeWingCfgDhcpSvrPoolEntry 4 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.15.4.1.5
		extremeWingCfgDhcpSvrPoolNetbiosNodeType OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"
				Values:
				none
				broadcast
				peer-to-peer
				mixed
				hybrid
				
				XPath: /extremeWing-config/dhcp_server_policy[name=key1]/dhcp_pools[name=key2]/netbios_node_type"
			DEFVAL { "undefined" }
			::= { extremeWingCfgDhcpSvrPoolEntry 5 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.15.4.1.6
		extremeWingCfgDhcpSvrPoolBootfile OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"
				
				XPath: /extremeWing-config/dhcp_server_policy[name=key1]/dhcp_pools[name=key2]/bootfile"
			::= { extremeWingCfgDhcpSvrPoolEntry 6 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.15.4.1.7
		extremeWingCfgDhcpSvrPoolLeaseTime OBJECT-TYPE
			SYNTAX Unsigned32 (1..31622399)
			UNITS "seconds"
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"The time an IP address is reserved for re-connection after
				its last use.  Address lease time ranges from 1 second to
				1 year (or infinite if unset).
				
				XPath: /extremeWing-config/dhcp_server_policy[name=key1]/dhcp_pools[name=key2]/lease_time"
			DEFVAL { 86400 }
			::= { extremeWingCfgDhcpSvrPoolEntry 7 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.15.4.1.8
		extremeWingCfgDhcpSvrPoolBootpNextServer OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Next server in the boot process.
				
				XPath: /extremeWing-config/dhcp_server_policy[name=key1]/dhcp_pools[name=key2]/bootp_next_server"
			::= { extremeWingCfgDhcpSvrPoolEntry 8 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.15.4.1.9
		extremeWingCfgDhcpSvrPoolUpdateDns OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"
				Values:
				noUpdate
				serverUpdate
				clientUpdate
				
				XPath: /extremeWing-config/dhcp_server_policy[name=key1]/dhcp_pools[name=key2]/update_dns"
			DEFVAL { "noUpdate" }
			::= { extremeWingCfgDhcpSvrPoolEntry 9 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.15.4.1.10
		extremeWingCfgDhcpSvrPoolDdnsDomainName OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Domain name used for DDNS Updates.
				
				XPath: /extremeWing-config/dhcp_server_policy[name=key1]/dhcp_pools[name=key2]/ddns_domain_name"
			::= { extremeWingCfgDhcpSvrPoolEntry 10 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.15.4.1.11
		extremeWingCfgDhcpSvrPoolDdnsTtl OBJECT-TYPE
			SYNTAX Unsigned32 (1..864000)
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Time-to-Live (TTL) value used for DDNS updates.
				
				XPath: /extremeWing-config/dhcp_server_policy[name=key1]/dhcp_pools[name=key2]/ddns_ttl"
			::= { extremeWingCfgDhcpSvrPoolEntry 11 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.15.4.1.12
		extremeWingCfgDhcpSvrPoolDdnsMultiUserClass OBJECT-TYPE
			SYNTAX TruthValue
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Enable/disable DDNS multi user class.
				
				XPath: /extremeWing-config/dhcp_server_policy[name=key1]/dhcp_pools[name=key2]/ddns_multi_user_class"
			DEFVAL { false }
			::= { extremeWingCfgDhcpSvrPoolEntry 12 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.15.4.1.13
		extremeWingCfgDhcpSvrPoolUnicastEnable OBJECT-TYPE
			SYNTAX TruthValue
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Enable unicast for DHCP Offer and ACK.
				
				XPath: /extremeWing-config/dhcp_server_policy[name=key1]/dhcp_pools[name=key2]/unicast_enable"
			DEFVAL { false }
			::= { extremeWingCfgDhcpSvrPoolEntry 13 }


		-- 1.3.6.1.4.1.1916.2.131.50.1.3.15.10
		extremeWingCfgDhcpSvrActCriteriaTable OBJECT-TYPE
			SYNTAX SEQUENCE OF ExtremeWingCfgDhcpSvrActCriteriaEntry
			MAX-ACCESS not-accessible
			STATUS current
			DESCRIPTION
				"Description."
			::= { extremeWingCfgDhcpSvr 10 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.15.10.1
		extremeWingCfgDhcpSvrActCriteriaEntry OBJECT-TYPE
			SYNTAX ExtremeWingCfgDhcpSvrActCriteriaEntry
			MAX-ACCESS not-accessible
			STATUS current
			DESCRIPTION
				"Description."
			INDEX { extremeWingCfgDhcpSvrName }
			::= { extremeWingCfgDhcpSvrActCriteriaTable 1 }

		
		ExtremeWingCfgDhcpSvrActCriteriaEntry ::=
			SEQUENCE { 
				extremeWingCfgDhcpSvrActCriteriaCriteria
					DisplayString
			 }

		-- 1.3.6.1.4.1.1916.2.131.50.1.3.15.10.1.1
		extremeWingCfgDhcpSvrActCriteriaCriteria OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Criteria to allow dhcp deamon to run
				vrrp-master
				cluster-master
				rf-domain-manager
				 	
				XPath: /extremeWing-config/dhcp_server_policy[name=key1]/dhcp_server_activation_criteria/criteria"
			::= { extremeWingCfgDhcpSvrActCriteriaEntry 1 }

		
		
-- /extremeWing-config/profile
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.16
		extremeWingCfgProf OBJECT IDENTIFIER ::= { extremeWingConfig 16 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.16.1
		extremeWingCfgProfTable OBJECT-TYPE
			SYNTAX SEQUENCE OF ExtremeWingCfgProfEntry
			MAX-ACCESS not-accessible
			STATUS current
			DESCRIPTION
				"
				
				/extremeWing-config/profile"
			::= { extremeWingCfgProf 1 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.16.1.1
		extremeWingCfgProfEntry OBJECT-TYPE
			SYNTAX ExtremeWingCfgProfEntry
			MAX-ACCESS not-accessible
			STATUS current
			DESCRIPTION
				"An entry in the table."
			INDEX { extremeWingCfgProfName }
			::= { extremeWingCfgProfTable 1 }

		
		ExtremeWingCfgProfEntry ::=
			SEQUENCE { 
				extremeWingCfgProfName
					ExtremeWingIdentifier,
				extremeWingCfgProfType
					DisplayString,
				extremeWingCfgProfDomainLookup
					TruthValue,
				extremeWingCfgProfDomainName
					DisplayString,
				extremeWingCfgProfArpTimeout
					Unsigned32,
				extremeWingCfgProfApIpAddr
					IpAddress,
				extremeWingCfgProfAutoConfUpdate
					TruthValue,
				extremeWingCfgProfAutoFwUpdate
					TruthValue,
				extremeWingCfgProfAutoupgradeCount
					Unsigned32,
				extremeWingCfgProfServiceWatchdog
					TruthValue,
				extremeWingCfgProfRadiusServerPolicy
					ExtremeWingIdentifier,
