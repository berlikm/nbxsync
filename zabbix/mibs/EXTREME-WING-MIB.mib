-- /extremeWing-config/management_policy
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.19
		extremeWingCfgMgmt OBJECT IDENTIFIER ::= { extremeWingConfig 19 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.19.1
		extremeWingCfgMgmtTable OBJECT-TYPE
			SYNTAX SEQUENCE OF ExtremeWingCfgMgmtEntry
			MAX-ACCESS not-accessible
			STATUS current
			DESCRIPTION
				"
				
				/extremeWing-config/management_policy"
			::= { extremeWingCfgMgmt 1 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.19.1.1
		extremeWingCfgMgmtEntry OBJECT-TYPE
			SYNTAX ExtremeWingCfgMgmtEntry
			MAX-ACCESS not-accessible
			STATUS current
			DESCRIPTION
				"An entry in the table."
			INDEX { extremeWingCfgMgmtName }
			::= { extremeWingCfgMgmtTable 1 }

		
		ExtremeWingCfgMgmtEntry ::=
			SEQUENCE { 
				extremeWingCfgMgmtName
					ExtremeWingIdentifier,
				extremeWingCfgMgmtTelnetEnable
					TruthValue,
				extremeWingCfgMgmtTelnetPort
					Unsigned32,
				extremeWingCfgMgmtHttpEnable
					TruthValue,
				extremeWingCfgMgmtHttpsEnable
					TruthValue,
				extremeWingCfgMgmtSshEnable
					TruthValue,
				extremeWingCfgMgmtSshPort
					Unsigned32,
				extremeWingCfgMgmtBannerMotd
					DisplayString
			 }

		-- 1.3.6.1.4.1.1916.2.131.50.1.3.19.1.1.1
		extremeWingCfgMgmtName OBJECT-TYPE
			SYNTAX ExtremeWingIdentifier
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"
				
				XPath: /extremeWing-config/management_policy[name=key1]/name"
			::= { extremeWingCfgMgmtEntry 1 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.19.1.1.3
		extremeWingCfgMgmtTelnetEnable OBJECT-TYPE
			SYNTAX TruthValue
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"
				
				XPath: /extremeWing-config/management_policy[name=key1]/telnet/enable"
			DEFVAL { false }
			::= { extremeWingCfgMgmtEntry 3 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.19.1.1.4
		extremeWingCfgMgmtTelnetPort OBJECT-TYPE
			SYNTAX Unsigned32 (1..65535)
			MAX-ACCESS read-write
			STATUS current
