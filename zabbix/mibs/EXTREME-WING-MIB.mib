			SYNTAX SEQUENCE OF ExtremeWingCfgProfIfVlanOspfMsgDigestEntry
			MAX-ACCESS not-accessible
			STATUS current
			DESCRIPTION
				"
				
				/extremeWing-config/profile/interface/ospf_message_digest_key"
			::= { extremeWingCfgProfIf 14 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.16.2.14.1
		extremeWingCfgProfIfVlanOspfMsgDigestEntry OBJECT-TYPE
			SYNTAX ExtremeWingCfgProfIfVlanOspfMsgDigestEntry
			MAX-ACCESS not-accessible
			STATUS current
			DESCRIPTION
				"An entry in the table."
			INDEX { extremeWingCfgProfName, extremeWingCfgProfIfName, extremeWingCfgProfIfVlanOspfMsgDigestKeyId }
			::= { extremeWingCfgProfIfVlanOspfMsgDigestTable 1 }

		
