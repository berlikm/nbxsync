			SYNTAX ExtremeWingCfgRadiusUserPolicyEntry
			MAX-ACCESS not-accessible
			STATUS current
			DESCRIPTION
				"Description."
			INDEX { extremeWingCfgRadiusUserPolicyName }
			::= { extremeWingCfgRadiusUserPolicyTable 1 }

		
		ExtremeWingCfgRadiusUserPolicyEntry ::=
