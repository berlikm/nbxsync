				WIOS_AP4700
				WIOS_AP4600
				WIOS_AP4021
				WIOS_AP4521
				WIOS_AP4511
				WIOS_AP4532
				WIOS_AP4022
				WIOS_AP4522
				WIOS_AP6562
				
				XPATH: /extremeWing-config/auto_provisioning_policy[name=key1]/rule[precedence=key2]/device"
			::= { extremeWingCfgAutoProvisionPolicyRuleEntry 4 }

		
