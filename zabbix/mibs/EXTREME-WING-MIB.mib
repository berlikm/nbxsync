			 }

		-- 1.3.6.1.4.1.1916.2.131.50.1.3.4.1.1.1
		extremeWingCfgWlanName OBJECT-TYPE
			SYNTAX ExtremeWingIdentifier
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"
				
				XPath: /extremeWing-config/wlan[name=key1]/name"
			::= { extremeWingCfgWlanEntry 1 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.4.1.1.3
		extremeWingCfgWlanShutdown OBJECT-TYPE
			SYNTAX TruthValue
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"
				
				XPath: /extremeWing-config/wlan[name=key1]/shutdown"
			DEFVAL { false }
			::= { extremeWingCfgWlanEntry 3 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.4.1.1.4
		extremeWingCfgWlanSsid OBJECT-TYPE
			SYNTAX DisplayString (SIZE (1..32))
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Service Set Identifier for this WLAN.
				
				XPath: /extremeWing-config/wlan[name=key1]/ssid"
			::= { extremeWingCfgWlanEntry 4 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.4.1.1.5
		extremeWingCfgWlanDescr OBJECT-TYPE
			SYNTAX DisplayString (SIZE (1..64))
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Descriptive text about this WLAN.
				
				XPath: /extremeWing-config/wlan[name=key1]/description"
			::= { extremeWingCfgWlanEntry 5 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.4.1.1.6
		extremeWingCfgWlanEncType OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"
				Values:
				none
				wep64
				wep128
				wep128-keyguard
				keyguard
				tkip
				tkip-ccmp
				ccmp
				
				XPath: /extremeWing-config/wlan[name=key1]/encryption_type"
			DEFVAL { "none" }
			::= { extremeWingCfgWlanEntry 6 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.4.1.1.7
		extremeWingCfgWlanAuthType OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"
				Values:
				none
				eap
				kerberos
				mac
				eap-psk
				eap-mac
				
				Notes:
				eap-psk authentication-type is only supported with tkip and
				ccmp encryption types
				
				eap-mac authentication-type is only supported with open,  
				wep64, and wep128 encryption types
				
				kerberos authentication-type is only supported with wep and
				keyguard encryption types
				
				XPath: /extremeWing-config/wlan[name=key1]/authentication_type"
			DEFVAL { "none" }
			::= { extremeWingCfgWlanEntry 7 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.4.1.1.8
		extremeWingCfgWlanCaptivePortalEnforcement OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"
				Values:
				none
				fall-back
				always
				
				XPath: /extremeWing-config/wlan[name=key1]/captive_portal_enforcement"
			DEFVAL { "none" }
			::= { extremeWingCfgWlanEntry 8 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.4.1.1.9
		extremeWingCfgWlanClientPower OBJECT-TYPE
			SYNTAX Unsigned32 (0..20)
			UNITS "dBm"
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Transmit power indicated to wireless clients for transmission.
				
				XPath: /extremeWing-config/wlan[name=key1]/wireless_client_power"
			DEFVAL { 20 }
			::= { extremeWingCfgWlanEntry 9 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.4.1.1.10
		extremeWingCfgWlanNasId OBJECT-TYPE
			SYNTAX DisplayString (SIZE (0..253))
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"The RADIUS NAS-Identifier attribute which typically
				identifies the AP/Controller where the Radius message
				originates.
				
				XPath: /extremeWing-config/wlan[name=key1]/nas_identifier"
			DEFVAL { "" }
			::= { extremeWingCfgWlanEntry 10 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.4.1.1.11
		extremeWingCfgWlanNasPortId OBJECT-TYPE
			SYNTAX DisplayString (SIZE (0..253))
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"The RADIUS NAS-Port-Id attribute which typically identifiers
				the port of the device where the RADIUS messages originates.
				
				XPath: /extremeWing-config/wlan[name=key1]/nas_port_id"
			DEFVAL { "" }
			::= { extremeWingCfgWlanEntry 11 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.4.1.1.12
		extremeWingCfgWlanBroadcastSsid OBJECT-TYPE
			SYNTAX TruthValue
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Do not advertise the SSID of the WLAN in the beacon.
				
				XPath: /extremeWing-config/wlan[name=key1]/broadcast_ssid"
			DEFVAL { true }
			::= { extremeWingCfgWlanEntry 12 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.4.1.1.13
		extremeWingCfgWlanAnswerBroadcastProbes OBJECT-TYPE
			SYNTAX TruthValue
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Include this WLAN when responding to probe requests that
				do not specify an SSID.
				
				XPath: /extremeWing-config/wlan[name=key1]/answer_broadcast_probes"
			DEFVAL { true }
			::= { extremeWingCfgWlanEntry 13 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.4.1.1.14
		extremeWingCfgWlanClientClientCommunication OBJECT-TYPE
			SYNTAX TruthValue
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Disallow switching of frames from one Wireless Client to
				another on this WLAN.
				
				XPath: /extremeWing-config/wlan[name=key1]/client_client_communication"
			DEFVAL { true }
			::= { extremeWingCfgWlanEntry 14 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.4.1.1.15
		extremeWingCfgWlanHoldTime OBJECT-TYPE
			SYNTAX Unsigned32 (1..300)
			UNITS "seconds"
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"User credentials and firewall flow state information
				is cached for this much time when the user roams away.
				
				XPath: /extremeWing-config/wlan[name=key1]/hold_time"
			DEFVAL { 30 }
			::= { extremeWingCfgWlanEntry 15 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.4.1.1.16
		extremeWingCfgWlanInactivityTimeout OBJECT-TYPE
			SYNTAX Unsigned32 (60..86400)
			UNITS "seconds"
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"If a frame is not received from a Wireless Client for this
				amount of time, the Wireless Client is disassociated.
				
				XPath: /extremeWing-config/wlan[name=key1]/inactivity_timeout"
			DEFVAL { 1800 }
			::= { extremeWingCfgWlanEntry 16 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.4.1.1.17
		extremeWingCfgWlanCredCacheAgeout OBJECT-TYPE
			SYNTAX Unsigned32 (60..86400)
			UNITS "seconds"
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"User keys are cached for this time interval across
				associations
				
				XPath: /extremeWing-config/wlan[name=key1]/credcache_ageout"
			DEFVAL { 86400 }
			::= { extremeWingCfgWlanEntry 17 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.4.1.1.18
		extremeWingCfgWlanVlanCacheAgeout OBJECT-TYPE
			SYNTAX Unsigned32 (60..86400)
			UNITS "seconds"
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"User vlan information is cached for this time interval
				across associations
				
				XPath: /extremeWing-config/wlan[name=key1]/vlancache_ageout"
			DEFVAL { 3600 }
			::= { extremeWingCfgWlanEntry 18 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.4.1.1.19
		extremeWingCfgWlanMaxFirewallSessions OBJECT-TYPE
			SYNTAX Unsigned32 (10..10000)
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Maximum firewall flows per Wireless Client.
				
				XPath: /extremeWing-config/wlan[name=key1]/max_firewall_sessions"
			::= { extremeWingCfgWlanEntry 19 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.4.1.1.20
		extremeWingCfgWlanReauth OBJECT-TYPE
			SYNTAX Unsigned32 (30..86400)
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"
				
				XPath: /extremeWing-config/wlan[name=key1]/reauthentication"
			::= { extremeWingCfgWlanEntry 20 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.4.1.1.21
		extremeWingCfgWlanPmfMode OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"
				Values:
				disabled
				optional
				mandatory
				
				XPath: /extremeWing-config/wlan[name=key1]/pmf_mode"
			DEFVAL { "disabled" }
			::= { extremeWingCfgWlanEntry 21 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.4.1.1.22
		extremeWingCfgWlanPmfSaQueryTimeout OBJECT-TYPE
			SYNTAX Unsigned32 (100..1000)
			UNITS "milliseconds"
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Timeout when waiting for a response to a Security Association
				(SA) Query before resending it.
				
				XPath: /extremeWing-config/wlan[name=key1]/pmf_sa_query_timeout"
			DEFVAL { 201 }
			::= { extremeWingCfgWlanEntry 22 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.4.1.1.23
		extremeWingCfgWlanPmfSaQueryAttempts OBJECT-TYPE
			SYNTAX Unsigned32 (1..10)
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Number of times a Security Association (SA) Query message
				is tried.
				
				XPath: /extremeWing-config/wlan[name=key1]/pmf_sa_query_attempts"
			DEFVAL { 5 }
			::= { extremeWingCfgWlanEntry 23 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.4.1.1.24
		extremeWingCfgWlanWpaWpa2Psk OBJECT-TYPE
			SYNTAX DisplayString (SIZE (8..64))
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"
				
				XPath: /extremeWing-config/wlan[name=key1]/wpa_wpa2_psk"
			::= { extremeWingCfgWlanEntry 24 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.4.1.1.25
		extremeWingCfgWlanWpaWpa2ExcludeWpa2Tkip OBJECT-TYPE
			SYNTAX TruthValue
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Exclude the WPA2 version of TKIP and support only WPA-TKIP.
				
				XPath: /extremeWing-config/wlan[name=key1]/wpa_wpa2_exclude_wpa2_tkip"
			DEFVAL { false }
			::= { extremeWingCfgWlanEntry 25 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.4.1.1.26
		extremeWingCfgWlanWpaWpa2KeyRotationUnicast OBJECT-TYPE
			SYNTAX Unsigned32 (30..86400)
			UNITS "seconds"
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"
				
				XPath: /extremeWing-config/wlan[name=key1]/wpa_wpa2_key_rotation_unicast"
			::= { extremeWingCfgWlanEntry 26 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.4.1.1.27
		extremeWingCfgWlanWpaWpa2KeyRotationBroadcast OBJECT-TYPE
			SYNTAX Unsigned32 (30..86400)
			UNITS "seconds"
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"
				
				XPath: /extremeWing-config/wlan[name=key1]/wpa_wpa2_key_rotation_broadcast"
			::= { extremeWingCfgWlanEntry 27 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.4.1.1.28
		extremeWingCfgWlanWpaWpa2PmkCaching OBJECT-TYPE
			SYNTAX TruthValue
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Enable the user of cached pairwise master keys (fast roaming
				with 802.1X EAP).
				
				XPath: /extremeWing-config/wlan[name=key1]/wpa_wpa2_pmk_caching"
			DEFVAL { true }
			::= { extremeWingCfgWlanEntry 28 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.4.1.1.29
		extremeWingCfgWlanWpaWpa2OpmkCaching OBJECT-TYPE
			SYNTAX TruthValue
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Enable the use of Opportunistic Key Caching (same PMK across
				APs for fast roaming with 802.1X EAP).
				
				XPath: /extremeWing-config/wlan[name=key1]/wpa_wpa2_opmk_caching"
			DEFVAL { true }
			::= { extremeWingCfgWlanEntry 29 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.4.1.1.30
		extremeWingCfgWlanWpaWpa2Preauth OBJECT-TYPE
			SYNTAX TruthValue
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Enable the use of preauthentication (802.11i fast roaming).
				
				XPath: /extremeWing-config/wlan[name=key1]/wpa_wpa2_preauthentication"
			DEFVAL { true }
			::= { extremeWingCfgWlanEntry 30 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.4.1.1.31
		extremeWingCfgWlanWpaWpa2TkipCntrmeasHoldTime OBJECT-TYPE
			SYNTAX Unsigned32 (0..65535)
			UNITS "seconds"
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"The amount of time for which a WLAN is disabled when
				TKIP countermeasures are invoked.
				
				XPath: /extremeWing-config/wlan[name=key1]/wpa_wpa2_tkip_cntrmeas_hold_time"
			DEFVAL { 60 }
			::= { extremeWingCfgWlanEntry 31 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.4.1.1.32
		extremeWingCfgWlanWep64TransmitKey OBJECT-TYPE
			SYNTAX Unsigned32 (1..4)
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"
				
				XPath: /extremeWing-config/wlan[name=key1]/wep64_transmit_key"
			DEFVAL { 1 }
			::= { extremeWingCfgWlanEntry 32 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.4.1.1.37
		extremeWingCfgWlanWep128TransmitKey OBJECT-TYPE
			SYNTAX Unsigned32 (1..4)
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"
				
				XPath: /extremeWing-config/wlan[name=key1]/wep128_transmit_key"
			DEFVAL { 1 }
			::= { extremeWingCfgWlanEntry 37 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.4.1.1.42
		extremeWingCfgWlanRadiusAssignedVlans OBJECT-TYPE
			SYNTAX TruthValue
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Allow users to be assigned to RADIUS server-specified VLANs.
				
				XPath: /extremeWing-config/wlan[name=key1]/radius_assigned_vlans"
			DEFVAL { false }
			::= { extremeWingCfgWlanEntry 42 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.4.1.1.43
		extremeWingCfgWlanRadiusDynamicAuthorization OBJECT-TYPE
			SYNTAX TruthValue
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Enable support for Disconnect and Change of Authorization
				(CoA) messages (RFC5176).
				
				XPath: /extremeWing-config/wlan[name=key1]/radius_dynamic_authorization"
