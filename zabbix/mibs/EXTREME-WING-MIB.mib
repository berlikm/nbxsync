			SYNTAX DisplayString
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Single or multi-host mode.
				
				Values:
				single-host,
				multi-host
				
				XPath: /extremeWing-config/device[mac=key1]/interface[name=key2]/host_mode"
			DEFVAL { "single-host" }
			::= { extremeWingCfgDevIfDot1xAuthEntry 1 }

		
