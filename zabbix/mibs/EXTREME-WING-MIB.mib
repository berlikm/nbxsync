		-- 1.3.6.1.4.1.1916.2.131.50.1.4.2.25.10.1
		extremeWingStatsDevWlRadioStatTable OBJECT-TYPE
			SYNTAX SEQUENCE OF ExtremeWingStatsDevWlRadioStatEntry
			MAX-ACCESS not-accessible
			STATUS current
			DESCRIPTION
				"Traffic and RF statistics of radios on AP
				
				/extremeWing-stats/device/wireless/radio-stats"
			::= { extremeWingStatsDevWlRadioStat 1 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.4.2.25.10.1.1
		extremeWingStatsDevWlRadioStatEntry OBJECT-TYPE
			SYNTAX ExtremeWingStatsDevWlRadioStatEntry
			MAX-ACCESS not-accessible
			STATUS current
			DESCRIPTION
				"An entry in the table."
			INDEX { extremeWingStatsDevMac, extremeWingStatsDevWlRadioStatId }
			::= { extremeWingStatsDevWlRadioStatTable 1 }

		
		ExtremeWingStatsDevWlRadioStatEntry ::=
			SEQUENCE { 
				extremeWingStatsDevWlRadioStatId
					ExtremeWingIdentifier,
				extremeWingStatsDevWlRadioStatDeviceMac
					MacAddress,
				extremeWingStatsDevWlRadioStatAlias
					ExtremeWingIdentifier,
				extremeWingStatsDevWlRadioStatMac
					MacAddress,
				extremeWingStatsDevWlRadioStatType
					DisplayString,
				extremeWingStatsDevWlRadioStatTxBytes
					Counter64,
				extremeWingStatsDevWlRadioStatRxBytes
					Counter64,
				extremeWingStatsDevWlRadioStatTxPkts
					Counter64,
				extremeWingStatsDevWlRadioStatRxPkts
					Counter64,
				extremeWingStatsDevWlRadioStatTxDropped
					Counter64,
				extremeWingStatsDevWlRadioStatRxErrors
					Counter64,
				extremeWingStatsDevWlRadioStatTIndex
					Integer32,
				extremeWingStatsDevWlRadioStatTxBps
					Unsigned32,
				extremeWingStatsDevWlRadioStatRxBps
					Unsigned32,
				extremeWingStatsDevWlRadioStatSignal
					Integer32,
				extremeWingStatsDevWlRadioStatNoise
					Integer32,
				extremeWingStatsDevWlRadioStatSnr
					Integer32,
				extremeWingStatsDevWlRadioStatTxRate
					Unsigned32,
				extremeWingStatsDevWlRadioStatRxRate
					Unsigned32,
				extremeWingStatsDevWlRadioStatErrorRate
					Unsigned32,
				extremeWingStatsDevWlRadioStatQIndex
					Integer32,
				extremeWingStatsDevWlRadioStatNumClients
					Unsigned32,
				extremeWingStatsDevWlRadioStatNumBClients
					Unsigned32,
				extremeWingStatsDevWlRadioStatNumBgClients
					Unsigned32,
				extremeWingStatsDevWlRadioStatNumBgnClients
					Unsigned32,
				extremeWingStatsDevWlRadioStatNumAClients
					Unsigned32,
				extremeWingStatsDevWlRadioStatNumAnClients
					Unsigned32,
				extremeWingStatsDevWlRadioStatMediumErrorRate
					Unsigned32,
				extremeWingStatsDevWlRadioStatTxRetries
					Counter64,
				extremeWingStatsDevWlRadioStatTxRetriedBytes
					Counter64
			 }

		-- 1.3.6.1.4.1.1916.2.131.50.1.4.2.25.10.1.1.1
		extremeWingStatsDevWlRadioStatId OBJECT-TYPE
			SYNTAX ExtremeWingIdentifier
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"Unique ID for each radio interface in the form of
				AP-MAC:R%d. E.g., 00-A0-F8-00-00-00:R1
				
				XPath: /extremeWing-stats/device[mac=key1]/wireless/radio-stats[radio_id=key2]/radio_id"
			::= { extremeWingStatsDevWlRadioStatEntry 1 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.4.2.25.10.1.1.2
