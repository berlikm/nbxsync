				extremeWingCfgProfVrrpGroupDescription
					DisplayString,
				extremeWingCfgProfVrrpGroupPriority
					Unsigned32,
				extremeWingCfgProfVrrpGroupAdvertisementUnit
					DisplayString,
				extremeWingCfgProfVrrpGroupAdvertisementIntervalV2
					Unsigned32,
				extremeWingCfgProfVrrpGroupAdvertisementIntervalV2Msec
					Unsigned32,
				extremeWingCfgProfVrrpGroupAdvertisementIntervalV3
					Unsigned32,
				extremeWingCfgProfVrrpGroupPreempt
					TruthValue,
				extremeWingCfgProfVrrpGroupPreemptDelay
					Unsigned32,
				extremeWingCfgProfVrrpGroupCrmAction
					DisplayString,
				extremeWingCfgProfVrrpGroupDeltaPriority
					Unsigned32,
				extremeWingCfgProfVrrpGroupInterface
					Unsigned32,
				extremeWingCfgProfVrrpGroupSyncGroup
					TruthValue
			 }

		-- 1.3.6.1.4.1.1916.2.131.50.1.3.16.21.2.1.1
		extremeWingCfgProfVrrpGroupVirtualRouterId OBJECT-TYPE
			SYNTAX Unsigned32 (1..255)
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"Identifies the virtual router and used for associating VRRP packet with this field
				
				XPath: /extremeWing-config/profile[name=key1]/vrrp_groups[virtual_router_id=key2]/virtual_router_id"
			::= { extremeWingCfgProfVrrpGroupEntry 1 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.16.21.2.1.3
		extremeWingCfgProfVrrpGroupDescription OBJECT-TYPE
			SYNTAX DisplayString (SIZE (1..64))
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Assigns a text description to the VRRP group
				
				XPath: /extremeWing-config/profile[name=key1]/vrrp_groups[virtual_router_id=key2]/description"
			::= { extremeWingCfgProfVrrpGroupEntry 3 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.16.21.2.1.4
		extremeWingCfgProfVrrpGroupPriority OBJECT-TYPE
			SYNTAX Unsigned32 (1..254)
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"the priority to be used for the virtual router master election process.  Higher values imply higher priority.
				
				XPath: /extremeWing-config/profile[name=key1]/vrrp_groups[virtual_router_id=key2]/priority"
			DEFVAL { 100 }
			::= { extremeWingCfgProfVrrpGroupEntry 4 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.16.21.2.1.5
		extremeWingCfgProfVrrpGroupAdvertisementUnit OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"unit of the advertisment interval
				
				Values:
				seconds,
				milliseconds,
				centiseconds
				
				XPath: /extremeWing-config/profile[name=key1]/vrrp_groups[virtual_router_id=key2]/advertisement_interval/advertisement_unit"
			DEFVAL { "seconds" }
			::= { extremeWingCfgProfVrrpGroupEntry 5 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.16.21.2.1.6
		extremeWingCfgProfVrrpGroupAdvertisementIntervalV2 OBJECT-TYPE
			SYNTAX Unsigned32 (1..255)
			UNITS "seconds"
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Time interval between VRRP advertisments
				
				XPath: /extremeWing-config/profile[name=key1]/vrrp_groups[virtual_router_id=key2]/advertisement_interval/advertisement_interval_v2"
			DEFVAL { 1 }
			::= { extremeWingCfgProfVrrpGroupEntry 6 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.16.21.2.1.7
		extremeWingCfgProfVrrpGroupAdvertisementIntervalV2Msec OBJECT-TYPE
			SYNTAX Unsigned32 (50..999)
			UNITS "milliseconds"
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Time interval between VRRP advertisments
				
				XPath: /extremeWing-config/profile[name=key1]/vrrp_groups[virtual_router_id=key2]/advertisement_interval/advertisement_interval_v2_msec"
			::= { extremeWingCfgProfVrrpGroupEntry 7 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.16.21.2.1.8
		extremeWingCfgProfVrrpGroupAdvertisementIntervalV3 OBJECT-TYPE
			SYNTAX Unsigned32 (1..4095)
			UNITS "centiseconds"
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Time interval between VRRP advertisments
				
				XPath: /extremeWing-config/profile[name=key1]/vrrp_groups[virtual_router_id=key2]/advertisement_interval/advertisement_interval_v3"
			DEFVAL { 100 }
			::= { extremeWingCfgProfVrrpGroupEntry 8 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.16.21.2.1.9
		extremeWingCfgProfVrrpGroupPreempt OBJECT-TYPE
			SYNTAX TruthValue
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Controls whether a higher priority backup router will preempt a lower priority master.
				
				XPath: /extremeWing-config/profile[name=key1]/vrrp_groups[virtual_router_id=key2]/preemption/preempt"
			DEFVAL { true }
			::= { extremeWingCfgProfVrrpGroupEntry 9 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.16.21.2.1.10
		extremeWingCfgProfVrrpGroupPreemptDelay OBJECT-TYPE
			SYNTAX Unsigned32 (1..65535)
			UNITS "seconds"
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Delay interval for pre-emption
				
				XPath: /extremeWing-config/profile[name=key1]/vrrp_groups[virtual_router_id=key2]/preemption/preempt_delay"
			::= { extremeWingCfgProfVrrpGroupEntry 10 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.16.21.2.1.11
		extremeWingCfgProfVrrpGroupCrmAction OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Backup virtual router may raise its priority in case the critical resources connected via the master router fail so that
				
				Values:
				increment-priority,
				decrement-priority,
				none
				
				XPath: /extremeWing-config/profile[name=key1]/vrrp_groups[virtual_router_id=key2]/crm_action"
			DEFVAL { "none" }
			::= { extremeWingCfgProfVrrpGroupEntry 11 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.16.21.2.1.12
		extremeWingCfgProfVrrpGroupDeltaPriority OBJECT-TYPE
			SYNTAX Unsigned32 (1..253)
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"The configured priority will be decremented by this value when the monitored interface state is down. In case of critical resource monitoring, the configured priority will be incremented by this value
				
				XPath: /extremeWing-config/profile[name=key1]/vrrp_groups[virtual_router_id=key2]/delta_priority"
			::= { extremeWingCfgProfVrrpGroupEntry 12 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.16.21.2.1.13
		extremeWingCfgProfVrrpGroupInterface OBJECT-TYPE
			SYNTAX Unsigned32 (1..4094)
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"The SVI (VLAN only) interface on which VRRP will be running. This also enable/disable VRRP operations
				
				XPath: /extremeWing-config/profile[name=key1]/vrrp_groups[virtual_router_id=key2]/interface"
			::= { extremeWingCfgProfVrrpGroupEntry 13 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.16.21.2.1.14
		extremeWingCfgProfVrrpGroupSyncGroup OBJECT-TYPE
			SYNTAX TruthValue
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Make this group part of vrrp sync group. This triggers VRRP failover only when advertisement is not received from all the masters of the virtual routers that is part of this vrrp sync group
				
				XPath: /extremeWing-config/profile[name=key1]/vrrp_groups[virtual_router_id=key2]/sync_group"
			DEFVAL { false }
			::= { extremeWingCfgProfVrrpGroupEntry 14 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.16.22
		extremeWingCfgProfIgs OBJECT IDENTIFIER ::= { extremeWingCfgProf 22 }

		
