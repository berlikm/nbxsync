		extremeWingCfgSmartRfNrPowerThresholdA OBJECT-TYPE
			SYNTAX Integer32 (-85..-55)
			UNITS "dBm"
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Power threshold to be used while performing neighbor recovery
				on 5GHz radios.
				
				XPath: /extremeWing-config/smart_rf_policy[name=key1]/nr_power_threshold_a"
			DEFVAL { -70 }
			::= { extremeWingCfgSmartRfEntry 34 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.9.1.1.35
		extremeWingCfgSmartRfNrPowerThresholdBg OBJECT-TYPE
			SYNTAX Integer32 (-85..-55)
			UNITS "dBm"
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Power threshold to be used while performing neighbor recovery
				on 2.4GHz radios.
				
				XPath: /extremeWing-config/smart_rf_policy[name=key1]/nr_power_threshold_bg"
			DEFVAL { -70 }
			::= { extremeWingCfgSmartRfEntry 35 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.9.1.1.36
		extremeWingCfgSmartRfCoverageHoleRecovery OBJECT-TYPE
			SYNTAX TruthValue
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Recover from coverage hole.
				
				XPath: /extremeWing-config/smart_rf_policy[name=key1]/coverage_hole_recovery"
			DEFVAL { true }
			::= { extremeWingCfgSmartRfEntry 36 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.9.1.1.37
		extremeWingCfgSmartRfChrIntervalA OBJECT-TYPE
			SYNTAX Unsigned32 (1..120)
			UNITS "seconds"
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Interval at which coverage-hole-recovery should be performed
				for 5GHz radios.
				
				XPath: /extremeWing-config/smart_rf_policy[name=key1]/chr_interval_a"
			DEFVAL { 30 }
			::= { extremeWingCfgSmartRfEntry 37 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.9.1.1.38
		extremeWingCfgSmartRfChrIntervalBg OBJECT-TYPE
			SYNTAX Unsigned32 (1..120)
			UNITS "seconds"
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Interval at which coverage-hole-recovery should be performed
				for 2.4GHz radios.
				
				XPath: /extremeWing-config/smart_rf_policy[name=key1]/chr_interval_bg"
			DEFVAL { 30 }
			::= { extremeWingCfgSmartRfEntry 38 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.9.1.1.39
		extremeWingCfgSmartRfChrCovIntervalA OBJECT-TYPE
			SYNTAX Unsigned32 (1..120)
			UNITS "seconds"
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Interval at which coverage-hole-recovery should be performed
				after coverage hole is discovered for 5GHz radios.
				
				XPath: /extremeWing-config/smart_rf_policy[name=key1]/chr_cov_interval_a"
			DEFVAL { 10 }
			::= { extremeWingCfgSmartRfEntry 39 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.9.1.1.40
		extremeWingCfgSmartRfChrCovIntervalBg OBJECT-TYPE
			SYNTAX Unsigned32 (1..120)
			UNITS "seconds"
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Interval at which coverage-hole-recovery should be performed
				after coverage hole is discovered for 2.4GHz radios.
				
				XPath: /extremeWing-config/smart_rf_policy[name=key1]/chr_cov_interval_bg"
			DEFVAL { 10 }
			::= { extremeWingCfgSmartRfEntry 40 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.9.1.1.41
		extremeWingCfgSmartRfChrSnrThresholdA OBJECT-TYPE
			SYNTAX Unsigned32 (1..75)
			UNITS "dB"
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"The signal to noise ratio below which coverage recovery is
				initiated for 5GHz radios.
				
				XPath: /extremeWing-config/smart_rf_policy[name=key1]/chr_snr_threshold_a"
			DEFVAL { 20 }
			::= { extremeWingCfgSmartRfEntry 41 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.9.1.1.42
		extremeWingCfgSmartRfChrSnrThresholdBg OBJECT-TYPE
			SYNTAX Unsigned32 (1..75)
			UNITS "dB"
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"The signal to noise ratio below which coverage recovery is
				initiated for 2.4GHz radios.
				
				XPath: /extremeWing-config/smart_rf_policy[name=key1]/chr_snr_threshold_bg"
			DEFVAL { 20 }
			::= { extremeWingCfgSmartRfEntry 42 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.9.1.1.43
		extremeWingCfgSmartRfChrClientThresholdA OBJECT-TYPE
			SYNTAX Unsigned32 (1..255)
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Minimum number of clients below SNR threhold required for
				coverage hole recovery on 5GHz radios.
				
				XPath: /extremeWing-config/smart_rf_policy[name=key1]/chr_client_threshold_a"
			DEFVAL { 1 }
			::= { extremeWingCfgSmartRfEntry 43 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.9.1.1.44
		extremeWingCfgSmartRfChrClientThresholdBg OBJECT-TYPE
			SYNTAX Unsigned32 (1..255)
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Minimum number of clients below SNR threhold required for
				coverage hole recovery on 2.4GHz radios.
				
				XPath: /extremeWing-config/smart_rf_policy[name=key1]/chr_client_threshold_bg"
			DEFVAL { 1 }
			::= { extremeWingCfgSmartRfEntry 44 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.9.1.1.45
		extremeWingCfgSmartRfChannelHoldTime OBJECT-TYPE
			SYNTAX Unsigned32 (0..86400)
			UNITS "seconds"
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"The minimum time between two channel changes on a radio
				during interference recovery.
				
				XPath: /extremeWing-config/smart_rf_policy[name=key1]/channel_hold_time"
			DEFVAL { 3600 }
			::= { extremeWingCfgSmartRfEntry 45 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.9.1.1.46
		extremeWingCfgSmartRfPowerHoldTime OBJECT-TYPE
			SYNTAX Unsigned32 (0..3600)
			UNITS "seconds"
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"The minimum time between two power changes on a radio during
				neighbor recovery.
				
				XPath: /extremeWing-config/smart_rf_policy[name=key1]/power_hold_time"
			DEFVAL { 0 }
			::= { extremeWingCfgSmartRfEntry 46 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.9.1.1.47
		extremeWingCfgSmartRfOcsMeshpointA OBJECT-TYPE
			SYNTAX DisplayString (SIZE (1..64))
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Meshpoint to be monitored during off channel scan for 5GHz radios
				
				XPath: /extremeWing-config/smart_rf_policy[name=key1]/ocs_meshpoint_a"
			::= { extremeWingCfgSmartRfEntry 47 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.9.1.1.48
		extremeWingCfgSmartRfOcsMeshpointBg OBJECT-TYPE
			SYNTAX DisplayString (SIZE (1..64))
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Meshpoint to be monitored during off channel scan for 2.4GHz radios
				
				XPath: /extremeWing-config/smart_rf_policy[name=key1]/ocs_meshpoint_bg"
			::= { extremeWingCfgSmartRfEntry 48 }

		
-- /extremeWing-config/captive_portal
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.10
		extremeWingCfgCaptPrtl OBJECT IDENTIFIER ::= { extremeWingConfig 10 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.10.1
		extremeWingCfgCaptPrtlTable OBJECT-TYPE
			SYNTAX SEQUENCE OF ExtremeWingCfgCaptPrtlEntry
			MAX-ACCESS not-accessible
			STATUS current
			DESCRIPTION
				"Configuration parameters of a WLAN/VLAN captive portal
				authentication profile
				
				/extremeWing-config/captive_portal"
			::= { extremeWingCfgCaptPrtl 1 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.10.1.1
		extremeWingCfgCaptPrtlEntry OBJECT-TYPE
			SYNTAX ExtremeWingCfgCaptPrtlEntry
			MAX-ACCESS not-accessible
			STATUS current
			DESCRIPTION
				"An entry in the table."
			INDEX { extremeWingCfgCaptPrtlName }
			::= { extremeWingCfgCaptPrtlTable 1 }

		
		ExtremeWingCfgCaptPrtlEntry ::=
			SEQUENCE { 
				extremeWingCfgCaptPrtlName
					ExtremeWingIdentifier,
				extremeWingCfgCaptPrtlAccessType
					DisplayString,
				extremeWingCfgCaptPrtlAccessTime
					Unsigned32,
				extremeWingCfgCaptPrtlCustomAuthInfo
					DisplayString,
				extremeWingCfgCaptPrtlConnectionMode
					DisplayString,
				extremeWingCfgCaptPrtlInactivityTimeout
					Unsigned32,
				extremeWingCfgCaptPrtlServer
					DisplayString,
				extremeWingCfgCaptPrtlServerMode
					DisplayString,
				extremeWingCfgCaptPrtlSimultaneousUsers
					Unsigned32,
				extremeWingCfgCaptPrtlTermsAgreement
					TruthValue,
				extremeWingCfgCaptPrtlWebpageLocation
					DisplayString,
				extremeWingCfgCaptPrtlAccountingRadius
					TruthValue,
				extremeWingCfgCaptPrtlAaaPolicy
					ExtremeWingIdentifier,
				extremeWingCfgCaptPrtlDnsWhitelist
					ExtremeWingIdentifier,
				extremeWingCfgCaptPrtlWebpageAutoUpload
					TruthValue,
                                extremeWingCfgCaptPrtlExternalLoginUrl
                                        DisplayString,
                                extremeWingCfgCaptPrtlExternalWelcomeUrl
                                        DisplayString,
                                extremeWingCfgCaptPrtlExternalFailUrl
                                        DisplayString,
                                extremeWingCfgCaptPrtlExternalAgreementUrl
                                        DisplayString
			 }

		-- 1.3.6.1.4.1.1916.2.131.50.1.3.10.1.1.1
		extremeWingCfgCaptPrtlName OBJECT-TYPE
			SYNTAX ExtremeWingIdentifier
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"
				
				XPath: /extremeWing-config/captive_portal[name=key1]/name"
			::= { extremeWingCfgCaptPrtlEntry 1 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.10.1.1.3
		extremeWingCfgCaptPrtlAccessType OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Access type of this captive portal
				
				Values:
				no-auth
				logging
				custom-auth-radius
				radius
				
				XPath: /extremeWing-config/captive_portal[name=key1]/access_type"
			DEFVAL { "radius" }
			::= { extremeWingCfgCaptPrtlEntry 3 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.10.1.1.4
		extremeWingCfgCaptPrtlAccessTime OBJECT-TYPE
			SYNTAX Unsigned32 (30..10080)
			UNITS "minutes"
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Allowed access time for the client. Used when there is
				no session time value in RADIUS response.
				
				XPath: /extremeWing-config/captive_portal[name=key1]/access_time"
			DEFVAL { 1440 }
			::= { extremeWingCfgCaptPrtlEntry 4 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.10.1.1.5
		extremeWingCfgCaptPrtlCustomAuthInfo OBJECT-TYPE
			SYNTAX DisplayString (SIZE (32))
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Custom user information used for RADIUS lookup/logging when
				access-type custom-auth-radius/logging is configured.
				
				XPath: /extremeWing-config/captive_portal[name=key1]/custom_auth_info"
			::= { extremeWingCfgCaptPrtlEntry 5 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.10.1.1.6
		extremeWingCfgCaptPrtlConnectionMode OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"
				Values:
				http
				https
				
				XPath: /extremeWing-config/captive_portal[name=key1]/connection_mode"
			DEFVAL { "http" }
			::= { extremeWingCfgCaptPrtlEntry 6 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.10.1.1.7
		extremeWingCfgCaptPrtlInactivityTimeout OBJECT-TYPE
			SYNTAX Unsigned32 (300..1800)
			UNITS "seconds"
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"If a frame is not received from client for this
				amount of time, then current session will be removed.
				
				XPath: /extremeWing-config/captive_portal[name=key1]/inactivity_timeout"
			DEFVAL { 600 }
			::= { extremeWingCfgCaptPrtlEntry 7 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.10.1.1.8
		extremeWingCfgCaptPrtlServer OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Device(s) hosting the captive portal service, Address of
				controller or access point for centralized mode,
				Virtual hostname of controller(s) in case of
				centralized-controller mode
				
				XPath: /extremeWing-config/captive_portal[name=key1]/server"
			::= { extremeWingCfgCaptPrtlEntry 8 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.10.1.1.9
		extremeWingCfgCaptPrtlServerMode OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"In centralized/centralized-controller mode, the configured
				server is used as the captive portal server.  In self mode,
				the device serving the WLAN is used as the
				captive portal server.
				
				Values:
				self
				centralized
				centralized-controller
				
				XPath: /extremeWing-config/captive_portal[name=key1]/server_mode"
			DEFVAL { "self" }
			::= { extremeWingCfgCaptPrtlEntry 9 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.10.1.1.10
		extremeWingCfgCaptPrtlSimultaneousUsers OBJECT-TYPE
			SYNTAX Unsigned32 (1..8192)
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Number of MAC addresses that are allowed to use a username at
				the same time.
				
				XPath: /extremeWing-config/captive_portal[name=key1]/simultaneous-users"
			::= { extremeWingCfgCaptPrtlEntry 10 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.10.1.1.11
		extremeWingCfgCaptPrtlTermsAgreement OBJECT-TYPE
			SYNTAX TruthValue
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Combined with any access type, terms needs to be included in
				agreement page
				
				XPath: /extremeWing-config/captive_portal[name=key1]/terms_agreement"
			DEFVAL { false }
			::= { extremeWingCfgCaptPrtlEntry 11 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.10.1.1.12
		extremeWingCfgCaptPrtlWebpageLocation OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"
				Values:
				internal
				external
				advanced
				
				XPath: /extremeWing-config/captive_portal[name=key1]/webpage_location"
			DEFVAL { "internal" }
			::= { extremeWingCfgCaptPrtlEntry 12 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.10.1.1.13
		extremeWingCfgCaptPrtlAccountingRadius OBJECT-TYPE
			SYNTAX TruthValue
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"
				
				XPath: /extremeWing-config/captive_portal[name=key1]/accounting_radius"
			DEFVAL { false }
			::= { extremeWingCfgCaptPrtlEntry 13 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.10.1.1.14
		extremeWingCfgCaptPrtlAaaPolicy OBJECT-TYPE
			SYNTAX ExtremeWingIdentifier
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"
				
				XPath: /extremeWing-config/captive_portal[name=key1]/aaa_policy"
			::= { extremeWingCfgCaptPrtlEntry 14 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.10.1.1.15
		extremeWingCfgCaptPrtlDnsWhitelist OBJECT-TYPE
			SYNTAX ExtremeWingIdentifier
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"
				
				XPath: /extremeWing-config/captive_portal[name=key1]/dns_whitelist"
			::= { extremeWingCfgCaptPrtlEntry 15 }

		-- 1.3.6.1.4.1.1916.2.131.50.1.3.10.1.1.16
		extremeWingCfgCaptPrtlWebpageAutoUpload OBJECT-TYPE
			SYNTAX TruthValue
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"
				
				XPath: /extremeWing-config/captive_portal[name=key1]/webpage_auto_upload"
			DEFVAL { false }
			::= { extremeWingCfgCaptPrtlEntry 16 }

                -- 1.3.6.1.4.1.1916.2.131.50.1.3.10.1.1.17
                extremeWingCfgCaptPrtlExternalLoginUrl OBJECT-TYPE
                        SYNTAX DisplayString
                        MAX-ACCESS read-write
                        STATUS current
                        DESCRIPTION
                                "External webportal login page URL

                                XPath: /extremeWing-config/captive_portal[name=key1]/external_pages/login"
                        ::= { extremeWingCfgCaptPrtlEntry 17 }

                -- 1.3.6.1.4.1.1916.2.131.50.1.3.10.1.1.18
                extremeWingCfgCaptPrtlExternalWelcomeUrl OBJECT-TYPE
                        SYNTAX DisplayString
                        MAX-ACCESS read-write
                        STATUS current
                        DESCRIPTION
