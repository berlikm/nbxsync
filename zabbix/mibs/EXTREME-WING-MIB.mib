			::= { extremeWingStatsRfdWlClientStatEntry 18 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.4.3.2.5.1.1.19
		extremeWingStatsRfdWlClientStatErrorRate OBJECT-TYPE
			SYNTAX Unsigned32
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
