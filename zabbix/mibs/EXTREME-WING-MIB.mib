			SYNTAX SEQUENCE OF ExtremeWingCfgRadiusUserEntry
			MAX-ACCESS not-accessible
			STATUS current
			DESCRIPTION
				"Description."
			::= { extremeWingCfgRadiusUser 2 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.36.2.1
		extremeWingCfgRadiusUserEntry OBJECT-TYPE
			SYNTAX ExtremeWingCfgRadiusUserEntry
			MAX-ACCESS not-accessible
			STATUS current
			DESCRIPTION
				"Description."
			INDEX { extremeWingCfgRadiusUserPolicyName, extremeWingCfgRadiusUserName }
			::= { extremeWingCfgRadiusUserTable 1 }

		
		ExtremeWingCfgRadiusUserEntry ::=
			SEQUENCE { 
				extremeWingCfgRadiusUserName
					DisplayString,
				extremeWingCfgRadiusUserRowStatus
					RowStatus,
				extremeWingCfgRadiusUserPassword
					DisplayString,
				extremeWingCfgRadiusUserIsGuest
					TruthValue,
				extremeWingCfgRadiusUserGroupList
					DisplayString,
				extremeWingCfgRadiusUserGroup
					DisplayString,
				extremeWingCfgRadiusUserStartDate
					DisplayString,
				extremeWingCfgRadiusUserStartTime
					DisplayString,
				extremeWingCfgRadiusUserExpiryDate
					DisplayString,
				extremeWingCfgRadiusUserExpiryTime
					DisplayString,
				extremeWingCfgRadiusUserEmailId
					DisplayString,
				extremeWingCfgRadiusUserTelephone
					DisplayString
			 }

		-- 1.3.6.1.4.1.1916.2.131.50.1.3.36.2.1.1
		extremeWingCfgRadiusUserName OBJECT-TYPE
			SYNTAX DisplayString (SIZE (1..64))
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"The User ID that uniquely identifies this user.
				XPATH: /extremeWing-config/radius_user_pool[name=key1]/users[userid=key2]/userid"
			::= { extremeWingCfgRadiusUserEntry 1 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.36.2.1.2
		extremeWingCfgRadiusUserRowStatus OBJECT-TYPE
			SYNTAX RowStatus
				{
				active(1),
				createAndGo(4),
				destroy(6)
				}
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"The status of this conceptual row.
				XPATH: /extremeWing-config/radius_user_pool[name=key1]/users[userid=key2]/row_status"
			::= { extremeWingCfgRadiusUserEntry 2 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.36.2.1.3
		extremeWingCfgRadiusUserPassword OBJECT-TYPE
			SYNTAX DisplayString (SIZE (1..32))
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"The password for this user.
				XPATH:  /extremeWing-config/radius_user_pool[name=key1]/users[userid=key2]/password"
			::= { extremeWingCfgRadiusUserEntry 3 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.36.2.1.4
		extremeWingCfgRadiusUserIsGuest OBJECT-TYPE
			SYNTAX TruthValue
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Specify whether this is a guest user or normal user. 
				Marking a user as guest will let you specify additional restrictions for the user like 'start' and 
				'expiry' date/time.
				XPATH: /extremeWing-config/radius_user_pool[name=key1]/users[userid=key2]/is_guest"
			DEFVAL { false }
			::= { extremeWingCfgRadiusUserEntry 4 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.36.2.1.5
		extremeWingCfgRadiusUserGroupList OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"The group-list for user.
				XPATH: /extremeWing-config/radius_user_pool[name=key1]/users[userid=key2]/group_list "
			::= { extremeWingCfgRadiusUserEntry 5 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.36.2.1.6
		extremeWingCfgRadiusUserGroup OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"The group for guest user.
				XPATH: /extremeWing-config/radius_user_pool[name=key1]/users[userid=key2]/group"
			::= { extremeWingCfgRadiusUserEntry 6 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.36.2.1.7
		extremeWingCfgRadiusUserStartDate OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Specify a start date (MM:DD:YYYY) after which the user will be able to authenticate. 
				This constraint is applicable only for 'guest' users.
				XPATH: /extremeWing-config/radius_user_pool[name=key1]/users[userid=key2]/start_date"
			::= { extremeWingCfgRadiusUserEntry 7 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.36.2.1.8
		extremeWingCfgRadiusUserStartTime OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Specify a start time (HH:MM) for the start date after which the user will be able to authenticate. 
				This constraint is applicable only for 'guest' users.
				XPATH: /extremeWing-config/radius_user_pool[name=key1]/users[userid=key2]/start_time"
			::= { extremeWingCfgRadiusUserEntry 8 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.36.2.1.9
		extremeWingCfgRadiusUserExpiryDate OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Specify an expiry date (MM:DD:YYYY) after which the user will not be able to authenticate. 
				This constraint is applicable only for 'guest' users.
				XPATH: /extremeWing-config/radius_user_pool[name=key1]/users[userid=key2]/expiry_date"
			::= { extremeWingCfgRadiusUserEntry 9 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.36.2.1.10
		extremeWingCfgRadiusUserExpiryTime OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Specify an expiry time (HH:MM) for expiry date after which the user will not be able to authenticate. 
				This constraint is applicable only for 'guest' users.
				XPATH: /extremeWing-config/radius_user_pool[name=key1]/users[userid=key2]/expiry_time"
			::= { extremeWingCfgRadiusUserEntry 10 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.36.2.1.11
		extremeWingCfgRadiusUserEmailId OBJECT-TYPE
			SYNTAX DisplayString (SIZE (0..64))
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Specify the email-id of the user
				XPATH: /extremeWing-config/radius_user_pool[name=key1]/users[userid=key2]/email_id"
			::= { extremeWingCfgRadiusUserEntry 11 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.36.2.1.12
