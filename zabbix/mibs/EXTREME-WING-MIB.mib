		-- 1.3.6.1.4.1.1916.2.131.50.1.4.3.2.9.1.1.10
		extremeWingStatsRfdWlRadioStatTxDropped OBJECT-TYPE
			SYNTAX Counter64
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"Number of packets of data dropped on transmission
				
				XPath: /extremeWing-stats/rf_domain[name=key1]/wireless/radio-stats[radio_id=key2]/tx_dropped"
			::= { extremeWingStatsRfdWlRadioStatEntry 10 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.4.3.2.9.1.1.11
		extremeWingStatsRfdWlRadioStatRxErrors OBJECT-TYPE
			SYNTAX Counter64
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"Number of packets of data received with errors
				
				XPath: /extremeWing-stats/rf_domain[name=key1]/wireless/radio-stats[radio_id=key2]/rx_errors"
			::= { extremeWingStatsRfdWlRadioStatEntry 11 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.4.3.2.9.1.1.12
		extremeWingStatsRfdWlRadioStatTIndex OBJECT-TYPE
			SYNTAX Integer32
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"Traffic Utilization Index
				
				Measures the efficiency the medium under consideration
				is used. It is the percentage of the current data throughput
				over the theoretical data rate limit, which is derived
				the current maximum physical rate configured over the medium
				based on past empirical data. This index could assist end user
				in site planning and expansion. The numerical value might be
				further classified as:
				  -1: no data available ( e.g. radio is not in wlan operation
				                          mode )
				  0-20 : very low utilization
				  20-40: low utilization
				  40-60: moderate utilization
				  60 and above: high utilization
				
				XPath: /extremeWing-stats/rf_domain[name=key1]/wireless/radio-stats[radio_id=key2]/t_index"
			::= { extremeWingStatsRfdWlRadioStatEntry 12 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.4.3.2.9.1.1.13
		extremeWingStatsRfdWlRadioStatTxBps OBJECT-TYPE
			SYNTAX Unsigned32
			UNITS "kbps"
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"User data transmit rate
				
				XPath: /extremeWing-stats/rf_domain[name=key1]/wireless/radio-stats[radio_id=key2]/tx_bps"
			::= { extremeWingStatsRfdWlRadioStatEntry 13 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.4.3.2.9.1.1.14
		extremeWingStatsRfdWlRadioStatRxBps OBJECT-TYPE
			SYNTAX Unsigned32
			UNITS "kbps"
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"User data receive rate
				
				XPath: /extremeWing-stats/rf_domain[name=key1]/wireless/radio-stats[radio_id=key2]/rx_bps"
			::= { extremeWingStatsRfdWlRadioStatEntry 14 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.4.3.2.9.1.1.15
		extremeWingStatsRfdWlRadioStatSignal OBJECT-TYPE
			SYNTAX Integer32
			UNITS "dbm"
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"Signal strength in units of dbm
				
				XPath: /extremeWing-stats/rf_domain[name=key1]/wireless/radio-stats[radio_id=key2]/signal"
			::= { extremeWingStatsRfdWlRadioStatEntry 15 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.4.3.2.9.1.1.16
		extremeWingStatsRfdWlRadioStatNoise OBJECT-TYPE
			SYNTAX Integer32
			UNITS "dbm"
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"Noise level in units of dbm
				
				XPath: /extremeWing-stats/rf_domain[name=key1]/wireless/radio-stats[radio_id=key2]/noise"
			::= { extremeWingStatsRfdWlRadioStatEntry 16 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.4.3.2.9.1.1.17
		extremeWingStatsRfdWlRadioStatSnr OBJECT-TYPE
			SYNTAX Integer32
			UNITS "db"
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"Signal to noise ratio in units of db
				
				XPath: /extremeWing-stats/rf_domain[name=key1]/wireless/radio-stats[radio_id=key2]/snr"
			::= { extremeWingStatsRfdWlRadioStatEntry 17 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.4.3.2.9.1.1.18
		extremeWingStatsRfdWlRadioStatTxRate OBJECT-TYPE
			SYNTAX Unsigned32
			UNITS "Mbps"
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"The effective phy-layer transmit rate
				
				XPath: /extremeWing-stats/rf_domain[name=key1]/wireless/radio-stats[radio_id=key2]/tx_rate"
			::= { extremeWingStatsRfdWlRadioStatEntry 18 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.4.3.2.9.1.1.19
		extremeWingStatsRfdWlRadioStatRxRate OBJECT-TYPE
			SYNTAX Unsigned32
			UNITS "Mbps"
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"The effective phy-layer receive rate
				
				XPath: /extremeWing-stats/rf_domain[name=key1]/wireless/radio-stats[radio_id=key2]/rx_rate"
			::= { extremeWingStatsRfdWlRadioStatEntry 19 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.4.3.2.9.1.1.20
		extremeWingStatsRfdWlRadioStatErrorRate OBJECT-TYPE
			SYNTAX Unsigned32
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"Ratio of errors to rx-packets in percentage
				
				XPath: /extremeWing-stats/rf_domain[name=key1]/wireless/radio-stats[radio_id=key2]/error_rate"
			::= { extremeWingStatsRfdWlRadioStatEntry 20 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.4.3.2.9.1.1.21
		extremeWingStatsRfdWlRadioStatQIndex OBJECT-TYPE
			SYNTAX Integer32
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"RF quality Index
				
				Measure the quality of the medium in percentage. It is a
				function of average retries and error rate. Its range is from
				0-100. Typically:
				  -1: no data available ( e.g. radio is not in wlan operation
				                          mode )
				  0-20: very poor quality
				  20-40: poor quality
				  40-60: average quality
				  60-100: good quality
				
				XPath: /extremeWing-stats/rf_domain[name=key1]/wireless/radio-stats[radio_id=key2]/q_index"
			::= { extremeWingStatsRfdWlRadioStatEntry 21 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.4.3.2.9.1.1.22
		extremeWingStatsRfdWlRadioStatNumClients OBJECT-TYPE
			SYNTAX Unsigned32
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"Total number of clients
				
				XPath: /extremeWing-stats/rf_domain[name=key1]/wireless/radio-stats[radio_id=key2]/num_clients"
			::= { extremeWingStatsRfdWlRadioStatEntry 22 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.4.3.2.9.1.1.23
		extremeWingStatsRfdWlRadioStatNumBClients OBJECT-TYPE
			SYNTAX Unsigned32
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"Number of 11b clients
				
				XPath: /extremeWing-stats/rf_domain[name=key1]/wireless/radio-stats[radio_id=key2]/num_b_clients"
			::= { extremeWingStatsRfdWlRadioStatEntry 23 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.4.3.2.9.1.1.24
