			SYNTAX DisplayString
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Encryption method protecting data transmission.
				
				Values:
				esp-null,
				des,
				3des,
				aes,
				aes-192,
				aes-256
				
				XPath: /extremeWing-config/profile[name=key1]/crypto_map[name=key2]/crypto_map_entry[sequence=key3]/esp_session_keys[direction=key4]/cipher_algo"
