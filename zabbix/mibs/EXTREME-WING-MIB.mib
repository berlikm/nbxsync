				XPath: /extremeWing-stats/rf_domain[name=key1]/wireless/radio-stats[radio_id=key2]/num_bg_clients"
			::= { extremeWingStatsRfdWlRadioStatEntry 24 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.4.3.2.9.1.1.25
