		extremeWingCfgProfIfWwanEntry OBJECT-TYPE
			SYNTAX ExtremeWingCfgProfIfWwanEntry
			MAX-ACCESS not-accessible
			STATUS current
			DESCRIPTION
				"An entry in the table."
			INDEX { extremeWingCfgProfName, extremeWingCfgProfIfName }
			::= { extremeWingCfgProfIfWwanTable 1 }

		
		ExtremeWingCfgProfIfWwanEntry ::=
			SEQUENCE { 
