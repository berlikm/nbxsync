					TruthValue,
				extremeWingCfgWlanMotoExtnWmmLoadBalance
					TruthValue,
				extremeWingCfgWlanMotoExtnSymbolLoadInfo
					TruthValue,
				extremeWingCfgWlanClientLoadBal
					TruthValue,
				extremeWingCfgWlanClientLoadBalSingleBandClients5ghz
					TruthValue,
				extremeWingCfgWlanClientLoadBalSingleBandClients24ghz
					TruthValue,
				extremeWingCfgWlanClientLoadBalMaxProbeReq24ghz
