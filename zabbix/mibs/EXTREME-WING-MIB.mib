				AP-MAC:R%d. E.g., 00-A0-F8-00-00-00:R1
				
				XPath: /extremeWing-stats/device[mac=key1]/wireless/client[mac=key2]/radio_id"
			::= { extremeWingStatsDevWlClientEntry 19 }

		
