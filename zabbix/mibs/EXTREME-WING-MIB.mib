			::= { extremeWingStatsRfdWlRadioEntry 15 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.4.3.2.8.1.1.16
		extremeWingStatsRfdWlRadioProtocol OBJECT-TYPE
			SYNTAX Unsigned32
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"Bit map of protocols currently enabled on the radio.
				
				Bit position:
				The Least Significant Bit corresponds to the first bit
				in the map. The next bit corresponds to the second bit
				and so on. Unused bits are ignored.
				
				bit position  meaning
				============  =======
				0             dot11a
				1             dot11b
				2             dot11g
				3             dot11an
				4             dot11gn
				
				Bit values:
				1 - enabled
				0 - disabled
				
				XPath: /extremeWing-stats/rf_domain[name=key1]/wireless/radio[radio_id=key2]/protocol"
			::= { extremeWingStatsRfdWlRadioEntry 16 }

		
-- /extremeWing-stats/rf_domain/wireless/radio-stats
		-- 1.3.6.1.4.1.1916.2.131.50.1.4.3.2.9
		extremeWingStatsRfdWlRadioStat OBJECT IDENTIFIER ::= { extremeWingStatsRfdWl 9 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.4.3.2.9.1
		extremeWingStatsRfdWlRadioStatTable OBJECT-TYPE
			SYNTAX SEQUENCE OF ExtremeWingStatsRfdWlRadioStatEntry
			MAX-ACCESS not-accessible
			STATUS current
			DESCRIPTION
				"Traffic and RF statistics of radios on RF Domain
				
				/extremeWing-stats/rf_domain/wireless/radio-stats"
			::= { extremeWingStatsRfdWlRadioStat 1 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.4.3.2.9.1.1
		extremeWingStatsRfdWlRadioStatEntry OBJECT-TYPE
			SYNTAX ExtremeWingStatsRfdWlRadioStatEntry
			MAX-ACCESS not-accessible
			STATUS current
			DESCRIPTION
				"An entry in the table."
			INDEX { extremeWingStatsRfdName, extremeWingStatsRfdWlRadioStatId }
			::= { extremeWingStatsRfdWlRadioStatTable 1 }

		
		ExtremeWingStatsRfdWlRadioStatEntry ::=
			SEQUENCE { 
				extremeWingStatsRfdWlRadioStatId
					ExtremeWingIdentifier,
				extremeWingStatsRfdWlRadioStatDeviceMac
					MacAddress,
				extremeWingStatsRfdWlRadioStatAlias
					DisplayString,
				extremeWingStatsRfdWlRadioStatMac
					MacAddress,
				extremeWingStatsRfdWlRadioStatType
					DisplayString,
				extremeWingStatsRfdWlRadioStatTxBytes
					Counter64,
				extremeWingStatsRfdWlRadioStatRxBytes
					Counter64,
				extremeWingStatsRfdWlRadioStatTxPkts
					Counter64,
				extremeWingStatsRfdWlRadioStatRxPkts
					Counter64,
				extremeWingStatsRfdWlRadioStatTxDropped
					Counter64,
				extremeWingStatsRfdWlRadioStatRxErrors
					Counter64,
				extremeWingStatsRfdWlRadioStatTIndex
					Integer32,
				extremeWingStatsRfdWlRadioStatTxBps
					Unsigned32,
				extremeWingStatsRfdWlRadioStatRxBps
					Unsigned32,
				extremeWingStatsRfdWlRadioStatSignal
					Integer32,
				extremeWingStatsRfdWlRadioStatNoise
					Integer32,
				extremeWingStatsRfdWlRadioStatSnr
					Integer32,
				extremeWingStatsRfdWlRadioStatTxRate
					Unsigned32,
				extremeWingStatsRfdWlRadioStatRxRate
					Unsigned32,
				extremeWingStatsRfdWlRadioStatErrorRate
					Unsigned32,
				extremeWingStatsRfdWlRadioStatQIndex
					Integer32,
				extremeWingStatsRfdWlRadioStatNumClients
					Unsigned32,
				extremeWingStatsRfdWlRadioStatNumBClients
					Unsigned32,
				extremeWingStatsRfdWlRadioStatNumBgClients
					Unsigned32,
				extremeWingStatsRfdWlRadioStatNumBgnClients
					Unsigned32,
				extremeWingStatsRfdWlRadioStatNumAClients
					Unsigned32,
				extremeWingStatsRfdWlRadioStatNumAnClients
					Unsigned32,
				extremeWingStatsRfdWlRadioStatMediumErrorRate
					Unsigned32,
				extremeWingStatsRfdWlRadioStatTxRetries
					Counter64,
				extremeWingStatsRfdWlRadioStatTxRetriedBytes
					Counter64
			 }

		-- 1.3.6.1.4.1.1916.2.131.50.1.4.3.2.9.1.1.1
		extremeWingStatsRfdWlRadioStatId OBJECT-TYPE
			SYNTAX ExtremeWingIdentifier
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"Unique ID for each radio interface in the form of
				AP-MAC:R%d. E.g., 00-A0-F8-00-00-00:R1
				
				XPath: /extremeWing-stats/rf_domain[name=key1]/wireless/radio-stats[radio_id=key2]/radio_id"
			::= { extremeWingStatsRfdWlRadioStatEntry 1 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.4.3.2.9.1.1.2
