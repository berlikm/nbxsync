		extremeWingActionReload OBJECT IDENTIFIER ::= { extremeWingAction 4 }

		
-- Input objects for action.
		-- 1.3.6.1.4.1.1916.2.131.50.1.5.4.1
		extremeWingActionReloadIn OBJECT IDENTIFIER ::= { extremeWingActionReload 1 }

		
