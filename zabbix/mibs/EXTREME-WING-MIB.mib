				extremeWingCfgWlanPmfSaQueryTimeout
					Unsigned32,
				extremeWingCfgWlanPmfSaQueryAttempts
					Unsigned32,
				extremeWingCfgWlanWpaWpa2Psk
					DisplayString,
				extremeWingCfgWlanWpaWpa2ExcludeWpa2Tkip
					TruthValue,
				extremeWingCfgWlanWpaWpa2KeyRotationUnicast
					Unsigned32,
				extremeWingCfgWlanWpaWpa2KeyRotationBroadcast
					Unsigned32,
				extremeWingCfgWlanWpaWpa2PmkCaching
					TruthValue,
				extremeWingCfgWlanWpaWpa2OpmkCaching
					TruthValue,
				extremeWingCfgWlanWpaWpa2Preauth
					TruthValue,
				extremeWingCfgWlanWpaWpa2TkipCntrmeasHoldTime
					Unsigned32,
				extremeWingCfgWlanWep64TransmitKey
					Unsigned32,
				extremeWingCfgWlanWep128TransmitKey
					Unsigned32,
				extremeWingCfgWlanRadiusAssignedVlans
