				medium
				high
				custom
				
				XPath: /extremeWing-config/smart_rf_policy[name=key1]/sensitivity"
			DEFVAL { "medium" }
			::= { extremeWingCfgSmartRfEntry 4 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.9.1.1.5
		extremeWingCfgSmartRfAutoAssignSensor OBJECT-TYPE
			SYNTAX TruthValue
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
