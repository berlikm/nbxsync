		extremeWingStatsDevVrrpGlobalErrChecksumErr OBJECT-TYPE
			SYNTAX Unsigned32
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"The total number of VRRP packets received with an invalid VRRP checksum value
				
				XPath: /extremeWing-stats/device[mac=key1]/vrrp/vrrp_router_global_err_stats/checksum_err"
			::= { extremeWingStatsDevVrrpGlobalErrEntry 4 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.4.2.31.1.1.5
		extremeWingStatsDevVrrpGlobalErrInvalidVirtualRouterId OBJECT-TYPE
			SYNTAX Unsigned32
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
