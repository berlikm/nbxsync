			SYNTAX MacAddress
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Mac address of the device."
			::= { extremeWingActionReloadIn 1 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.5.4.1.2
		extremeWingActionReloadInForce OBJECT-TYPE
			SYNTAX TruthValue
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Force reboot ignoring conditions like upgrade in progress,
				unsaved changes etc.
				
				The default value of this object is false."
			::= { extremeWingActionReloadIn 2 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.5.4.1.3
		extremeWingActionReloadInTimeout OBJECT-TYPE
			SYNTAX Unsigned32 (1..999)
			UNITS "minutes"
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Delay before reload (minutes).
				
				The default delay is 2 minutes."
			::= { extremeWingActionReloadIn 3 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.5.4.1.4
		extremeWingActionReloadInReason OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Reason for reload. This is printed on the serial console
				prior to reloading."
			::= { extremeWingActionReloadIn 4 }

		
