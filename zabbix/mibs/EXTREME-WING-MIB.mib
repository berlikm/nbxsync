				XPath: /extremeWing-config/profile[name=key1]/ip_igmp_snooping_querier_address"
			DEFVAL { '00000000'h }
			::= { extremeWingCfgProfIgsEntry 4 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.16.22.1.1.5
