			::= { extremeWingStatsDevWlRadioStatEntry 4 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.4.2.25.10.1.1.5
		extremeWingStatsDevWlRadioStatType OBJECT-TYPE
			SYNTAX DisplayString
			MAX-ACCESS read-only
			STATUS current
			DESCRIPTION
				"802.11 radio-type
				
