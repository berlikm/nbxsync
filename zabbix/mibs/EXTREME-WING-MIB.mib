                                XPath: /extremeWing-config/device[mac=key1]/environmental_sensor/motion"
                        DEFVAL { true }
                        ::= { extremeWingCfgDevEnvSensorEntry 2 }


                -- 1.3.6.1.4.1.1916.2.131.50.1.3.18.33.1.1.3
                extremeWingCfgDevEnvSensorTemperature OBJECT-TYPE
                        SYNTAX TruthValue
                        MAX-ACCESS read-write
                        STATUS current
                        DESCRIPTION
                                "Enable (turn on) the temperature sensor.

                                XPath: /extremeWing-config/device[mac=key1]/environmental_sensor/temperature"
                        DEFVAL { true }
                        ::= { extremeWingCfgDevEnvSensorEntry 3 }


-- /extremeWing-config/profile/environmental_sensor
                -- 1.3.6.1.4.1.1916.2.131.50.1.3.18.33.2
                extremeWingCfgDevLightSensorTable OBJECT-TYPE
                        SYNTAX SEQUENCE OF ExtremeWingCfgDevLightSensorEntry
                        MAX-ACCESS not-accessible
                        STATUS current
                        DESCRIPTION
                                "Description."
                        ::= { extremeWingCfgDevSensor 2 }


                -- 1.3.6.1.4.1.1916.2.131.50.1.3.18.33.2.1
                extremeWingCfgDevLightSensorEntry OBJECT-TYPE
                        SYNTAX ExtremeWingCfgDevLightSensorEntry
                        MAX-ACCESS not-accessible
                        STATUS current
                        DESCRIPTION
                                "An entry in the table."
                        INDEX { extremeWingCfgDevMac }
                        ::= { extremeWingCfgDevLightSensorTable 1 }


                ExtremeWingCfgDevLightSensorEntry ::=
                        SEQUENCE {
                                extremeWingCfgDevLightSensor
                                        TruthValue,
                                extremeWingCfgDevLightSensorHoldTime
                                        Integer32,
                                extremeWingCfgDevLightSensorThresholdRadioShutdown
                                        DisplayString,
                                extremeWingCfgDevLightSensorLowLimitThreshold
                                        Integer32,
                                extremeWingCfgDevLightSensorHighLimitThreshold
                                        Integer32
                         }

                -- 1.3.6.1.4.1.1916.2.131.50.1.3.18.33.2.1.1
                extremeWingCfgDevLightSensor OBJECT-TYPE
                        SYNTAX TruthValue
                        UNITS "true"
                        MAX-ACCESS read-write
                        STATUS current
                        DESCRIPTION
                                "Enable (turn on) the light sensor..

                                XPath: /extremeWing-config/device[mac=key1]/environmental_sensor/light"
                        ::= { extremeWingCfgDevLightSensorEntry 1 }


                -- 1.3.6.1.4.1.1916.2.131.50.1.3.18.33.2.1.2
                extremeWingCfgDevLightSensorHoldTime OBJECT-TYPE
                        SYNTAX Integer32 (2..201)
                        UNITS "seconds"
                        MAX-ACCESS read-write
                        STATUS current
                        DESCRIPTION
                                "The interval of time (in seconds) during which the light sensor polls the environment for light intensity to determine whehter the light is on or off.

                                XPath: /extremeWing-config/device[mac=key1]/environmental_sensor/light_holdtime"
                        ::= { extremeWingCfgDevLightSensorEntry 2 }


                -- 1.3.6.1.4.1.1916.2.131.50.1.3.18.33.2.1.3
                extremeWingCfgDevLightSensorThresholdRadioShutdown OBJECT-TYPE
                        SYNTAX DisplayString
                        MAX-ACCESS read-write
                        STATUS current
                        DESCRIPTION
                                "Shutdown the AP radio(s) when the light intensity drops below the lower limit -- signifying that the light is off and the facility is unoccupied..

                                enum all,
                                enum radio-1,
                                enum radio-2


                                XPath: /extremeWing-config/device[mac=key1]/environmental_sensor/light_radio_shutdown"
                        DEFVAL { "none" }
                        ::= { extremeWingCfgDevLightSensorEntry 3 }


                -- 1.3.6.1.4.1.1916.2.131.50.1.3.18.33.2.1.4
                extremeWingCfgDevLightSensorLowLimitThreshold OBJECT-TYPE
                        SYNTAX Integer32 (0..1000)
                        UNITS "lux"
                        MAX-ACCESS read-write
                        STATUS current
                        DESCRIPTION
                                "The lower limit (in lux) at which the light sensor determines the lighting is off.


                                XPath: /extremeWing-config/device[mac=key1]/environmental_sensor/light_threshold_low"
                        ::= { extremeWingCfgDevLightSensorEntry 4 }


                -- 1.3.6.1.4.1.1916.2.131.50.1.3.18.33.2.1.5
                extremeWingCfgDevLightSensorHighLimitThreshold OBJECT-TYPE
                        SYNTAX Integer32 (100..10000)
                        UNITS "lux"
                        MAX-ACCESS read-write
                        STATUS current
                        DESCRIPTION
                                "The upper limit (in lux) at which the light sensor determines the lighting is on.

                                XPath: /extremeWing-config/device[mac=key1]/environmental_sensor/light_threshold_high"
                        ::= { extremeWingCfgDevLightSensorEntry 5 }


