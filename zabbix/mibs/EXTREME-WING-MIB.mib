			::= { extremeWingCfgProfDot11Table 1 }

		
		ExtremeWingCfgProfDot11Entry ::=
			SEQUENCE { 
				extremeWingCfgProfDot11WepSharedKeyAuth
					TruthValue,
				extremeWingCfgProfDot11LegacyAutoUpdateAp650
					TruthValue,
				extremeWingCfgProfDot11LegacyAutoUpdateImgAp7131
					DisplayString,
				extremeWingCfgProfDot11LegacyAutoDowngrade
					TruthValue,
				extremeWingCfgProfDot11NasIdentifier
					DisplayString,
				extremeWingCfgProfDot11NasPortId
