				destroy(6)
				}
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"The status of this conceptual row
				XPATH: /extremeWing-config/radius_user_pool[name=key1]/row_status"
			::= { extremeWingCfgRadiusUserPolicyEntry 2 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.36.2
