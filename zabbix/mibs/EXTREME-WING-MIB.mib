			SYNTAX Unsigned32 (1..65535)
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
				"Cost of this OSPF interface
				
				XPath: /extremeWing-config/profile[name=key1]/interface[name=key2]/ospf_cost"
			DEFVAL { 10 }
			::= { extremeWingCfgProfIfVlanOspfEntry 4 }

		
		-- 1.3.6.1.4.1.1916.2.131.50.1.3.16.2.13.1.5
		extremeWingCfgProfIfVlanOspfOspfBandWidth OBJECT-TYPE
			SYNTAX Unsigned32 (1..10000000)
			MAX-ACCESS read-write
			STATUS current
			DESCRIPTION
