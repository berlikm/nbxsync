		extremeWingCfgAutoProvisionPolicyRuleEntry OBJECT-TYPE
			SYNTAX ExtremeWingCfgAutoProvisionPolicyRuleEntry
			MAX-ACCESS not-accessible
			STATUS current
			DESCRIPTION
				"Description."
			INDEX { extremeWingCfgAutoProvisionPolicyName, extremeWingCfgAutoProvisionPolicyRulePrecedence }
			::= { extremeWingCfgAutoProvisionPolicyRuleTable 1 }

		
		ExtremeWingCfgAutoProvisionPolicyRuleEntry ::=
			SEQUENCE { 
				extremeWingCfgAutoProvisionPolicyRulePrecedence
					Unsigned32,
				extremeWingCfgAutoProvisionPolicyRuleOperation
					DisplayString,
				extremeWingCfgAutoProvisionPolicyRuleDevice
					DisplayString,
				extremeWingCfgAutoProvisionPolicyRuleProfileName
					DisplayString,
				extremeWingCfgAutoProvisionPolicyRuleRfDomainName
					DisplayString,
