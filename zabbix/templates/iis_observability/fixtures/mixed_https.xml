<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.applicationHost>
    <sites>
      <!-- <site name="Commented HTTPS" id="9">
        <bindings>
          <binding protocol="https" bindingInformation="*:443:ignored.example" sslFlags="1" />
        </bindings>
      </site> -->
      <site name="Default Web Site" id="1">
        <bindings>
          <binding protocol="http" bindingInformation="*:80:" />
          <binding protocol="https" bindingInformation="*:443:" sslFlags="0" />
        </bindings>
      </site>
      <site name="Intranet" id="2">
        <bindings>
          <binding protocol="http" bindingInformation="*:80:intranet.corp.local" />
          <binding protocol="https" bindingInformation="*:443:intranet.corp.local" sslFlags="1" />
          <binding protocol="https" bindingInformation="10.0.8.21:8443:intranet.corp.local" sslFlags="1" />
        </bindings>
      </site>
      <site name="IPv6 App" id="3">
        <bindings>
          <binding protocol="https" bindingInformation="[fe80::1]:443:ipv6.corp.local" sslFlags="1" />
        </bindings>
      </site>
    </sites>
  </system.applicationHost>
</configuration>
